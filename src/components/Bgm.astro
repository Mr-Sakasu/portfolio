---
// Background music, played through an embedded YouTube player rather than a
// self-hosted file: the platform holds the licence for the upload, nothing
// copyrighted is served from this domain.
const BGM_VIDEO_ID = '3ML2nYnCO0E'; // Fire◎Flower - halyosy (Piano Cover)
---

<div id="bgm-root" data-video-id={BGM_VIDEO_ID} aria-hidden="true" transition:persist>
  <div id="bgm-player"></div>
</div>

<style>
  /* Invisible, but still laid out inside the viewport rather than thrown to
     -9999px: a player parked far offscreen is treated as not present by some
     browsers' playback heuristics. Nothing here is interactive. */
  #bgm-root {
    position: fixed;
    right: 0;
    bottom: 0;
    width: 320px;
    height: 180px;
    z-index: -1;
    opacity: 0;
    pointer-events: none;
    overflow: hidden;
  }
</style>

<script>
  // Sound cannot simply start on load: browsers refuse audible autoplay without
  // a gesture. What IS allowed is muted playback, so the track starts muted the
  // moment it can and unmutes at the visitor's first gesture — the earliest
  // point sound is permitted. Exactly one player exists per page, and only one
  // tab plays at a time.
  const BGM_KEY = 'portfolio-bgm';
  const BGM_CLAIM_KEY = 'portfolio-bgm-claim';
  const BGM_CHANNEL = 'portfolio-bgm-channel';

  function readPref() {
    try {
      return window.localStorage.getItem(BGM_KEY) === 'off' ? 'off' : 'on';
    } catch {
      return 'on'; // storage blocked: default to wanting music
    }
  }

  function writePref(value) {
    try {
      window.localStorage.setItem(BGM_KEY, value);
    } catch {
      // Nothing to do — the preference simply will not survive this visit.
    }
  }

  function paintButtons(playing) {
    document.querySelectorAll('[data-bgm-toggle]').forEach((button) => {
      button.setAttribute('aria-pressed', playing ? 'true' : 'false');
      button.dataset.bgmState = playing ? 'on' : 'off';
    });
  }

  function setupBgm() {
    // Astro's transition:persist keeps the original element across navigation,
    // but if a second one ever reaches the DOM its iframe would play over the
    // first. Keep the one that already owns a player.
    const roots = [...document.querySelectorAll('#bgm-root')];
    const root = roots.find((node) => node.dataset.bgmInit === '1') ?? roots[0];
    if (!root) return;
    roots.filter((node) => node !== root).forEach((node) => node.remove());

    const bgm = window.__bgm ?? (window.__bgm = {
      player: null,
      playing: false,
      armed: false,
      unmuted: false,
      id: Math.random().toString(36).slice(2),
    });
    paintButtons(bgm.playing);

    document.querySelectorAll('[data-bgm-toggle]').forEach((button) => {
      if (button.dataset.bgmBound === '1') return;
      button.dataset.bgmBound = '1';
      button.addEventListener('click', () => {
        if (bgm.playing) {
          writePref('off');
          bgm.playing = false;
          paintButtons(false);
          bgm.player?.pauseVideo?.();
        } else {
          writePref('on');
          bgm.unmuted = true; // a click IS the gesture, so this one is audible
          play();
        }
      });
    });

    // --- one tab at a time ---------------------------------------------------
    // Autostart means every open tab would otherwise sing at once.
    function claimAudio() {
      try {
        window.localStorage.setItem(BGM_CLAIM_KEY, `${bgm.id}:${Date.now()}`);
      } catch {
        // Without storage the other tabs simply will not hear about it.
      }
      bgm.channel?.postMessage({ type: 'claim', id: bgm.id });
    }

    function yieldAudio() {
      // Another tab took over. Stop, but leave the preference alone: the
      // visitor never asked for music to be off.
      bgm.playing = false;
      paintButtons(false);
      bgm.player?.pauseVideo?.();
    }

    if (!bgm.wired) {
      bgm.wired = true;
      try {
        bgm.channel = new BroadcastChannel(BGM_CHANNEL);
        bgm.channel.addEventListener('message', (event) => {
          if (event.data?.type === 'claim' && event.data.id !== bgm.id) yieldAudio();
        });
      } catch {
        bgm.channel = null; // older browser: the storage event below covers it
      }
      window.addEventListener('storage', (event) => {
        if (event.key !== BGM_CLAIM_KEY || !event.newValue) return;
        if (!event.newValue.startsWith(`${bgm.id}:`)) yieldAudio();
      });
    }

    function play() {
      if (!bgm.player?.playVideo) return;
      claimAudio();
      if (bgm.unmuted) {
        bgm.player.unMute?.();
        bgm.player.setVolume?.(35); // background, not a performance
      } else {
        bgm.player.mute?.(); // muted playback is the only kind allowed on load
      }
      bgm.player.playVideo();
    }

    // The first gesture is what makes sound legal, so take whichever arrives.
    function armGesture() {
      if (bgm.armed) return;
      bgm.armed = true;
      const events = ['pointerdown', 'keydown', 'touchstart', 'wheel', 'scroll'];
      const start = () => {
        events.forEach((name) => window.removeEventListener(name, start));
        if (readPref() !== 'on') return;
        bgm.unmuted = true;
        if (bgm.playing) {
          // Already rolling silently — just turn the sound on.
          bgm.player?.unMute?.();
          bgm.player?.setVolume?.(35);
        } else {
          play();
        }
      };
      events.forEach((name) => window.addEventListener(name, start, { passive: true }));
    }

    if (bgm.player) {
      if (readPref() === 'on' && !bgm.unmuted) armGesture();
      return;
    }

    const videoId = root.dataset.videoId;
    if (!videoId) return; // no track configured: stay silent and show nothing

    function createPlayer() {
      if (root.dataset.bgmInit === '1') return; // never a second player
      root.dataset.bgmInit = '1';
      bgm.player = new window.YT.Player('bgm-player', {
        videoId,
        host: 'https://www.youtube-nocookie.com',
        playerVars: {
          autoplay: 0,
          controls: 0,
          disablekb: 1,
          modestbranding: 1,
          playsinline: 1,
          rel: 0,
          loop: 1,
          playlist: videoId, // a single-video loop needs itself as the playlist
        },
        events: {
          onReady: () => {
            if (readPref() !== 'on') return;
            play();          // muted, which browsers do allow on load
            armGesture();    // and unmute the moment the visitor touches anything
          },
          onStateChange: (event) => {
            const YT = window.YT;
            bgm.playing = event.data === YT.PlayerState.PLAYING;
            // A silently-playing track should not light the button as if the
            // visitor could hear it.
            paintButtons(bgm.playing && bgm.unmuted);
            if (event.data === YT.PlayerState.ENDED && readPref() === 'on') play();
          },
          onError: () => {
            // Video removed, private, or blocked from embedding.
            bgm.playing = false;
            paintButtons(false);
          },
        },
      });
    }

    if (window.YT?.Player) {
      createPlayer();
      return;
    }

    // The API calls this global once, so chain rather than overwrite.
    const previous = window.onYouTubeIframeAPIReady;
    window.onYouTubeIframeAPIReady = () => {
      if (typeof previous === 'function') previous();
      createPlayer();
    };
    if (!document.querySelector('script[data-bgm-api]')) {
      const tag = document.createElement('script');
      tag.src = 'https://www.youtube.com/iframe_api';
      tag.dataset.bgmApi = '1';
      document.head.appendChild(tag);
    }
  }

  document.addEventListener('astro:page-load', setupBgm);
  setupBgm();
</script>
