---
import { skillLevelDescriptions, type SkillStackItem } from '../../data/skills';
import { getUi, type Locale } from '../../i18n';
import SkillRating from './SkillRating.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = getUi(lang);
const levels: SkillStackItem['level'][] = [1, 2, 3];
---

<details class="skill-level-guide">
  <summary>
    <svg class="skill-level-guide__chevron" viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true">
      <path d="m6 4 4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    {t['skills.levelGuide']}
  </summary>
  <dl>
    {levels.map(level => (
      <div class="skill-level-guide__row">
        <dt><SkillRating level={level} lang={lang} /></dt>
        <dd>{skillLevelDescriptions[level][lang]}</dd>
      </div>
    ))}
  </dl>
</details>

<style>
  .skill-level-guide { margin-bottom: 1rem; color: var(--site-muted); }
  summary { display: flex; align-items: center; gap: 0.4rem; width: fit-content; min-height: 44px; cursor: pointer; list-style: none; font-size: 0.875rem; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--site-accent); }
  summary:focus-visible { outline: 2px solid var(--site-accent); outline-offset: 3px; border-radius: 2px; }
  .skill-level-guide__chevron { flex: none; }
  details[open] .skill-level-guide__chevron { transform: rotate(90deg); }
  dl { display: grid; gap: 0.75rem; max-width: 52rem; margin: 0; padding: 0.85rem 0; border-top: 1px solid var(--site-card-border); border-bottom: 1px solid var(--site-card-border); }
  .skill-level-guide__row { display: grid; grid-template-columns: max-content minmax(0, 1fr); align-items: baseline; gap: 1rem; }
  dt, dd { margin: 0; }
  dd { font-size: 0.875rem; line-height: 1.7; overflow-wrap: anywhere; }
  @media (max-width: 640px) {
    .skill-level-guide__row { gap: 0.75rem; }
  }
</style>
