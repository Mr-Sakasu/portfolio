---
import type { SkillLocale, SkillStackItem } from '../../data/skills';

interface Props {
  level: SkillStackItem['level'];
  lang: SkillLocale;
}

const { level, lang } = Astro.props;
const label = {
  ja: `習熟度: 5段階中${level}`,
  en: `Proficiency: ${level} out of 5`,
  zh: `熟练度：${level}/5`,
}[lang];
---
<span class="skill-rating" role="img" aria-label={label}>
  {Array.from({ length: 5 }, (_, index) => (
    <svg class:list={['skill-rating__star', { 'is-filled': index < level }]} viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
      <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9Z" />
    </svg>
  ))}
</span>

<style>
  .skill-rating { display: inline-flex; width: max-content; gap: 0.12rem; vertical-align: middle; }
  .skill-rating__star { flex: none; fill: none; stroke: var(--site-muted); stroke-width: 1.5; stroke-linejoin: round; opacity: 0.55; }
  .skill-rating__star.is-filled { fill: var(--site-accent); stroke: var(--site-accent); opacity: 1; }
</style>
