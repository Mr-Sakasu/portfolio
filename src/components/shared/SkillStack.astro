---
import {
    skillCategoryLabels,
    skillCategoryOrder,
    skillChildGroupLabels,
    skillStack,
    type SkillChildGroup,
    type SkillLocale,
} from '../../data/skills';
import { ui } from '../../i18n/ui';

interface Props {
    lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = ui[lang] ?? ui.en;
const locale = (lang in ui ? lang : 'en') as SkillLocale;
const childGroupOrder: SkillChildGroup[] = ['frontend', 'backend'];

/* One ring of every skill, dealt category by category and strongest first
   within each: the cards no longer show a level, but `level` still decides
   the order they come round in. */
const ringSkills = skillCategoryOrder.flatMap((category) => (
    skillStack
        .filter((skill) => skill.category === category)
        .sort((first, second) => second.level - first.level)
));

const categories = skillCategoryOrder
    .filter((category) => ringSkills.some((skill) => skill.category === category))
    .map((category) => ({ id: category, label: skillCategoryLabels[category][locale] }));

const getSkillChildGroups = (skill: (typeof skillStack)[number]) => {
    if (!skill.children) {
        return [];
    }

    const grouped = childGroupOrder
        .map((group) => ({
            label: skillChildGroupLabels[group][locale],
            children: skill.children?.filter((child) => child.group === group) ?? [],
        }))
        .filter((group) => group.children.length > 0);

    const ungroupedChildren = skill.children.filter((child) => !child.group);
    if (ungroupedChildren.length > 0) {
        grouped.push({
            label: '',
            children: ungroupedChildren,
        });
    }

    return grouped;
};
---

<section data-skill-ring>
    <div class="section-title" data-reveal>
        <h2>{t['skills.title']}</h2>
    </div>

    {/* Where the ring is standing. Pressing a category brings its first card
        round; the one lit is the category the front card belongs to. */}
    <div class="skill-ring-tabs" role="group" aria-label={t['skills.title']}>
        {categories.map((category) => (
            <button type="button" class="skill-ring-tab" data-ring-jump={category.id} aria-pressed="false">
                {category.label}
            </button>
        ))}
    </div>

    {/* The cylinder. Each card is turned by its index and pushed out to the
        radius in CSS; the script only turns the whole ring and fades the cards
        by how far round they are. Without JS the same cards fall into a grid. */}
    <div class="skill-ring-stage" data-ring-stage tabindex="0" aria-roledescription="carousel" aria-label={t['skills.title']}>
        {/* The turntable the cards stand on: a disc laid flat at their feet,
            one tick per card, turning with the ring. Its near edge dissolves
            before it reaches the frame. */}
        <div class="skill-ring-floor" aria-hidden="true"></div>
        <div class="skill-ring" data-ring>
            {ringSkills.map((skill, index) => (
                <article
                    class="site-card skill-card"
                    data-ring-card
                    data-category={skill.category}
                    style={`--i: ${index};`}
                >
                    <p class="skill-card__category">{skillCategoryLabels[skill.category][locale]}</p>
                    <div class="flex items-center gap-3">
                        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-md bg-white/95 p-2">
                            <img
                                src={skill.icon}
                                alt=""
                                loading="lazy"
                                decoding="async"
                                width="24"
                                height="24"
                                class="h-6 w-6 object-contain"
                            />
                        </span>
                        <h4 class="min-w-0 flex-1 text-sm font-bold leading-tight text-white md:text-base">
                            {skill.name}
                        </h4>
                    </div>

                    <p class="skill-card__summary mt-3 text-xs leading-relaxed text-gray-400">
                        {skill.summary[locale]}
                    </p>

                    {skill.children && (
                        <div class="mt-3 space-y-2">
                            {getSkillChildGroups(skill).map((group) => (
                                <div>
                                    {group.label && (
                                        <p class="text-[10px] font-bold uppercase leading-none tracking-[0.14em] text-cyan-300/80">
                                            {group.label}
                                        </p>
                                    )}
                                    <div class={group.label ? 'mt-1.5 flex flex-wrap gap-1.5' : 'flex flex-wrap gap-1.5'}>
                                        {group.children.map((child) => (
                                            <span class="chip max-w-full gap-1.5">
                                                <img
                                                    src={child.icon}
                                                    alt=""
                                                    loading="lazy"
                                                    decoding="async"
                                                    width="14"
                                                    height="14"
                                                    class="h-3.5 w-3.5 rounded-sm bg-white/95 p-0.5"
                                                />
                                                <span class="min-w-0 truncate" title={child.name}>{child.name}</span>
                                            </span>
                                        ))}
                                    </div>
                                </div>
                            ))}
                        </div>
                    )}
                </article>
            ))}
        </div>
    </div>

    <div class="skill-ring-nav">
        <button type="button" class="theme-toggle skill-ring-nav__button" data-ring-prev aria-label={t['skills.prev']}>
            <span aria-hidden="true">←</span>
        </button>
        <button type="button" class="theme-toggle skill-ring-nav__button" data-ring-next aria-label={t['skills.next']}>
            <span aria-hidden="true">→</span>
        </button>
    </div>
</section>

<script>
    import { initSkillStack } from './skill-stack-client';

    initSkillStack();
</script>

<style>
    .skill-ring-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 1rem;
    }

    .skill-ring-tab {
        border: 1px solid var(--site-card-border);
        border-radius: 9999px;
        background: var(--site-chip-bg);
        padding: 0.4rem 0.85rem;
        color: var(--site-muted);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        transition: color 160ms ease, border-color 160ms ease, background-color 160ms ease;
    }

    .skill-ring-tab:hover {
        color: var(--site-text);
        border-color: var(--site-card-border-hover);
    }

    .skill-ring-tab.is-active {
        border-color: rgba(34, 211, 238, 0.55);
        background: rgba(34, 211, 238, 0.12);
        color: #67e8f9;
    }

    :global(html[data-theme='light']) .skill-ring-tab.is-active {
        border-color: rgba(8, 145, 178, 0.5);
        background: rgba(8, 145, 178, 0.1);
        color: #0e7490;
    }

    .skill-card {
        padding: 1rem;
        min-height: 9rem;
    }

    .skill-card__category {
        margin-bottom: 0.75rem;
        color: rgba(103, 232, 249, 0.8);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.14em;
        line-height: 1;
        text-transform: uppercase;
    }

    :global(html[data-theme='light']) .skill-card__category {
        color: #0e7490;
    }

    .skill-ring-nav {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        margin-top: 1rem;
    }

    /* Without JS nothing turns, so the cards lie flat in the grid they used to
       be in, and the controls for turning them stay out of the way. */
    .skill-ring {
        display: grid;
        grid-template-columns: repeat(1, minmax(0, 1fr));
        gap: 0.75rem;
    }

    @media (min-width: 640px) {
        .skill-ring {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (min-width: 1024px) {
        .skill-ring {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    :global(html:not(.js)) .skill-ring-tabs,
    :global(html:not(.js)) .skill-ring-nav {
        display: none;
    }

    /* The cylinder proper. */
    :global(html.js) .skill-ring-stage {
        /* Wider and taller on a phone than the desktop card's proportions
           would give: the fullest card wraps its chips onto more rows there. */
        --ring-card-width: 16.5rem;
        --ring-glow: 56 189 248;
        position: relative;
        height: 30rem;
        overflow: hidden;
        perspective: 1400px;
        touch-action: pan-y;
        cursor: grab;
        outline-offset: 4px;
        /* Room for the side cards to be seen leaning in. */
        margin-inline: -1rem;
        padding-inline: 1rem;
    }

    @media (min-width: 640px) {
        :global(html.js) .skill-ring-stage {
            --ring-card-width: 17rem;
            height: 26.5rem;
        }
    }

    :global(html[data-theme='light'].js) .skill-ring-stage {
        --ring-glow: 37 99 235;
    }

    /* A soft light on the card in front. */
    :global(html.js) .skill-ring-stage::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(
            48% 62% at 50% 44%,
            rgb(var(--ring-glow) / 0.24),
            rgb(var(--ring-glow) / 0.07) 48%,
            transparent 72%
        );
        pointer-events: none;
    }

    :global(html.js) .skill-ring-floor {
        --floor-size: calc(var(--ring-radius, 520px) * 2.3);
        position: absolute;
        top: calc(100% - 1.375rem);
        left: 50%;
        width: var(--floor-size);
        height: var(--floor-size);
        margin-top: calc(var(--floor-size) / -2);
        margin-left: calc(var(--floor-size) / -2);
        /* Back to the ring's own centre, laid flat, then spun the way the ring
           spins. rotateZ runs first (in the disc's own plane), and the sign
           is flipped because laying the disc down turns its axis over. */
        transform:
            translateZ(calc(-1 * var(--ring-radius, 520px)))
            rotateX(90deg)
            rotateZ(calc(-1 * var(--ring-angle, 0deg)));
        background:
            /* the rim the cards stand on, at the ring's radius, with a
               softer halo either side of it */
            radial-gradient(
                circle closest-side,
                transparent 0 80%,
                rgb(var(--ring-glow) / 0.16) 84%,
                rgb(var(--ring-glow) / 0.6) 86.5% 87.5%,
                rgb(var(--ring-glow) / 0.16) 90%,
                transparent 96%
            ),
            radial-gradient(circle closest-side, rgb(var(--ring-glow) / 0.1), transparent 72%);
        /* The disc thins out towards its near edge so it never meets the
           frame as a hard line. */
        -webkit-mask-image: linear-gradient(to bottom, #000 40%, transparent 78%);
        mask-image: linear-gradient(to bottom, #000 40%, transparent 78%);
        pointer-events: none;
    }

    :global(html.js) .skill-ring-stage.is-dragging {
        cursor: grabbing;
        user-select: none;
        -webkit-user-select: none;
    }

    :global(html.js) .skill-ring-stage.is-dragging * {
        user-select: none;
        -webkit-user-select: none;
    }

    :global(html.js) .skill-ring {
        display: block;
        position: absolute;
        inset: 0;
        width: var(--ring-card-width);
        /* Shorter than the stage: the front card steps forward and grows,
           and needs this much headroom at either end not to be clipped. */
        height: calc(100% - 2.75rem);
        margin: auto;
        transform-style: preserve-3d;
        transform: translateZ(calc(-1 * var(--ring-radius, 520px))) rotateY(var(--ring-angle, 0deg));
        will-change: transform;
    }

    :global(html.js) .skill-ring > .skill-card {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        min-height: 0;
        overflow: hidden;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
        transform: rotateY(calc(var(--i) * var(--ring-step, 27.7deg))) translateZ(var(--ring-radius, 520px));
        transition: border-color 160ms ease;
        /* Solid enough that the floor's rim does not show through the card
           standing on it. The home page thins these cards to the bento's
           translucency; this wins on specificity. */
        background: var(--site-surface-strong);
    }

    /* The card in front is the one being read; the rest are scenery and their
       hover lift would pull them out of the circle. */
    :global(html.js) .skill-ring > .skill-card:hover {
        transform: rotateY(calc(var(--i) * var(--ring-step, 27.7deg))) translateZ(var(--ring-radius, 520px));
    }

    /* The card in front steps towards the visitor and takes the light; the
       transform only changes when the front changes hands, so it can ease. */
    :global(html.js) .skill-ring > .skill-card {
        transition: transform 280ms ease, border-color 200ms ease, box-shadow 200ms ease;
    }

    :global(html.js) .skill-ring > .skill-card.is-front,
    :global(html.js) .skill-ring > .skill-card.is-front:hover {
        transform:
            rotateY(calc(var(--i) * var(--ring-step, 27.7deg)))
            translateZ(calc(var(--ring-radius, 520px) + 3rem))
            scale(1.03);
        border-color: rgb(var(--ring-glow) / 0.75);
        box-shadow:
            0 0 0 1px rgb(var(--ring-glow) / 0.25),
            0 0 40px -6px rgb(var(--ring-glow) / 0.35),
            0 30px 60px -30px rgb(var(--ring-glow) / 0.5);
    }

    :global(html.js) .skill-ring > .skill-card:not(.is-front) {
        cursor: pointer;
    }

    /* A tall card runs out through the bottom edge rather than being cut. */
    :global(html.js) .skill-ring > .skill-card::after {
        content: '';
        position: absolute;
        inset: auto 0 0 0;
        height: 2rem;
        background: linear-gradient(to bottom, transparent, var(--site-surface-strong));
        pointer-events: none;
    }

    @media (prefers-reduced-motion: reduce) {
        :global(html.js) .skill-ring {
            will-change: auto;
        }
    }
</style>
