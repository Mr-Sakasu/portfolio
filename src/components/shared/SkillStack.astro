---
import {
    skillCategoryLabels,
    skillCategoryOrder,
    skillChildGroupLabels,
    skillStack,
    type SkillChildGroup,
    type SkillLocale,
} from '../../data/skills';
import { ui } from '../../i18n/ui';

interface Props {
    lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = ui[lang] ?? ui.en;
const locale = (lang in ui ? lang : 'en') as SkillLocale;
const childGroupOrder: SkillChildGroup[] = ['frontend', 'backend'];
// The cards no longer show a level, but each category still leads with the
// strongest: `level` survives in the data as the order the grid is dealt in.
const sortedSkillStack = [...skillStack].sort((first, second) => second.level - first.level);

const skillCategories = skillCategoryOrder
    .map((category) => ({
        label: skillCategoryLabels[category][locale],
        skills: sortedSkillStack.filter((skill) => skill.category === category),
    }))
    .filter((category) => category.skills.length > 0);

const getSkillChildGroups = (skill: (typeof skillStack)[number]) => {
    if (!skill.children) {
        return [];
    }

    const grouped = childGroupOrder
        .map((group) => ({
            label: skillChildGroupLabels[group][locale],
            children: skill.children?.filter((child) => child.group === group) ?? [],
        }))
        .filter((group) => group.children.length > 0);

    const ungroupedChildren = skill.children.filter((child) => !child.group);
    if (ungroupedChildren.length > 0) {
        grouped.push({
            label: '',
            children: ungroupedChildren,
        });
    }

    return grouped;
};
---

<section class="mt-12 md:mt-16">
    <div class="mb-5" data-reveal>
        <h2 class="text-2xl md:text-3xl font-bold text-cyan-300">
            {t['skills.title']}
        </h2>
        <span class="section-rule bg-gradient-to-r from-cyan-500 to-blue-500" aria-hidden="true"></span>
        <p class="mt-3 text-sm text-gray-400">
            {t['skills.subtitle']}
        </p>
    </div>

    {skillCategories.map((category) => (
        <div class="skill-category">
            <div class="skill-category__heading" data-reveal>
                <h3 class="text-[11px] font-bold uppercase leading-none tracking-[0.16em] text-cyan-300/80">
                    {category.label}
                </h3>
                <span class="skill-category__rule" aria-hidden="true"></span>
            </div>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
                {category.skills.map((skill, skillIndex) => (
                    <article class="site-card min-h-36 p-4" data-reveal style={`--reveal-delay: ${(skillIndex % 3) * 80}ms;`}>
                        <div class="flex items-center gap-3">
                            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-md bg-white/95 p-2">
                                <img
                                    src={skill.icon}
                                    alt=""
                                    loading="lazy"
                                    decoding="async"
                                    width="24"
                                    height="24"
                                    class="h-6 w-6 object-contain"
                                />
                            </span>
                            <h4 class="min-w-0 flex-1 text-sm font-bold leading-tight text-white md:text-base">
                                {skill.name}
                            </h4>
                        </div>

                        <p class="mt-3 text-xs leading-relaxed text-gray-400">
                            {skill.summary[locale]}
                        </p>

                        {skill.children && (
                            <div class="mt-3 space-y-2">
                                {getSkillChildGroups(skill).map((group) => (
                                    <div>
                                        {group.label && (
                                            <p class="text-[10px] font-bold uppercase leading-none tracking-[0.14em] text-cyan-300/80">
                                                {group.label}
                                            </p>
                                        )}
                                        <div class={group.label ? 'mt-1.5 flex flex-wrap gap-1.5' : 'flex flex-wrap gap-1.5'}>
                                            {group.children.map((child) => (
                                                <span class="chip max-w-full gap-1.5">
                                                    <img
                                                        src={child.icon}
                                                        alt=""
                                                        loading="lazy"
                                                        decoding="async"
                                                        width="14"
                                                        height="14"
                                                        class="h-3.5 w-3.5 rounded-sm bg-white/95 p-0.5"
                                                    />
                                                    <span class="min-w-0 truncate" title={child.name}>{child.name}</span>
                                                </span>
                                            ))}
                                        </div>
                                    </div>
                                ))}
                            </div>
                        )}

                    </article>
                ))}
            </div>
        </div>
    ))}
</section>

<style>
    .skill-category + .skill-category {
        margin-top: 1.75rem;
    }

    .skill-category__heading {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
    }

    .skill-category__rule {
        flex: 1;
        height: 1px;
        background: var(--site-card-border);
    }
</style>
