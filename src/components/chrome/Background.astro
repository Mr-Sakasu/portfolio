<canvas id="network-canvas" aria-hidden="true"></canvas>

<style>
  #network-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    background-color: var(--site-bg, #181410);
    background-image: var(--site-bg-glow, none);
    pointer-events: none;
    transition: background-color 180ms ease;
  }
</style>

<script>
  import { startAutumnScene } from './autumn-scene';

  let cleanup: (() => void) | undefined;
  function initBackground() {
    cleanup?.();
    cleanup = undefined;
    if (document.documentElement.dataset.previewFrame !== undefined) return;
    const canvas = document.getElementById('network-canvas');
    if (canvas instanceof HTMLCanvasElement) cleanup = startAutumnScene(canvas);
  }

  document.addEventListener('astro:before-swap', () => cleanup?.());
  document.addEventListener('astro:page-load', initBackground);
  window.addEventListener('pagehide', () => cleanup?.());
  window.addEventListener('pageshow', (event) => { if (event.persisted) initBackground(); });
  initBackground();
</script>
