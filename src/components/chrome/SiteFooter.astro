---
interface Props {
  contentWidth: string;
}

const { contentWidth } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer relative z-10 mt-10">
  <div class={`mx-auto flex w-full ${contentWidth} items-center justify-between px-6 py-8 text-xs text-gray-500`}>
    <p>&copy; {currentYear} Sakasu</p>
    <a href="https://github.com/Mr-Sakasu/" target="_blank" rel="noopener" class="text-gray-500 hover:text-blue-400 transition-colors">
      GitHub
    </a>
  </div>
</footer>
