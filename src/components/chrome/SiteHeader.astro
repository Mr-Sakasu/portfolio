---
import { getUi, type Locale } from '../../i18n';
import LanguagePicker from './LanguagePicker.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getUi(lang);
const isHomePage = Astro.url.pathname === `/${lang}/`;
const isStarsPage = Astro.url.pathname.includes('/stars');
const isBanditPage = Astro.url.pathname.includes('/bandit');
const isHanoiPage = Astro.url.pathname.includes('/hanoi');
const isPlaylistPage = Astro.url.pathname.includes('/playlist');
const isScenesPage = Astro.url.pathname.includes('/scenes');
const navBaseClass = 'shrink-0 whitespace-nowrap rounded-full border px-3.5 py-1.5 text-xs md:text-sm font-medium transition-colors';
---

<header class="site-header sticky top-0 z-40 w-full">
  {/* The bar keeps its own width rather than borrowing the article's. The
      links, the brand and the controls do not fit inside a reading column, and
      sharing one pushed the controls clean off the side of the screen. */}
  <div class="box-border w-full max-w-6xl mx-auto px-4 py-3 md:px-6 md:py-3.5">
    <div class="flex flex-col gap-3">
      <div class="flex items-center justify-between gap-4">
        <a href={`/${lang}/`} class="site-brand font-display text-lg md:text-xl font-bold tracking-tight hover:text-blue-400 transition-colors whitespace-nowrap">
          Sakasu's note<span class="site-brand__dot" aria-hidden="true">.</span>
        </a>
        <div class="flex items-center gap-2 shrink-0">
          <LanguagePicker />
          <button type="button" data-theme-toggle class="theme-toggle" aria-label={t['theme.toggle']} title={t['theme.toggle']}>
            <span class="theme-toggle__icon theme-toggle__icon--dark" aria-hidden="true">☾</span>
            <span class="theme-toggle__icon theme-toggle__icon--light" aria-hidden="true">☀</span>
          </button>
          <button type="button" data-bgm-toggle data-bgm-state="off" class="theme-toggle bgm-toggle" aria-pressed="false" aria-label={t['bgm.toggle']} title={t['bgm.toggle']}>
            <span class="bgm-toggle__icon" aria-hidden="true">♪</span>
          </button>
        </div>
      </div>

      {/* On its own row, so the links never compete with the brand for space.
          A narrow screen swipes through them in one line; from md they wrap
          onto a second rather than being clipped with the scrollbar hidden. */}
      <nav aria-label="Top navigation" class="w-full min-w-0">
        <div class="site-nav-scroll flex items-center gap-1.5 overflow-x-auto pb-1 md:flex-wrap md:justify-center md:overflow-visible md:pb-0">
          <a href={`/${lang}/#work`} class={`${navBaseClass} ${isHomePage ? 'border-blue-400/60 bg-blue-500/15 text-blue-300' : 'border-transparent text-gray-400 hover:text-white hover:bg-white/[0.06]'}`}>
            {t['nav.work']}
          </a>
          <a href={`/${lang}/playlist/`} class={`${navBaseClass} ${isPlaylistPage ? 'border-violet-400/60 bg-violet-500/15 text-violet-300' : 'border-transparent text-gray-400 hover:text-white hover:bg-white/[0.06]'}`}>
            {t['nav.playlist']}
          </a>
          <a href={`/${lang}/#timeline`} class={`${navBaseClass} ${isHomePage ? 'border-slate-300/50 bg-slate-400/15 text-slate-200' : 'border-transparent text-gray-400 hover:text-white hover:bg-white/[0.06]'}`}>
            {t['nav.timeline']}
          </a>
          <a href={`/${lang}/scenes/`} class={`${navBaseClass} ${isScenesPage ? 'border-emerald-400/60 bg-emerald-500/15 text-emerald-300' : 'border-transparent text-gray-400 hover:text-white hover:bg-white/[0.06]'}`}>
            {t['nav.scenes']}
          </a>
          <a href={`/${lang}/stars/`} class={`${navBaseClass} ${isStarsPage ? 'border-blue-400/60 bg-blue-500/15 text-blue-300' : 'border-transparent text-gray-400 hover:text-white hover:bg-white/[0.06]'}`}>
            {t['nav.stars']}
          </a>
          <a href={`/${lang}/bandit/`} class={`${navBaseClass} ${isBanditPage ? 'border-blue-400/60 bg-blue-500/15 text-blue-300' : 'border-transparent text-gray-400 hover:text-white hover:bg-white/[0.06]'}`}>
            {t['nav.bandit']}
          </a>
          <a href={`/${lang}/hanoi/`} class={`${navBaseClass} ${isHanoiPage ? 'border-violet-400/60 bg-violet-500/15 text-violet-300' : 'border-transparent text-gray-400 hover:text-white hover:bg-white/[0.06]'}`}>
            {t['nav.hanoi']}
          </a>
        </div>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-nav-scroll {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .site-nav-scroll::-webkit-scrollbar {
    display: none;
  }

  /* Below md the strip scrolls, and the scrollbar is hidden. Fade its trailing
     edge so it reads as something to swipe rather than as a row that happens to
     have been cut off. */
  @media (max-width: 767px) {
    .site-nav-scroll {
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 32px), transparent);
      mask-image: linear-gradient(to right, #000 calc(100% - 32px), transparent);
    }
  }
</style>
