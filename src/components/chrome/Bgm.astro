---
// Background music, played through an embedded YouTube player rather than a
// self-hosted file: the platform holds the licence for the upload, nothing
// copyrighted is served from this domain. Which track plays where lives in
// src/data/bgm.ts; this is only the player that plays it.
---

<div id="bgm-root" aria-hidden="true" transition:persist>
  <div id="bgm-player"></div>
</div>

<style>
  /* Invisible, but still laid out inside the viewport rather than thrown to
     -9999px: a player parked far offscreen is treated as not present by some
     browsers' playback heuristics. Nothing here is interactive. */
  #bgm-root {
    position: fixed;
    right: 0;
    bottom: 0;
    width: 320px;
    height: 180px;
    z-index: -1;
    opacity: 0;
    pointer-events: none;
    overflow: hidden;
  }
</style>

<script>
  import { defaultTrack, sameTrack, trackForPath, trackForScene } from '../../data/bgm';

  // The visitor starts the music and nothing else does. Until the ♪ button is
  // pressed there is no player, no request to YouTube and no sound. This used
  // to autoplay muted and unmute on the first gesture of any kind, so a stray
  // scroll could set the music going. Building the player inside the click also
  // hands the browser the gesture it demands before it will allow sound, so the
  // track is audible from the first note. One player per page, one tab at a
  // time.
  //
  // Once it is running, moving between pages and between the scenes in the reel
  // changes the track under it. That needs no further gesture — but nothing can
  // start the music from silence, so a visitor who never presses ♪ hears none
  // of it.
  const BGM_CLAIM_KEY = 'portfolio-bgm-claim';
  const BGM_CHANNEL = 'portfolio-bgm-channel';
  const BGM_VOLUME = 35; // background, not a performance
  const FADE_MS = 400;
  // One flick of the reel crosses every scene in it, and loadVideoById has to
  // rebuffer each time. Letting a scene settle first keeps the player from
  // being handed seven tracks in two seconds.
  const SETTLE_MS = 600;
  // How long the player gets to actually make a sound after being told to —
  // on the first press and on every track change. Fetching the iframe API and
  // buffering a cold video over a bad connection fit inside this; a video that
  // is never going to arrive does not.
  const STALL_MS = 10000;

  function paintButtons(playing) {
    document.querySelectorAll('[data-bgm-toggle]').forEach((button) => {
      button.setAttribute('aria-pressed', playing ? 'true' : 'false');
      button.dataset.bgmState = playing ? 'on' : 'off';
    });
  }

  // The button carries the name of whatever is cued up, which the header shows
  // on hover. It names the track for where the visitor is rather than what is
  // audible, so it is right before the first press as well as after it.
  function paintName(track) {
    const name = track?.name ?? '';
    document.querySelectorAll('[data-bgm-toggle]').forEach((button) => {
      button.dataset.bgmName = name;
      // Reading the icon alone tells you nothing, so the track goes in the
      // accessible name too, next to the verb the page was rendered with.
      const verb = button.dataset.bgmLabel ?? '';
      button.setAttribute('aria-label', verb && name ? `${verb}: ${name}` : verb || name);
    });
  }

  function setupBgm() {
    // Astro's transition:persist keeps the original element across navigation,
    // but if a second one ever reaches the DOM its iframe would play over the
    // first. Keep the one that already owns a player.
    const roots = [...document.querySelectorAll('#bgm-root')];
    const root = roots.find((node) => node.dataset.bgmInit === '1') ?? roots[0];
    if (!root) return;
    roots.filter((node) => node !== root).forEach((node) => node.remove());

    const bgm = window.__bgm ?? (window.__bgm = {
      player: null,
      // `on` is what the visitor asked for; `playing` is what the player is
      // doing about it. Keeping them apart is the whole point: the player
      // drops out of PLAYING for as long as it takes to buffer, which happens
      // on every single track change, and a visitor who is owed music across
      // that gap must not have the button, their next press, or the next scene
      // change decided by it.
      on: false,
      playing: false,
      // What should be playing, and what the player actually holds. They part
      // company between choosing a track and the player catching up with it.
      track: null,
      loaded: null,
      // How far through a handover the player is: null between them,
      // 'fading' while the outgoing track is on its way down, 'loading' once
      // the new one has been handed over and is buffering. The two halves have
      // to be told apart — a PLAYING event during 'fading' is the outgoing
      // track looping, and treating it as the new one's arrival cancels the
      // fade and the load waiting on the end of it.
      swap: null,
      scene: null,     // the reel's current scene, while there is one
      level: BGM_VOLUME,
      // Video ids the player has rejected — removed, made private, or blocked
      // from embedding. Dead for the rest of the visit; handing the same id
      // back every time its scene comes round again just buys more silence.
      broken: new Set(),
      id: Math.random().toString(36).slice(2),
    });

    // The header is rebuilt on navigation while the player is not, so the fresh
    // buttons have to be told what the surviving player is doing.
    paintButtons(bgm.on);
    paintName(bgm.track);

    document.querySelectorAll('[data-bgm-toggle]').forEach((button) => {
      if (button.dataset.bgmBound === '1') return;
      button.dataset.bgmBound = '1';
      // Branching on what the button shows, so a press always does what the
      // icon says it will.
      button.addEventListener('click', () => (bgm.on ? stop() : start()));
    });

    // --- which track ---------------------------------------------------------
    // A scene showing in the reel wins over the page it sits on.
    function resolveTrack() {
      const path = window.location.pathname;
      const track = bgm.scene ? trackForScene(bgm.scene, path) : trackForPath(path);
      if (!bgm.broken.has(track.id)) return track;
      // This one has already failed here. Fall back to the site default, or to
      // nothing at all if that is the id that died.
      return bgm.broken.has(defaultTrack.id) ? null : defaultTrack;
    }

    // Navigation and scene changes both land here, so a scene reported just
    // after a page load replaces the target before any swap has run — arriving
    // on the reel is one handover, not two.
    function wantTrack(next) {
      window.clearTimeout(bgm.swapTimer);
      if (!next) return;
      bgm.track = next;
      paintName(next);
      // Silent: the press picks the right track up on its own.
      if (!bgm.on || sameTrack(bgm.loaded, next)) return;
      bgm.swapTimer = window.setTimeout(swapTrack, SETTLE_MS);
    }

    function swapTrack() {
      if (!bgm.player?.loadVideoById || !bgm.on || sameTrack(bgm.loaded, bgm.track)) return;
      // A handover already under way ends on whatever the newest target is by
      // the time its fade runs out, so never start a second one over the top:
      // the second fade would cancel the first and take its pending load down
      // with it, leaving the player on a track nobody asked for.
      if (bgm.swap) return;
      bgm.swap = 'fading';
      fade(0, FADE_MS, () => {
        // Read the target now rather than when the fade started: the visitor
        // has had FADE_MS to move somewhere else again.
        const next = bgm.track;
        if (!bgm.on || !next) {
          finishSwap();
          return;
        }
        bgm.swap = 'loading';
        bgm.loaded = next;
        loadTrack(next); // this starts playing on its own
        // The volume comes back up from onStateChange, once the new track is
        // really running: fading up into a buffering player is just silence.
        armStall();
      });
    }

    // A handover is over, however it ended. The volume goes back up whether or
    // not the new track ever spoke, so nothing is left silently turned down to
    // zero, and the target is checked once more in case it moved while the
    // player was busy with the last one.
    function finishSwap() {
      window.clearTimeout(bgm.stallTimer);
      bgm.swap = null;
      fade(BGM_VOLUME, bgm.playing ? FADE_MS : 0);
      wantTrack(bgm.track);
    }

    // The player has been told to do something audible. If it never gets
    // there, stop the button claiming there is music: blocked, throttled, or
    // behind a network that will not reach YouTube at all.
    function armStall() {
      window.clearTimeout(bgm.stallTimer);
      bgm.stallTimer = window.setTimeout(() => {
        if (bgm.playing) return;
        bgm.on = false;
        paintButtons(false);
        if (bgm.swap) finishSwap();
      }, STALL_MS);
    }

    function clearFade() {
      window.clearInterval(bgm.fadeTimer);
      bgm.fadeTimer = 0;
    }

    function fade(to, ms, done) {
      clearFade();
      const from = bgm.level;
      const started = performance.now();
      const step = () => {
        const k = ms > 0 ? Math.min(1, (performance.now() - started) / ms) : 1;
        bgm.level = from + (to - from) * k;
        bgm.player?.setVolume?.(Math.round(bgm.level));
        if (k < 1) return;
        clearFade();
        done?.();
      };
      bgm.fadeTimer = window.setInterval(step, 25);
      step();
    }

    // Held on the shared state rather than closed over, so the listeners wired
    // once below always run against the current page's copy of this function.
    bgm.applyContext = () => wantTrack(resolveTrack());

    // --- one tab at a time ---------------------------------------------------
    // Two tabs of the site would otherwise sing over each other.
    function claimAudio() {
      try {
        window.localStorage.setItem(BGM_CLAIM_KEY, `${bgm.id}:${Date.now()}`);
      } catch {
        // Without storage the other tabs simply will not hear about it.
      }
      bgm.channel?.postMessage({ type: 'claim', id: bgm.id });
    }

    function yieldAudio() {
      // Another tab took over, which is not the visitor switching this one off,
      // but it sounds the same from here: silence it, and let a press take the
      // music back.
      stop();
    }

    if (!bgm.wired) {
      bgm.wired = true;
      try {
        bgm.channel = new BroadcastChannel(BGM_CHANNEL);
        bgm.channel.addEventListener('message', (event) => {
          if (event.data?.type === 'claim' && event.data.id !== bgm.id) yieldAudio();
        });
      } catch {
        bgm.channel = null; // older browser: the storage event below covers it
      }
      window.addEventListener('storage', (event) => {
        if (event.key !== BGM_CLAIM_KEY || !event.newValue) return;
        if (!event.newValue.startsWith(`${bgm.id}:`)) yieldAudio();
      });
      // The scenes reel reports whichever scene the visitor has settled on.
      window.addEventListener('portfolio-scene-change', (event) => {
        bgm.scene = event.detail?.scene ?? null;
        bgm.applyContext();
      });
    }

    function start() {
      // The scene, the page, and the health of any given track may all have
      // moved since the target was last chosen. Pick it again rather than
      // committing the press to a stale one, or to one known to be dead.
      const next = resolveTrack();
      if (!next) return; // every candidate has failed: there is nothing to start
      bgm.track = next;
      paintName(next);
      claimAudio();
      // The button answers the press at once. It follows the visitor's intent
      // from here on and not the player's state, so buffering a new track no
      // longer flickers it off and back on mid-reel; only giving up on the
      // player, or an unplayable video, withdraws it.
      bgm.on = true;
      paintButtons(true);
      armStall();
      if (bgm.player?.playVideo) {
        play();
      } else {
        loadPlayer();
      }
    }

    function stop() {
      window.clearTimeout(bgm.stallTimer);
      window.clearTimeout(bgm.swapTimer);
      clearFade();
      bgm.on = false;
      bgm.playing = false;
      bgm.swap = null;
      bgm.level = BGM_VOLUME;
      paintButtons(false);
      bgm.player?.pauseVideo?.();
    }

    // Dropping straight in at the サビ, rather than making a scene wait out
    // an intro nobody stays for.
    function loadTrack(track) {
      bgm.player.loadVideoById({ videoId: track.id, startSeconds: track.start ?? 0 });
    }

    function play() {
      if (!bgm.track) return;
      bgm.player.unMute?.(); // YouTube hands some embeds back muted
      clearFade();
      bgm.level = BGM_VOLUME;
      bgm.player.setVolume?.(BGM_VOLUME);
      // The clock on "is anything going to happen" starts here rather than at
      // the press: the press may have spent most of it waiting for the API.
      armStall();
      // Moved pages while the music was off: come back on the track for
      // wherever the visitor is now, not the one they left.
      if (!sameTrack(bgm.loaded, bgm.track)) {
        bgm.loaded = bgm.track;
        loadTrack(bgm.track); // this starts playing on its own
        return;
      }
      // Same track, paused: pick it up where it was left rather than throwing
      // the visitor back to the サビ.
      bgm.player.playVideo();
    }

    // The track ran out. Back to the サビ, not to the intro — of whatever the
    // player is actually holding, which is not always what is wanted next.
    function restart() {
      bgm.player.seekTo?.(bgm.loaded?.start ?? 0, true);
      bgm.player.playVideo();
    }

    function createPlayer() {
      if (root.dataset.bgmInit === '1') return; // never a second player
      root.dataset.bgmInit = '1';
      const track = bgm.track;
      bgm.loaded = track;
      bgm.player = new window.YT.Player('bgm-player', {
        videoId: track.id,
        host: 'https://www.youtube-nocookie.com',
        playerVars: {
          autoplay: 0,
          controls: 0,
          disablekb: 1,
          modestbranding: 1,
          playsinline: 1,
          rel: 0,
          start: Math.round(track.start ?? 0),
          // No loop/playlist pair here on purpose: YouTube's own loop comes
          // back at 0:00 and throws away the offset. The ENDED handler below
          // does the repeat instead, and lands on the サビ every time.
        },
        events: {
          onReady: () => {
            // Pressed off again while the API was loading: stay quiet. A press
            // that is still standing plays, however long the API took.
            if (bgm.on) play();
          },
          onStateChange: (event) => {
            const YT = window.YT;
            const wasPlaying = bgm.playing;
            bgm.playing = event.data === YT.PlayerState.PLAYING;
            if (bgm.playing && !bgm.on) {
              // Switched off, or handed to another tab, while this was still
              // buffering: pauseVideo() aimed at a player that had not started
              // yet does nothing at all, so catch it the moment it does.
              bgm.playing = false;
              bgm.player.pauseVideo?.();
              return;
            }
            if (bgm.playing) {
              window.clearTimeout(bgm.stallTimer);
              // The track swapped into the player is running: bring it up.
              // Only from 'loading' — in 'fading' this is the outgoing track
              // coming back round, and the handover is still owed its load.
              if (bgm.swap === 'loading') finishSwap();
            }
            // The button is not painted from here: it says what the visitor
            // asked for, and the player passes through PLAYING and back out of
            // it on every handover and at the end of every loop.
            //
            // Every track ends, now that nothing loops natively. Pick it back
            // up — but only one that was actually running, so this can never
            // restart a track the visitor paused.
            if (event.data === YT.PlayerState.ENDED && wasPlaying) restart();
          },
          onError: () => {
            // Video removed, private, or blocked from embedding. Remember the
            // id so it is not tried again, then fall back — usually to the site
            // default — rather than leaving this scene silent for the visit.
            const dead = bgm.loaded;
            if (dead) bgm.broken.add(dead.id);
            window.clearTimeout(bgm.stallTimer);
            window.clearTimeout(bgm.swapTimer);
            bgm.playing = false;
            bgm.swap = null;
            clearFade();
            bgm.level = BGM_VOLUME;
            bgm.player?.setVolume?.(BGM_VOLUME);
            const next = resolveTrack();
            if (bgm.on && next && !sameTrack(next, dead)) {
              bgm.track = next;
              paintName(next);
              bgm.loaded = next;
              loadTrack(next);
              armStall();
              return;
            }
            // Nothing left to fall back to.
            bgm.on = false;
            paintButtons(false);
          },
        },
      });
    }

    function loadPlayer() {
      if (!bgm.track) {
        stop(); // no track configured: stay silent and show nothing
        return;
      }
      if (window.YT?.Player) {
        createPlayer();
        return;
      }

      // The API calls this global once, so chain rather than overwrite.
      const previous = window.onYouTubeIframeAPIReady;
      window.onYouTubeIframeAPIReady = () => {
        if (typeof previous === 'function') previous();
        createPlayer();
      };
      if (!document.querySelector('script[data-bgm-api]')) {
        const tag = document.createElement('script');
        tag.src = 'https://www.youtube.com/iframe_api';
        tag.dataset.bgmApi = '1';
        document.head.appendChild(tag);
      }
    }

    // A new page: whatever scene the reel was showing is behind us now.
    bgm.scene = null;
    bgm.applyContext();
  }

  document.addEventListener('astro:page-load', setupBgm);
  setupBgm();
</script>
