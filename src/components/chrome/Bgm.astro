---
// Background music, played through an embedded YouTube player rather than a
// self-hosted file: the platform holds the licence for the upload, nothing
// copyrighted is served from this domain. Which track plays where lives in
// src/data/bgm.ts; this is only the player that plays it.
---

<div id="bgm-root" aria-hidden="true" transition:persist>
  <div id="bgm-player"></div>
</div>

<style>
  /* Invisible, but still laid out inside the viewport rather than thrown to
     -9999px: a player parked far offscreen is treated as not present by some
     browsers' playback heuristics. Nothing here is interactive. */
  #bgm-root {
    position: fixed;
    right: 0;
    bottom: 0;
    width: 320px;
    height: 180px;
    z-index: -1;
    opacity: 0;
    pointer-events: none;
    overflow: hidden;
  }
</style>

<script>
  import { sameTrack, trackForPath, trackForScene } from '../../data/bgm';

  // The visitor starts the music and nothing else does. Until the ♪ button is
  // pressed there is no player, no request to YouTube and no sound. This used
  // to autoplay muted and unmute on the first gesture of any kind, so a stray
  // scroll could set the music going. Building the player inside the click also
  // hands the browser the gesture it demands before it will allow sound, so the
  // track is audible from the first note. One player per page, one tab at a
  // time.
  //
  // Once it is running, moving between pages and between the scenes in the reel
  // changes the track under it. That needs no further gesture — but nothing can
  // start the music from silence, so a visitor who never presses ♪ hears none
  // of it.
  const BGM_CLAIM_KEY = 'portfolio-bgm-claim';
  const BGM_CHANNEL = 'portfolio-bgm-channel';
  const BGM_VOLUME = 35; // background, not a performance
  const FADE_MS = 400;
  // One flick of the reel crosses every scene in it, and loadVideoById has to
  // rebuffer each time. Letting a scene settle first keeps the player from
  // being handed seven tracks in two seconds.
  const SETTLE_MS = 600;

  function paintButtons(playing) {
    document.querySelectorAll('[data-bgm-toggle]').forEach((button) => {
      button.setAttribute('aria-pressed', playing ? 'true' : 'false');
      button.dataset.bgmState = playing ? 'on' : 'off';
    });
  }

  function setupBgm() {
    // Astro's transition:persist keeps the original element across navigation,
    // but if a second one ever reaches the DOM its iframe would play over the
    // first. Keep the one that already owns a player.
    const roots = [...document.querySelectorAll('#bgm-root')];
    const root = roots.find((node) => node.dataset.bgmInit === '1') ?? roots[0];
    if (!root) return;
    roots.filter((node) => node !== root).forEach((node) => node.remove());

    const bgm = window.__bgm ?? (window.__bgm = {
      player: null,
      playing: false,  // the track is coming out of the speakers right now
      starting: false, // pressed, but the player is still loading
      // What should be playing, and what the player actually holds. They part
      // company between choosing a track and the player catching up with it.
      track: null,
      loaded: null,
      swapping: false, // mid-handover: faded out, waiting on the new track
      scene: null,     // the reel's current scene, while there is one
      level: BGM_VOLUME,
      id: Math.random().toString(36).slice(2),
    });

    // The header is rebuilt on navigation while the player is not, so the fresh
    // buttons have to be told what the surviving player is doing.
    const audible = () => bgm.playing || bgm.starting;
    paintButtons(audible());

    document.querySelectorAll('[data-bgm-toggle]').forEach((button) => {
      if (button.dataset.bgmBound === '1') return;
      button.dataset.bgmBound = '1';
      // Branching on what the button shows, so a press always does what the
      // icon says it will.
      button.addEventListener('click', () => (audible() ? stop() : start()));
    });

    // --- which track ---------------------------------------------------------
    // A scene showing in the reel wins over the page it sits on.
    function resolveTrack() {
      const path = window.location.pathname;
      return bgm.scene ? trackForScene(bgm.scene, path) : trackForPath(path);
    }

    // Navigation and scene changes both land here, so a scene reported just
    // after a page load replaces the target before any swap has run — arriving
    // on the reel is one handover, not two.
    function wantTrack(next) {
      window.clearTimeout(bgm.swapTimer);
      if (!next) return;
      bgm.track = next;
      // Silent: the press picks the right track up on its own.
      if (!audible() || sameTrack(bgm.loaded, next)) return;
      bgm.swapTimer = window.setTimeout(swapTrack, SETTLE_MS);
    }

    function swapTrack() {
      const next = bgm.track;
      if (!bgm.player?.loadVideoById || sameTrack(bgm.loaded, next) || !audible()) return;
      fade(0, FADE_MS, () => {
        bgm.loaded = next;
        bgm.swapping = true;
        loadTrack(next); // this starts playing on its own
        // The volume comes back up from onStateChange, once the new track is
        // really running: fading up into a buffering player is just silence.
      });
    }

    function clearFade() {
      window.clearInterval(bgm.fadeTimer);
      bgm.fadeTimer = 0;
    }

    function fade(to, ms, done) {
      clearFade();
      const from = bgm.level;
      const started = performance.now();
      const step = () => {
        const k = ms > 0 ? Math.min(1, (performance.now() - started) / ms) : 1;
        bgm.level = from + (to - from) * k;
        bgm.player?.setVolume?.(Math.round(bgm.level));
        if (k < 1) return;
        clearFade();
        done?.();
      };
      bgm.fadeTimer = window.setInterval(step, 25);
      step();
    }

    // Held on the shared state rather than closed over, so the listeners wired
    // once below always run against the current page's copy of this function.
    bgm.applyContext = () => wantTrack(resolveTrack());

    // --- one tab at a time ---------------------------------------------------
    // Two tabs of the site would otherwise sing over each other.
    function claimAudio() {
      try {
        window.localStorage.setItem(BGM_CLAIM_KEY, `${bgm.id}:${Date.now()}`);
      } catch {
        // Without storage the other tabs simply will not hear about it.
      }
      bgm.channel?.postMessage({ type: 'claim', id: bgm.id });
    }

    function yieldAudio() {
      // Another tab took over, which is not the visitor switching this one off:
      // silence it, and let a press here take the music back.
      window.clearTimeout(bgm.startTimer);
      window.clearTimeout(bgm.swapTimer);
      clearFade();
      bgm.playing = false;
      bgm.starting = false;
      bgm.swapping = false;
      bgm.level = BGM_VOLUME;
      paintButtons(false);
      bgm.player?.pauseVideo?.();
    }

    if (!bgm.wired) {
      bgm.wired = true;
      try {
        bgm.channel = new BroadcastChannel(BGM_CHANNEL);
        bgm.channel.addEventListener('message', (event) => {
          if (event.data?.type === 'claim' && event.data.id !== bgm.id) yieldAudio();
        });
      } catch {
        bgm.channel = null; // older browser: the storage event below covers it
      }
      window.addEventListener('storage', (event) => {
        if (event.key !== BGM_CLAIM_KEY || !event.newValue) return;
        if (!event.newValue.startsWith(`${bgm.id}:`)) yieldAudio();
      });
      // The scenes reel reports whichever scene the visitor has settled on.
      window.addEventListener('portfolio-scene-change', (event) => {
        bgm.scene = event.detail?.scene ?? null;
        bgm.applyContext();
      });
    }

    function start() {
      claimAudio();
      // The button answers the press at once; onStateChange corrects it if the
      // video turns out to be unplayable.
      bgm.starting = true;
      paintButtons(true);
      // Blocked, removed, or simply too slow: stop the button claiming there is
      // music. Only the label is withdrawn — a late arrival still plays, and
      // paints itself back on.
      window.clearTimeout(bgm.startTimer);
      bgm.startTimer = window.setTimeout(() => {
        if (bgm.playing) return;
        bgm.starting = false;
        paintButtons(false);
      }, 6000);
      if (bgm.player?.playVideo) {
        play();
      } else {
        loadPlayer();
      }
    }

    function stop() {
      window.clearTimeout(bgm.startTimer);
      window.clearTimeout(bgm.swapTimer);
      clearFade();
      bgm.playing = false;
      bgm.starting = false;
      bgm.swapping = false;
      bgm.level = BGM_VOLUME;
      paintButtons(false);
      bgm.player?.pauseVideo?.();
    }

    // Dropping straight in at the サビ, rather than making a scene wait out
    // an intro nobody stays for.
    function loadTrack(track) {
      bgm.player.loadVideoById({ videoId: track.id, startSeconds: track.start ?? 0 });
    }

    function play() {
      bgm.player.unMute?.(); // YouTube hands some embeds back muted
      clearFade();
      bgm.level = BGM_VOLUME;
      bgm.player.setVolume?.(BGM_VOLUME);
      // Moved pages while the music was off: come back on the track for
      // wherever the visitor is now, not the one they left.
      if (!sameTrack(bgm.loaded, bgm.track)) {
        bgm.loaded = bgm.track;
        loadTrack(bgm.track); // this starts playing on its own
        return;
      }
      // Same track, paused: pick it up where it was left rather than throwing
      // the visitor back to the サビ.
      bgm.player.playVideo();
    }

    // The track ran out. Back to the サビ, not to the intro.
    function restart() {
      bgm.player.seekTo?.(bgm.track?.start ?? 0, true);
      bgm.player.playVideo();
    }

    function createPlayer() {
      if (root.dataset.bgmInit === '1') return; // never a second player
      root.dataset.bgmInit = '1';
      const track = bgm.track;
      bgm.loaded = track;
      bgm.player = new window.YT.Player('bgm-player', {
        videoId: track.id,
        host: 'https://www.youtube-nocookie.com',
        playerVars: {
          autoplay: 0,
          controls: 0,
          disablekb: 1,
          modestbranding: 1,
          playsinline: 1,
          rel: 0,
          start: Math.round(track.start ?? 0),
          // No loop/playlist pair here on purpose: YouTube's own loop comes
          // back at 0:00 and throws away the offset. The ENDED handler below
          // does the repeat instead, and lands on the サビ every time.
        },
        events: {
          onReady: () => {
            // Pressed off again while the API was loading: stay quiet.
            if (bgm.starting) play();
          },
          onStateChange: (event) => {
            const YT = window.YT;
            const wasPlaying = bgm.playing;
            bgm.playing = event.data === YT.PlayerState.PLAYING;
            if (bgm.playing) {
              window.clearTimeout(bgm.startTimer);
              bgm.starting = false;
              if (bgm.swapping) {
                // The track swapped into the player is running: bring it up.
                bgm.swapping = false;
                fade(BGM_VOLUME, FADE_MS);
              }
            }
            paintButtons(audible());
            // Every track ends, now that nothing loops natively. Pick it
            // back up — but only one that was actually running, so this can
            // never restart a track the visitor paused.
            if (event.data === YT.PlayerState.ENDED && wasPlaying) restart();
          },
          onError: () => {
            // Video removed, private, or blocked from embedding.
            window.clearTimeout(bgm.startTimer);
            clearFade();
            bgm.playing = false;
            bgm.starting = false;
            bgm.swapping = false;
            bgm.level = BGM_VOLUME;
            paintButtons(false);
          },
        },
      });
    }

    function loadPlayer() {
      if (!bgm.track) return; // no track configured: stay silent and show nothing
      if (window.YT?.Player) {
        createPlayer();
        return;
      }

      // The API calls this global once, so chain rather than overwrite.
      const previous = window.onYouTubeIframeAPIReady;
      window.onYouTubeIframeAPIReady = () => {
        if (typeof previous === 'function') previous();
        createPlayer();
      };
      if (!document.querySelector('script[data-bgm-api]')) {
        const tag = document.createElement('script');
        tag.src = 'https://www.youtube.com/iframe_api';
        tag.dataset.bgmApi = '1';
        document.head.appendChild(tag);
      }
    }

    // A new page: whatever scene the reel was showing is behind us now.
    bgm.scene = null;
    bgm.applyContext();
  }

  document.addEventListener('astro:page-load', setupBgm);
  setupBgm();
</script>
