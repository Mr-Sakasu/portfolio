<div id="site-intro" aria-hidden="true">
  <canvas id="site-intro-canvas"></canvas>
</div>

<style is:global>
  #site-intro { position: fixed; inset: 0; z-index: 60; pointer-events: none; }
  #site-intro-canvas { display: block; width: 100%; height: 100%; }
  html:not(.intro-active) #site-intro { display: none; }
  @media (prefers-reduced-motion: reduce) { #site-intro { display: none; } }
</style>

<script>
  import { startAutumnScene } from './autumn-scene';

  let cleanup: (() => void) | undefined;
  const finish = () => {
    cleanup?.();
    cleanup = undefined;
    document.documentElement.classList.remove('intro-active');
  };
  function initIntro() {
    if (!document.documentElement.classList.contains('intro-active') || cleanup) return;
    try { sessionStorage.setItem('portfolio-autumn-intro-played', '1'); } catch { /* Storage is optional. */ }
    const canvas = document.getElementById('site-intro-canvas');
    if (!(canvas instanceof HTMLCanvasElement)) { finish(); return; }
    cleanup = startAutumnScene(canvas, { intro: true, onFinish: finish });
  }
  document.addEventListener('astro:before-swap', finish);
  document.addEventListener('astro:page-load', initIntro);
  window.addEventListener('pagehide', finish);
  initIntro();
</script>
