---
// First-visit fireworks. The transparent overlay plays above visible content.
---

<div id="site-intro" aria-hidden="true">
  <canvas id="site-intro-canvas"></canvas>
</div>

<style is:global>
  #site-intro {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
    opacity: 1;
    transition: opacity 520ms ease;
  }

  #site-intro.is-fading {
    opacity: 0;
  }

  #site-intro-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Nothing to cover when the intro never runs, so keep it out of the way. */
  html:not(.intro-active) #site-intro:not(.is-fading) {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #site-intro {
      display: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.documentElement;
    if (!root.classList.contains('intro-active')) {
      return;
    }

    // Marked as played up front, not on completion: navigating away mid-burst
    // would otherwise set the fireworks off again on the next page.
    try {
      window.sessionStorage.setItem('portfolio-intro-played', '1');
    } catch (error) {
      /* private mode: the intro simply plays again next load */
    }

    const overlay = document.getElementById('site-intro');
    const canvas = document.getElementById('site-intro-canvas');
    const context = canvas && canvas.getContext ? canvas.getContext('2d') : null;

    let finished = false;
    let frameId = 0;
    let onVisibility = null;
    let onResize = null;
    // A failed canvas or backgrounded tab should never leave an active loop.
    const finish = () => {
      if (finished) return;
      finished = true;
      window.clearTimeout(bailout);
      window.cancelAnimationFrame(frameId);
      if (onVisibility) document.removeEventListener('visibilitychange', onVisibility);
      if (onResize) window.removeEventListener('resize', onResize);
      if (overlay) {
        overlay.classList.add('is-fading');
        window.setTimeout(() => overlay.remove(), 560);
      }
      root.classList.remove('intro-active');
    };

    const bailout = window.setTimeout(finish, 6500);

    if (!context) {
      finish();
      return;
    }

    let width = 0;
    let height = 0;
    const resize = () => {
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.floor(width * ratio);
      canvas.height = Math.floor(height * ratio);
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
    };
    resize();
    onResize = resize;
    window.addEventListener('resize', onResize, { passive: true });
    onVisibility = () => {
      if (document.hidden) finish();
    };
    document.addEventListener('visibilitychange', onVisibility);

    const isLight = root.dataset.theme === 'light';
    const palettes = isLight
      ? [
          { outer: '#a16207', inner: '#7e22ce', core: '#1d4ed8' },
          { outer: '#1d4ed8', inner: '#0f766e', core: '#7e22ce' },
          { outer: '#b45309', inner: '#b91c1c', core: '#7e22ce' },
        ]
      : [
          { outer: '#ffd77a', inner: '#d9a5ff', core: '#83d8ff' },
          { outer: '#83d8ff', inner: '#77f1d1', core: '#e8d6ff' },
          { outer: '#ffb678', inner: '#ff829d', core: '#cfb3ff' },
        ];
    const shells = [];
    const sparks = [];
    const flashes = [];
    const maxSparks = width < 640 ? 480 : 660;
    const density = width < 640 ? 0.6 : 0.83;
    const launchGravity = 0.001;

    const launch = (xRatio, peakRatio, kind, palette) => {
      const targetY = height * peakRatio;
      const startY = height + 18;
      shells.push({
        x: width * xRatio,
        y: startY,
        vx: (Math.random() - 0.5) * 0.035,
        vy: -Math.sqrt(2 * launchGravity * (startY - targetY)),
        targetY,
        kind,
        palette,
        trail: [],
      });
    };

    const burst = (x, y, rawCount, speed, life, color, gravity, sparkle = false) => {
      const count = Math.round(rawCount * density);
      for (let index = 0; index < count && sparks.length < maxSparks; index += 1) {
        const angle = (index / count) * Math.PI * 2 + (Math.random() - 0.5) * 0.12;
        // A projected sphere gives a dense rim and a few stars in its centre.
        const depth = Math.random() * 2 - 1;
        const projection = Math.sqrt(1 - depth * depth);
        const velocity = speed * (0.75 + Math.random() * 0.5) * projection;
        const lifespan = life * (0.78 + Math.random() * 0.44);
        sparks.push({
          x, y, tailX: x, tailY: y,
          vx: Math.cos(angle) * velocity,
          vy: Math.sin(angle) * velocity,
          gravity,
          life: lifespan,
          maxLife: lifespan,
          color,
          sparkle: sparkle && Math.random() < 0.35,
          phase: Math.random() * Math.PI * 2,
        });
      }
    };

    const explode = (shell) => {
      const { x, y, palette } = shell;
      flashes.push({ x, y, color: palette.outer, life: 210, maxLife: 210, radius: shell.kind === 'main' ? 105 : 64 });
      if (shell.kind === 'main') {
        // Three concentric blooms: slow gold willow outside, vivid peony
        // inside, then a bright core. They fall at different rates.
        burst(x, y, 175, 0.42, 2250, palette.outer, 0.00011, true);
        burst(x, y, 110, 0.31, 1600, palette.inner, 0.000075, true);
        burst(x, y, 65, 0.19, 1050, palette.core, 0.000055);
      } else {
        burst(x, y, 100, 0.35, 1450, palette.outer, 0.000095, true);
        burst(x, y, 36, 0.18, 900, palette.inner, 0.00006);
      }
    };

    const startedAt = performance.now();
    const schedule = [
      { at: 0, x: 0.22, peak: 0.39, kind: 'side', palette: palettes[1] },
      { at: 160, x: 0.78, peak: 0.43, kind: 'side', palette: palettes[2] },
      { at: 330, x: 0.5, peak: 0.2, kind: 'main', palette: palettes[0] },
      { at: 880, x: 0.66, peak: 0.34, kind: 'side', palette: palettes[1] },
    ];
    let scheduled = 0;

    let previous = startedAt;
    const frame = (now) => {
      if (finished) return;
      // Cap the expensive canvas strokes while keeping motion time based.
      if (now - previous < (width < 640 ? 32 : 22)) {
        frameId = window.requestAnimationFrame(frame);
        return;
      }
      const delta = Math.min(now - previous, 48);
      previous = now;
      const elapsed = now - startedAt;

      while (scheduled < schedule.length && elapsed >= schedule[scheduled].at) {
        const item = schedule[scheduled];
        launch(item.x, item.peak, item.kind, item.palette);
        scheduled += 1;
      }

      context.clearRect(0, 0, width, height);
      context.globalCompositeOperation = isLight ? 'source-over' : 'lighter';
      context.lineCap = 'round';

      for (let index = flashes.length - 1; index >= 0; index -= 1) {
        const flash = flashes[index];
        flash.life -= delta;
        if (flash.life <= 0) {
          flashes.splice(index, 1);
          continue;
        }
        const strength = flash.life / flash.maxLife;
        const radius = flash.radius * (1.2 - strength * 0.35);
        const glow = context.createRadialGradient(flash.x, flash.y, 0, flash.x, flash.y, radius);
        glow.addColorStop(0, '#ffffff');
        glow.addColorStop(0.22, flash.color);
        glow.addColorStop(1, 'transparent');
        context.globalAlpha = strength * (isLight ? 0.23 : 0.55);
        context.fillStyle = glow;
        context.beginPath();
        context.arc(flash.x, flash.y, radius, 0, Math.PI * 2);
        context.fill();
      }

      for (let index = shells.length - 1; index >= 0; index -= 1) {
        const shell = shells[index];
        shell.vy += launchGravity * delta;
        shell.x += shell.vx * delta;
        shell.y += shell.vy * delta;
        shell.trail.push({ x: shell.x, y: shell.y });
        if (shell.trail.length > 10) shell.trail.shift();

        for (let order = 1; order < shell.trail.length; order += 1) {
          const point = shell.trail[order];
          const prior = shell.trail[order - 1];
          context.globalAlpha = (order / shell.trail.length) * 0.8;
          context.strokeStyle = shell.palette.outer;
          context.lineWidth = 0.8 + (order / shell.trail.length) * 2;
          context.beginPath();
          context.moveTo(prior.x, prior.y);
          context.lineTo(point.x, point.y);
          context.stroke();
        }
        context.globalAlpha = 1;
        context.fillStyle = isLight ? shell.palette.core : '#fff';
        context.beginPath();
        context.arc(shell.x, shell.y, 2.2, 0, Math.PI * 2);
        context.fill();

        if (shell.y <= shell.targetY || shell.vy >= 0) {
          explode(shell);
          shells.splice(index, 1);
        }
      }

      const drag = Math.max(0.97, 1 - 0.00042 * delta);
      const follow = Math.min(1, delta * 0.012);
      for (let index = sparks.length - 1; index >= 0; index -= 1) {
        const spark = sparks[index];
        spark.vx *= drag;
        spark.vy = spark.vy * drag + spark.gravity * delta;
        spark.x += spark.vx * delta;
        spark.y += spark.vy * delta;
        spark.tailX += (spark.x - spark.tailX) * follow;
        spark.tailY += (spark.y - spark.tailY) * follow;
        spark.life -= delta;

        if (spark.life <= 0) {
          sparks.splice(index, 1);
          continue;
        }

        const remaining = spark.life / spark.maxLife;
        const twinkle = spark.sparkle ? 0.7 + 0.3 * Math.sin(now * 0.026 + spark.phase) : 1;
        const alpha = Math.min(1, remaining * 1.35) * twinkle;
        context.globalAlpha = alpha * (isLight ? 0.12 : 0.22);
        context.strokeStyle = spark.color;
        context.lineWidth = 5;
        context.beginPath();
        context.moveTo(spark.tailX, spark.tailY);
        context.lineTo(spark.x, spark.y);
        context.stroke();
        context.globalAlpha = alpha;
        context.lineWidth = 1.65;
        context.beginPath();
        context.moveTo(spark.tailX, spark.tailY);
        context.lineTo(spark.x, spark.y);
        context.stroke();
        context.fillStyle = isLight ? spark.color : '#fff';
        context.globalAlpha = alpha * 0.72;
        context.beginPath();
        context.arc(spark.x, spark.y, 0.85, 0, Math.PI * 2);
        context.fill();
      }

      context.globalAlpha = 1;
      context.globalCompositeOperation = 'source-over';

      const spent = scheduled >= schedule.length && !shells.length && !sparks.length && !flashes.length;
      if (spent || elapsed > 5400) {
        finish();
        return;
      }
      frameId = window.requestAnimationFrame(frame);
    };

    frameId = window.requestAnimationFrame(frame);
  })();
</script>
