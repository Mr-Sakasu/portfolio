---
import playlistData from '../data/ytmusic-playlist.json';
import { ui } from '../i18n/ui';

interface Props {
  lang: keyof typeof ui;
  variant?: 'home' | 'page';
  showHeading?: boolean;
}

interface PlaylistTrack {
  videoId?: string;
  title?: string;
  artists?: string;
  album?: string;
  duration?: string;
  thumbnail?: string;
  url?: string;
  publishedAt?: string;
  uploadedAt?: string;
  addedAt?: string;
}

interface PlaylistData {
  configured?: boolean;
  byLang?: Partial<Record<keyof typeof ui, PlaylistData>>;
  playlists?: PlaylistData[];
  playlistId?: string;
  title?: string;
  description?: string;
  author?: string;
  trackCount?: number;
  duration?: string;
  thumbnail?: string;
  url?: string;
  updatedAt?: string;
  tracks?: PlaylistTrack[];
}

const { lang, variant = 'home', showHeading = true } = Astro.props;
const t = ui[lang] ?? ui.en;
const playlistRoot = playlistData as PlaylistData;
const playlistCollection = playlistRoot.byLang?.[lang] ?? playlistRoot;
const playlistOrderByLang: Partial<Record<keyof typeof ui, string[]>> = {
  zh: [
    'PLiz-kupUIzB5Wl6V7K-nHcq0OUOafpUDn',
    'PLiz-kupUIzB5_O-O6c-zNcdKe1BGJVXDZ',
  ],
  en: [
    'PLiz-kupUIzB78ViYoU-wQ6iaJ3_1G_ezI',
  ],
  ja: [
    'PLiz-kupUIzB6CcPtBlm-W9MpMuGw2I3le',
    'PLiz-kupUIzB6fO7Svf1w3dUi3GSss_H6f',
    'PLiz-kupUIzB70ktndKK9cPKR2zz9siN2A',
    'PLiz-kupUIzB5Fo3N3xVwtYsis_U9i4ol3',
    'PLiz-kupUIzB5R2QlsvnTmpFMWXiLVvxtw',
    'PLiz-kupUIzB7o_jAtsyT-iGY8gpQvOWxJ',
    'PLiz-kupUIzB4bOwHGV_WKNPi6m7m2mT8l',
    'PLiz-kupUIzB7x5yWRVSGXdNcRjnDaom6M',
    'PLiz-kupUIzB75wypS-rh2V1ZPLgae3jcu',
  ],
};
const homePlaylistByLang: Partial<Record<keyof typeof ui, string[]>> = {
  ja: ['PLiz-kupUIzB6CcPtBlm-W9MpMuGw2I3le'],
};
const unsortedSourcePlaylists = Array.isArray(playlistCollection.playlists) && playlistCollection.playlists.length > 0
  ? playlistCollection.playlists
  : [playlistCollection];
const playlistOrder = playlistOrderByLang[lang] ?? [];
const sourcePlaylists = playlistOrder.length > 0
  ? [...unsortedSourcePlaylists].sort((first, second) => {
      const firstOrder = playlistOrder.indexOf(first.playlistId ?? '');
      const secondOrder = playlistOrder.indexOf(second.playlistId ?? '');
      return (firstOrder === -1 ? Number.MAX_SAFE_INTEGER : firstOrder)
        - (secondOrder === -1 ? Number.MAX_SAFE_INTEGER : secondOrder);
    })
  : unsortedSourcePlaylists;
const homePlaylistOrder = variant === 'home' ? homePlaylistByLang[lang] ?? [] : [];
const displayPlaylists = homePlaylistOrder.length > 0
  ? sourcePlaylists.filter((playlist) => homePlaylistOrder.includes(playlist.playlistId ?? ''))
  : sourcePlaylists;
const trackTime = (track: PlaylistTrack) => {
  const rawDate = track.publishedAt || track.uploadedAt || track.addedAt || '';
  const timestamp = Date.parse(rawDate);
  return Number.isNaN(timestamp) ? Number.NEGATIVE_INFINITY : timestamp;
};
const normalizePlaylist = (playlist: PlaylistData) => {
  const tracks = Array.isArray(playlist.tracks)
    ? playlist.tracks
        .filter((track) => track?.title)
        .map((track, index) => ({ track, index }))
        .sort((first, second) => {
          const dateDifference = trackTime(second.track) - trackTime(first.track);
          return dateDifference || first.index - second.index;
        })
        .map(({ track }) => track)
    : [];
  const playlistUrl = playlist.url || (playlist.playlistId ? `https://music.youtube.com/playlist?list=${playlist.playlistId}` : '');

  return {
    ...playlist,
    tracks,
    playlistUrl,
    featuredThumbnail: playlist.thumbnail || tracks.find((track) => track.thumbnail)?.thumbnail || '',
    metaItems: [
      playlist.trackCount ? t['playlist.trackCount'].replace('{count}', String(playlist.trackCount)) : '',
      playlist.duration || '',
    ].filter(Boolean),
    isConfigured: Boolean(playlist.configured && playlist.playlistId),
    hasTracks: Boolean(playlist.configured && playlist.playlistId && tracks.length > 0),
  };
};
const configuredPlaylists = displayPlaylists.map(normalizePlaylist).filter((playlist) => playlist.isConfigured);
const visiblePlaylists = configuredPlaylists.length > 0
  ? configuredPlaylists
  : [normalizePlaylist(playlistCollection)];
const shouldRender = configuredPlaylists.length > 0 || import.meta.env.DEV;
const sectionClass = variant === 'page' ? 'mt-6' : 'mt-4 md:mt-8';
const trackListClass = variant === 'page'
  ? lang === 'ja'
    ? 'max-h-80 divide-y divide-white/10 overflow-y-auto overscroll-contain'
    : 'max-h-[70vh] divide-y divide-white/10 overflow-y-auto overscroll-contain'
  : 'max-h-72 divide-y divide-white/10 overflow-y-auto overscroll-contain';
const jpopArtistChartConfig = [
  { artist: 'Yorushika', playlistTitle: 'Liked: JPOP - Yorushika' },
  { artist: 'Zutomayo', playlistTitle: 'Liked: JPOP - Zutomayo' },
  { artist: 'YonezuKenshi', playlistTitle: 'Liked: JPOP - YonezuKenshi' },
  { artist: 'YOASOBI', playlistTitle: 'Liked: JPOP - YOASOBI' },
  { artist: 'Ado', playlistTitle: 'Liked: JPOP - Ado', auditFallbackCount: 15 },
  { artist: 'RADWIMPS', playlistTitle: 'Liked: JPOP - RADWIMPS', auditFallbackCount: 9 },
  { artist: 'SEKAI NO OWARI', playlistTitle: 'Liked: JPOP - SEKAI NO OWARI' },
  { artist: 'Orangestar', playlistTitle: 'Liked: JPOP - Orangestar' },
  { artist: 'Aqu3ra', playlistTitle: 'Liked: JPOP - Aqu3ra' },
  { artist: 'Vocaloid', playlistTitle: 'Liked: JPOP - Vocaloid', auditFallbackCount: 25 },
  { artist: 'tuki.', playlistTitle: 'Liked: JPOP - tuki.', auditFallbackCount: 4 },
  { artist: 'Sangatsu no Phantasia', playlistTitle: 'Liked: JPOP - Sangatsu no Phantasia', auditFallbackCount: 10 },
  { artist: 'Mrs. GREEN APPLE', playlistTitle: 'Liked: JPOP - Mrs. GREEN APPLE', auditFallbackCount: 4 },
  { artist: 'Vaundy', playlistTitle: 'Liked: JPOP - Vaundy', auditFallbackCount: 2 },
  { artist: 'Sakanaction', playlistTitle: 'Liked: JPOP - Sakanaction', auditFallbackCount: 4 },
  { artist: 'yama', playlistTitle: 'Liked: JPOP - yama', auditFallbackCount: 3 },
  { artist: 'Reol', playlistTitle: 'Liked: JPOP - Reol', auditFallbackCount: 4 },
];
const englishArtistNameOverrides: Record<string, string> = {
  'AbbaVEVO': 'ABBA',
  'billyjoelVEVO': 'Billy Joel',
  'DefTech004': 'Def Tech',
  'IBeLovinTheJ5': 'The Jackson 5',
  'JFlaMusic': 'J.Fla',
  'JustinBieberVEVO': 'Justin Bieber',
  'KnaanVEVO': "K'NAAN",
  'littlemixVEVO': 'Little Mix',
  'MIKAVEVO': 'MIKA',
  'MKTOVEVO': 'MKTO',
  'oasisvideos': 'Oasis',
  'PentatonixVEVO': 'Pentatonix',
  'PostmodernJukebox': 'Postmodern Jukebox',
  'RachelPlattenVEVO': 'Rachel Platten',
  'TheKillersVEVO': 'The Killers',
  'TimefliesVEVO': 'Timeflies',
  'VideoHitsBelemBrazil': 'Kylie Minogue',
  'XXxxZakixxXX': 'Weezer',
};
const englishArtistFromTitle = (title: string) => {
  const knownArtists = [
    'Billy Joel',
    'Bruno Mars',
    'Daniel Powter',
    'Dua Lipa',
    'Ed Sheeran',
    'Green Day',
    'James Blunt',
    'John Lennon',
    'Kylie Minogue',
    'Little Mix',
    'MIKA',
    'Oasis',
    'Pentatonix',
    'Rachel Platten',
    'The Carpenters',
    'The Killers',
    'Weezer',
  ];
  const loweredTitle = title.toLowerCase();
  return knownArtists.find((artist) => loweredTitle.startsWith(artist.toLowerCase())) ?? '';
};
const englishRelatedArtistByVideoId: Record<string, string> = {
  '7RZ12L-sp7g': 'Maroon 5',
};
const englishRelatedArtistFromTrack = (track: PlaylistTrack) => {
  const videoIdArtist = englishRelatedArtistByVideoId[track.videoId ?? ''];
  if (videoIdArtist) {
    return videoIdArtist;
  }

  const title = (track.title ?? '').trim().toLowerCase();
  if (title === 'memories (feat. ben woodward)') {
    return 'Maroon 5';
  }

  return '';
};
const normalizeEnglishArtist = (track: PlaylistTrack) => {
  const relatedArtist = englishRelatedArtistFromTrack(track);
  if (relatedArtist) {
    return relatedArtist;
  }

  const titleArtist = englishArtistFromTitle(track.title ?? '');
  if (titleArtist) {
    return titleArtist;
  }

  const rawArtist = (track.artists ?? '').trim();
  const mappedArtist = englishArtistNameOverrides[rawArtist] ?? rawArtist;
  const normalizedArtist = mappedArtist
    .replace(/\s+-\s+Topic$/, '')
    .replace(/VEVO$/, '')
    .trim();
  return englishArtistNameOverrides[normalizedArtist] ?? (normalizedArtist || t['playlist.unknownArtist']);
};
const playlistByTitle = new Map(sourcePlaylists.map((playlist) => [playlist.title, playlist]));
const playlistTrackCount = (playlist?: PlaylistData) => {
  if (!playlist) {
    return undefined;
  }
  if (typeof playlist.trackCount === 'number') {
    return playlist.trackCount;
  }
  return Array.isArray(playlist.tracks)
    ? playlist.tracks.filter((track) => track?.title).length
    : undefined;
};
const formatTrackCount = (count: number) => (
  lang === 'en' && count === 1
    ? '1 track'
    : t['playlist.trackCount'].replace('{count}', String(count))
);
const englishArtistCounts = new Map<string, number>();
if (lang === 'en') {
  sourcePlaylists.forEach((playlist) => {
    (playlist.tracks ?? [])
      .filter((track) => track?.title)
      .forEach((track) => {
        const artist = normalizeEnglishArtist(track);
        englishArtistCounts.set(artist, (englishArtistCounts.get(artist) ?? 0) + 1);
      });
  });
}
const englishArtistChartItems = [...englishArtistCounts.entries()]
  .map(([artist, count], index) => ({ artist, count, order: index }))
  .sort((first, second) => second.count - first.count || first.artist.localeCompare(second.artist));
const artistChartItems = lang === 'ja'
  ? jpopArtistChartConfig
      .map((item, index) => {
        const playlist = playlistByTitle.get(item.playlistTitle);
        const count = playlistTrackCount(playlist) ?? item.auditFallbackCount ?? 0;
        return { ...item, count, order: index };
      })
      .filter((item) => item.count > 0)
      .sort((first, second) => second.count - first.count || first.order - second.order)
  : lang === 'en'
    ? englishArtistChartItems
    : [];
const artistChartMaxCount = Math.max(...artistChartItems.map((item) => item.count), 1);
const artistChartTotalCount = artistChartItems.reduce((total, item) => total + item.count, 0);
// A single arc walked in order, OKLCH hue 320 -> 140: purple through blue and
// teal into green, with lightness alternating 0.76/0.55 so neighbouring slices
// separate on lightness as well as hue. The card behind them is a fixed dark
// #0f151f in both themes, so the light steps stay readable. Adjacent pairs
// (including the wrap from the last slice back to the first) clear the
// normal-vision ΔE 15 floor at ΔE 21.1 worst case for any slice count from 9
// to 20 (the list is 20 long so a 17-artist chart cannot wrap onto its own
// first colour); the legend rows carry name and count, so colour never
// identifies alone.
const artistChartPalette = [
  '#d695e4',
  '#8f51b5',
  '#bf9df6',
  '#755bc6',
  '#a5a6ff',
  '#5466cd',
  '#88b0ff',
  '#1971cb',
  '#61b9fd',
  '#017bab',
  '#38c2ef',
  '#007f96',
  '#01c8da',
  '#008284',
  '#16cbbf',
  '#078471',
  '#47cba2',
  '#028756',
  '#70c883',
  '#34871d',
];
let artistChartOffset = 0;
const artistChartSlices = artistChartItems.map((item, index) => {
  const percentage = artistChartTotalCount > 0
    ? (item.count / artistChartTotalCount) * 100
    : 0;
  const start = artistChartOffset;
  artistChartOffset += percentage;
  return {
    ...item,
    color: artistChartPalette[index % artistChartPalette.length],
    percentage,
    start,
    end: artistChartOffset,
  };
});
const artistChartGradient = artistChartSlices
  .map((item) => `${item.color} ${item.start.toFixed(4)}% ${item.end.toFixed(4)}%`)
  .join(', ');
const formatPercentage = (percentage: number) => (
  percentage >= 10 ? `${Math.round(percentage)}%` : `${percentage.toFixed(1)}%`
);
const shouldShowArtistChart = variant === 'page' && artistChartItems.length > 0;
---

{shouldRender && (
  <section class={sectionClass}>
    {showHeading && (
      <div class="mb-5" data-reveal>
        <h2 class="text-2xl md:text-3xl font-bold text-violet-300">
          {t['playlist.eyebrow']}
        </h2>
        <span class="section-rule bg-gradient-to-r from-violet-500 via-blue-500 to-emerald-400" aria-hidden="true"></span>
        <p class="mt-3 text-sm text-gray-400">{t['playlist.subtitle']}</p>
      </div>
    )}

    {shouldShowArtistChart && (
      <div class="mb-6 overflow-hidden rounded-xl border border-white/10 bg-[#0f151f]/85 p-4 shadow-[0_12px_30px_-28px_rgba(15,23,42,0.95)] sm:p-5" data-reveal>
        <div class="flex flex-col gap-3 border-b border-white/10 pb-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h2 class="text-xl font-black leading-tight text-white sm:text-2xl">
              {t['playlist.artistChart.title']}
            </h2>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-gray-400">
              {t['playlist.artistChart.subtitle']}
            </p>
          </div>
          <div class="shrink-0 sm:text-right">
            <p class="text-[11px] font-semibold uppercase tracking-widest text-violet-100/65">
              {t['playlist.artistChart.total']}
            </p>
            <p class="mt-1 text-2xl font-black tabular-nums text-violet-100">
              {formatTrackCount(artistChartTotalCount)}
            </p>
          </div>
        </div>

        {lang === 'ja' ? (
          <div class="mt-5 grid gap-5 lg:grid-cols-[minmax(14rem,19rem)_minmax(0,1fr)] lg:items-center">
            <div
              class="mx-auto aspect-square w-full max-w-72 rounded-full border border-white/10 shadow-[0_18px_45px_-24px_rgba(15,23,42,0.95)]"
              role="img"
              aria-label={`${t['playlist.artistChart.title']}: ${artistChartSlices.map((item) => `${item.artist} ${formatTrackCount(item.count)}`).join(', ')}`}
              style={`background: conic-gradient(${artistChartGradient});`}
            ></div>
            <div class="max-h-96 space-y-2 overflow-y-auto overscroll-contain pr-1">
              {artistChartSlices.map((item) => (
                <div class="grid min-w-0 grid-cols-[0.75rem_minmax(0,1fr)_auto] items-center gap-3 rounded-md bg-white/[0.035] px-3 py-2">
                  <span
                    class="h-3 w-3 rounded-full"
                    style={`background-color: ${item.color};`}
                  ></span>
                  <span class="min-w-0 truncate text-sm font-semibold leading-snug text-white" title={item.artist}>
                    {item.artist}
                  </span>
                  <span class="whitespace-nowrap text-right text-xs tabular-nums text-gray-300">
                    {formatTrackCount(item.count)} / {formatPercentage(item.percentage)}
                  </span>
                </div>
              ))}
            </div>
          </div>
        ) : (
          <div class="mt-4 max-h-80 space-y-3 overflow-y-auto overscroll-contain pr-1">
            {artistChartItems.map((item) => (
              <div class="grid gap-2 sm:grid-cols-[13rem_minmax(0,1fr)_5rem] sm:items-center">
                <div class="flex min-w-0 items-baseline justify-between gap-3 sm:block">
                  <span class="block break-words text-sm font-semibold leading-snug text-white">
                    {item.artist}
                  </span>
                  <span class="shrink-0 text-xs tabular-nums text-gray-400 sm:hidden">
                    {formatTrackCount(item.count)}
                  </span>
                </div>
                <div
                  class="h-3 overflow-hidden rounded-full bg-white/[0.06]"
                  role="img"
                  aria-label={`${item.artist}: ${formatTrackCount(item.count)}`}
                >
                  <span
                    class="block h-full rounded-full bg-gradient-to-r from-violet-300 via-blue-300 to-emerald-300"
                    style={`width: ${Math.max(4, Math.round((item.count / artistChartMaxCount) * 100))}%`}
                  ></span>
                </div>
                <span class="hidden text-right text-xs tabular-nums text-gray-300 sm:block">
                  {formatTrackCount(item.count)}
                </span>
              </div>
            ))}
          </div>
        )}
      </div>
    )}

    <div class="space-y-4">
      {visiblePlaylists.map((playlist) => (
        <div
          class="overflow-hidden rounded-xl border border-white/10 bg-[#111722]/80 backdrop-blur-md shadow-[0_12px_30px_-28px_rgba(15,23,42,0.95)]"
          data-reveal
          style="--reveal-delay: 80ms;"
          data-playlist-card
        >
          {playlist.hasTracks ? (
            <>
              <a
                href={playlist.playlistUrl}
                target="_blank"
                rel="noreferrer"
                class="group flex items-center gap-3 p-4 transition-colors hover:bg-white/[0.04] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-violet-200/70 sm:gap-4 sm:p-5"
              >
                {playlist.featuredThumbnail && (
                  <img
                    src={playlist.featuredThumbnail}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="h-16 w-16 shrink-0 rounded-md object-cover sm:h-20 sm:w-20"
                  />
                )}
                <div class="min-w-0 flex-1">
                  <h3 class="text-lg font-black leading-tight text-white break-words group-hover:text-violet-100 sm:text-xl">
                    {playlist.title || t['playlist.titleFallback']}
                  </h3>
                  {playlist.metaItems.length > 0 && (
                    <p class="mt-1.5 text-[11px] uppercase tracking-widest text-violet-100/65 sm:mt-2 sm:text-xs">
                      {playlist.metaItems.join(' / ')}
                    </p>
                  )}
                  {playlist.description && (
                    <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-gray-300">
                      {playlist.description}
                    </p>
                  )}
                </div>
              </a>

              <div class="hidden border-y border-white/10 bg-black/25 p-3" data-playlist-player>
                <div class="mb-2 truncate text-xs font-semibold text-violet-100/80" data-player-title></div>
                <div class="aspect-video overflow-hidden rounded-md bg-black">
                  <iframe
                    title="YouTube player"
                    class="h-full w-full"
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                    referrerpolicy="strict-origin-when-cross-origin"
                    data-player-frame
                  ></iframe>
                </div>
              </div>

              <div class={trackListClass}>
                {playlist.tracks.map((track, index) => (
                  <div class="group flex min-h-20 items-center gap-3 px-4 py-3 transition-colors hover:bg-white/[0.04] sm:gap-4 sm:px-5">
                    {track.videoId && (
                      <button
                        type="button"
                        class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-violet-200/20 bg-violet-300/10 text-violet-100 transition hover:border-violet-100/60 hover:bg-violet-200/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet-200"
                        aria-label={`Play ${track.title}`}
                        aria-pressed="false"
                        data-play-button
                        data-video-id={track.videoId}
                        data-playlist-id={playlist.playlistId}
                        data-track-title={track.title}
                      >
                        <svg
                          aria-hidden="true"
                          viewBox="0 0 24 24"
                          class="ml-0.5 h-4 w-4 fill-current"
                        >
                          <path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86A1 1 0 0 0 8 5.14Z"></path>
                        </svg>
                      </button>
                    )}
                    <span class="w-6 shrink-0 text-right text-sm font-mono text-violet-100/45">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    {track.thumbnail ? (
                      <img
                        src={track.thumbnail}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        class="h-12 w-12 shrink-0 rounded object-cover"
                      />
                    ) : (
                      <span class="h-12 w-12 shrink-0 rounded bg-white/[0.04]"></span>
                    )}
                    <a
                      href={playlist.playlistUrl}
                      target="_blank"
                      rel="noreferrer"
                      class="min-w-0 flex-1"
                    >
                      <span class="block truncate text-sm font-semibold text-white group-hover:text-violet-100">
                        {track.title}
                      </span>
                      <span class="mt-1 block truncate text-xs text-gray-400">
                        {[track.artists, track.album].filter(Boolean).join(' / ') || t['playlist.unknownArtist']}
                      </span>
                    </a>
                    {track.duration && (
                      <span class="shrink-0 text-xs tabular-nums text-gray-500">{track.duration}</span>
                    )}
                  </div>
                ))}
              </div>
            </>
          ) : (
            <div class="p-5">
              <h3 class="text-lg font-bold text-white">{t['playlist.titleFallback']}</h3>
              <p class="mt-2 text-sm leading-relaxed text-gray-400">{t['playlist.empty']}</p>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>
)}

<script>
  const playlistWindow = window as Window & {
    __playlistPlayerHookAttached?: boolean;
  };

  const buildEmbedUrl = (videoId: string, playlistId: string) => {
    const params = new URLSearchParams({
      autoplay: '1',
      rel: '0',
      playsinline: '1',
    });
    if (playlistId) {
      params.set('list', playlistId);
    }
    return `https://www.youtube.com/embed/${encodeURIComponent(videoId)}?${params.toString()}`;
  };

  const clearPlaylistPlayers = () => {
    document.querySelectorAll<HTMLIFrameElement>('[data-player-frame]').forEach((frame) => {
      frame.src = '';
    });
  };

  if (!playlistWindow.__playlistPlayerHookAttached) {
    document.addEventListener('click', (event) => {
      const target = event.target;
      const button = target instanceof Element
        ? target.closest<HTMLButtonElement>('[data-play-button]')
        : null;

      if (!button) {
        return;
      }

      const card = button.closest<HTMLElement>('[data-playlist-card]');
      const player = card?.querySelector<HTMLElement>('[data-playlist-player]');
      const frame = card?.querySelector<HTMLIFrameElement>('[data-player-frame]');
      const title = card?.querySelector<HTMLElement>('[data-player-title]');
      const videoId = button.dataset.videoId ?? '';

      if (!card || !player || !frame || !videoId) {
        return;
      }

      card.querySelectorAll<HTMLButtonElement>('[data-play-button]').forEach((item) => {
        item.setAttribute('aria-pressed', item === button ? 'true' : 'false');
      });

      if (title) {
        title.textContent = button.dataset.trackTitle ?? '';
      }
      frame.src = buildEmbedUrl(videoId, button.dataset.playlistId ?? '');
      player.classList.remove('hidden');
      player.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    });

    document.addEventListener('astro:before-swap', clearPlaylistPlayers);
    playlistWindow.__playlistPlayerHookAttached = true;
  }
</script>

<style>
  [data-play-button][aria-pressed='true'] {
    border-color: rgb(221 214 254 / 0.8);
    background: rgb(167 139 250 / 0.22);
    color: rgb(245 243 255);
  }

  [data-playlist-card] {
    position: relative;
  }

  /* A quiet, static edge keeps the bento surface present without competing
     with the music content or the site's background fireworks. */
  [data-playlist-card]::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(120deg, rgb(96 165 250 / 0.72), rgb(167 139 250 / 0.72), rgb(110 231 183 / 0.72));
    opacity: 0.5;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    /* The ring sits above the card content, so it must never eat a click. */
    pointer-events: none;
  }
</style>
