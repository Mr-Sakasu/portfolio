            border-color 220ms ease,
            box-shadow 220ms ease,
            background-color 180ms ease;
    }

    .site-card:hover {
        transform: translateY(-3px);
        border-color: var(--site-card-border-hover);
        box-shadow: var(--site-card-shadow-hover);
    }

    .section-rule {
        display: block;
        height: 3px;
        width: 3.25rem;
        margin-top: 0.7rem;
        border-radius: 9999px;
    }

    .star-on {
        color: var(--site-star-on);
    }

    .star-off {
        color: var(--site-star-off);
    }

    .chip {
        display: inline-flex;
        align-items: center;
        border-radius: 9999px;
        border: 1px solid var(--site-card-border);
        background: var(--site-chip-bg);
        padding: 0.28rem 0.65rem;
        font-size: 11px;
        font-weight: 600;
        line-height: 1;
        color: var(--site-muted);
        transition: color 180ms ease, border-color 180ms ease;
    }

    .btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border-radius: 9999px;
        border: 1px solid var(--site-card-border);
        background: var(--site-chip-bg);
        padding: 0.5rem 1.1rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--site-subtle);
        transition:
