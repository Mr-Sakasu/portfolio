---
import { ClientRouter } from 'astro:transitions';
import Background from '../components/chrome/Background.astro';
import Bgm from '../components/chrome/Bgm.astro';
import Intro from '../components/chrome/Intro.astro';
import SiteFooter from '../components/chrome/SiteFooter.astro';
import SiteHeader from '../components/chrome/SiteHeader.astro';
import '../styles/tokens.css';

const { title, lang, description, wide = false } = Astro.props;
const pageDescription = typeof description === 'string' && description.trim().length
  ? description.trim()
  : 'Sakasu portfolio with interactive star watching and bandit optimization demos.';
const contentWidth = wide ? 'max-w-6xl' : 'max-w-3xl';
const introEligible = /^\/(?:en|zh|ja)\/$/.test(Astro.url.pathname);
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth bg-[#0a0e17]" data-intro-eligible={introEligible ? 'true' : undefined}>
		<head>
			<meta charset="UTF-8" />
			<meta name="viewport" content="width=device-width, initial-scale=1" />
			<meta name="description" content={pageDescription} />
			<title>{title}</title>
			<link rel="preconnect" href="https://fonts.googleapis.com" />
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
			<link
				href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&family=Space+Grotesk:wght@500;600;700&display=swap"
				rel="stylesheet"
			/>
            <script is:inline>
                (() => {
                    const storageKey = 'portfolio-theme';
                    let theme = 'dark';
                    try {
                        const storedTheme = window.localStorage.getItem(storageKey);
                        if (storedTheme === 'dark' || storedTheme === 'light') {
                            theme = storedTheme;
                        }
                    } catch {
                        theme = 'dark';
                    }
                    document.documentElement.dataset.theme = theme;
                    document.documentElement.style.colorScheme = theme;
                    document.documentElement.classList.add('js');

                    let introPlayed = true;
                    try {
                        introPlayed = window.sessionStorage.getItem('portfolio-intro-played') === '1';
                    } catch (error) {
                        introPlayed = false;
                    }
                    const stillMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                    const introEligible = document.documentElement.dataset.introEligible === 'true';
                    if (introEligible && !introPlayed && !stillMotion) {
                        document.documentElement.classList.add('intro-active');
                    }
                })();
            </script>
			<ClientRouter />
		</head>
	<body class="text-white font-sans antialiased min-h-screen flex flex-col relative">
		
        <Intro />
        <Background />
        <Bgm />

        <SiteHeader lang={lang} contentWidth={contentWidth} />

		<main class={`box-border w-full ${contentWidth} mx-auto p-4 md:p-6 flex-grow relative z-10`}>
			<slot />
		</main>

        <SiteFooter contentWidth={contentWidth} />

	</body>
</html>

<script is:inline>
    (() => {
        const storageKey = 'portfolio-theme';

        const readTheme = () => (
            document.documentElement.dataset.theme === 'light' ? 'light' : 'dark'
        );

        const syncThemeButtons = () => {
            const theme = readTheme();
            document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
                if (!(button instanceof HTMLButtonElement)) return;
                button.dataset.activeTheme = theme;
                button.setAttribute('aria-pressed', String(theme === 'light'));
            });
        };

        const setTheme = (theme) => {
            document.documentElement.dataset.theme = theme;
            document.documentElement.style.colorScheme = theme;
            try {
                window.localStorage.setItem(storageKey, theme);
            } catch {
                // Local storage can be disabled; the current document can still switch themes.
            }
            syncThemeButtons();
            window.dispatchEvent(new CustomEvent('portfolio-theme-change', { detail: { theme } }));
        };

        const initThemeToggle = () => {
            syncThemeButtons();
            document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
                if (!(button instanceof HTMLButtonElement)) return;
                button.onclick = () => {
                    setTheme(readTheme() === 'dark' ? 'light' : 'dark');
                };
            });
        };

        window.__setPortfolioTheme = setTheme;
        initThemeToggle();

        if (!window.__portfolioThemeToggleHookAttached) {
            document.addEventListener('astro:page-load', initThemeToggle);
            window.__portfolioThemeToggleHookAttached = true;
        }
    })();
</script>

<script is:inline>
    (() => {
        const revealNow = (el) => {
            el.classList.add('is-revealed', 'is-done');
        };

        const initReveals = () => {
            const elements = Array.from(document.querySelectorAll('[data-reveal]:not(.is-revealed)'));
            if (!elements.length) return;

            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (reduceMotion || !('IntersectionObserver' in window)) {
                elements.forEach(revealNow);
                return;
            }

            const observer = new IntersectionObserver((entries) => {
                for (const entry of entries) {
                    if (!entry.isIntersecting) continue;
                    const el = entry.target;
                    observer.unobserve(el);
                    el.classList.add('is-revealed');
                    el.addEventListener('animationend', (event) => {
                        if (event.target === el && event.animationName === 'site-reveal') {
                            el.classList.add('is-done');
                        }
                    });
                }
            }, { rootMargin: '0px 0px -8% 0px', threshold: 0.1 });

            elements.forEach((el) => observer.observe(el));
        };

        initReveals();
        if (!window.__portfolioRevealHookAttached) {
            document.addEventListener('astro:page-load', initReveals);
            window.__portfolioRevealHookAttached = true;
        }
    })();
</script>

<style is:global>
    html,
    body {
        background-color: var(--site-bg);
        transition: background-color 180ms ease, color 180ms ease;
    }

    body {
        color: var(--site-text);
    }

    h1,
    h2,
    h3 {
        font-family: 'Space Grotesk', 'Noto Sans JP', ui-sans-serif, system-ui, sans-serif;
        letter-spacing: -0.01em;
    }

    ::selection {
        background: rgba(56, 189, 248, 0.32);
    }

    html[data-theme='light'] ::selection {
        background: rgba(37, 99, 235, 0.2);
    }

    :focus-visible {
        outline: 2px solid rgba(56, 189, 248, 0.7);
        outline-offset: 2px;
    }

    html[data-theme='light'] :focus-visible {
        outline-color: rgba(37, 99, 235, 0.7);
    }

    /* Scroll reveal: elements with [data-reveal] float in when they enter the viewport. */
    html.js [data-reveal]:not(.is-revealed) {
        opacity: 0;
    }

    [data-reveal].is-revealed {
        animation: site-reveal var(--reveal-duration, 1.15s) cubic-bezier(0.16, 1, 0.3, 1) both;
        animation-delay: var(--reveal-delay, 0ms);
    }

    [data-reveal].is-done {
        opacity: 1;
        animation: none;
    }

    @keyframes site-reveal {
        from {
            opacity: 0;
            transform: translateY(28px);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        html.js [data-reveal]:not(.is-revealed) {
            opacity: 1;
        }

        [data-reveal].is-revealed {
            animation: none;
        }
    }

    .site-header {
        background: var(--site-header-bg);
        border-bottom: 1px solid var(--site-card-border);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        transition: background-color 180ms ease, border-color 180ms ease;
    }

    .site-brand__dot {
        background: linear-gradient(120deg, #3b82f6, #22d3ee);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .site-footer {
        border-top: 1px solid var(--site-card-border);
    }

    .site-card {
        border: 1px solid var(--site-card-border);
        background-color: var(--site-card-bg);
        border-radius: 1rem;
        box-shadow: var(--site-card-shadow);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        transition:
