---
import { ClientRouter } from 'astro:transitions';
import LanguagePicker from '../components/LanguagePicker.astro';
import Background from '../components/Background.astro';
import { ui } from '../i18n/ui';

const { title, lang, description } = Astro.props;
const pageDescription = typeof description === 'string' && description.trim().length
  ? description.trim()
  : 'Sakasu portfolio with interactive star watching and bandit optimization demos.';
const t = ui[lang as keyof typeof ui] ?? ui.en;
const isStarsPage = Astro.url.pathname.includes('/stars');
const isBanditPage = Astro.url.pathname.includes('/bandit');
const isPlaylistPage = Astro.url.pathname.includes('/playlist');
const navBaseClass = 'shrink-0 whitespace-nowrap rounded-md border px-3 py-1.5 text-xs md:text-sm transition-colors';
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth bg-[#111]">
		<head>
			<meta charset="UTF-8" />
			<meta name="viewport" content="width=device-width" />
			<meta name="description" content={pageDescription} />
			<title>{title}</title>
            <script is:inline>
                (() => {
                    const storageKey = 'portfolio-theme';
                    let theme = 'dark';
                    try {
                        const storedTheme = window.localStorage.getItem(storageKey);
                        if (storedTheme === 'dark' || storedTheme === 'light') {
                            theme = storedTheme;
                        }
                    } catch {
                        theme = 'dark';
                    }
                    document.documentElement.dataset.theme = theme;
                    document.documentElement.style.colorScheme = theme;
                })();
            </script>
			<ClientRouter />
		</head>
	<body class="text-white font-sans antialiased min-h-screen flex flex-col relative">
		
        <Background />

        <header class="box-border w-full max-w-3xl mx-auto px-4 py-4 md:p-6 border-b border-gray-800/50 relative z-10">
            <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                <div class="flex items-center justify-between gap-4">
                    <a href={`/${lang}/`} class="text-lg md:text-xl font-bold tracking-wider hover:text-blue-400 transition-colors whitespace-nowrap">
                        Sakasu's note
                    </a>
                    <div class="flex items-center gap-2 md:hidden shrink-0">
                        <button
                            type="button"
                            data-theme-toggle
                            class="theme-toggle inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-gray-700 text-gray-300 transition-colors hover:border-blue-400/60 hover:text-white"
                            aria-label={t['theme.toggle']}
                            title={t['theme.toggle']}
                        >
                            <span class="theme-toggle__icon theme-toggle__icon--dark" aria-hidden="true">☾</span>
                            <span class="theme-toggle__icon theme-toggle__icon--light" aria-hidden="true">☀</span>
                        </button>
                        <LanguagePicker />
                    </div>
                </div>

                <nav aria-label="Top navigation" class="w-full md:flex-1 md:flex md:justify-center">
                    <div class="flex items-center gap-2 overflow-x-auto pb-1 md:pb-0">
                        <a
                            href={`/${lang}/playlist/`}
                            class={`${navBaseClass} ${
                                isPlaylistPage
                                    ? 'border-rose-400/70 bg-rose-500/15 text-rose-300'
                                    : 'border-gray-700 text-gray-300 hover:border-rose-400/60 hover:text-white'
                            }`}
                        >
                            {t['nav.playlist']}
                        </a>
                        <a
                            href={`/${lang}/stars/`}
                            class={`${navBaseClass} ${
                                isStarsPage
                                    ? 'border-blue-400/70 bg-blue-500/15 text-blue-300'
                                    : 'border-gray-700 text-gray-300 hover:border-blue-400/60 hover:text-white'
                            }`}
                        >
                            {t['nav.stars']}
                        </a>
                        <a
                            href={`/${lang}/bandit/`}
                            class={`${navBaseClass} ${
                                isBanditPage
                                    ? 'border-cyan-400/70 bg-cyan-500/15 text-cyan-300'
                                    : 'border-gray-700 text-gray-300 hover:border-cyan-400/60 hover:text-white'
                            }`}
                        >
                            {t['nav.bandit']}
                        </a>
                    </div>
                </nav>

                <div class="hidden md:flex md:items-center md:gap-2 shrink-0">
                    <button
                        type="button"
                        data-theme-toggle
                        class="theme-toggle inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-gray-700 text-gray-300 transition-colors hover:border-blue-400/60 hover:text-white"
                        aria-label={t['theme.toggle']}
                        title={t['theme.toggle']}
                    >
                        <span class="theme-toggle__icon theme-toggle__icon--dark" aria-hidden="true">☾</span>
                        <span class="theme-toggle__icon theme-toggle__icon--light" aria-hidden="true">☀</span>
                    </button>
                    <LanguagePicker />
                </div>
            </div>
			</header>

		<main class="box-border w-full max-w-3xl mx-auto p-6 flex-grow relative z-10">
			<slot />
		</main>

        <footer class="text-center p-8 text-gray-600 text-sm relative z-10">
            2025 Sakasu
        </footer>

	</body>
</html>

<script is:inline>
    (() => {
        const storageKey = 'portfolio-theme';

        const readTheme = () => (
            document.documentElement.dataset.theme === 'light' ? 'light' : 'dark'
        );

        const syncThemeButtons = () => {
            const theme = readTheme();
            document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
                if (!(button instanceof HTMLButtonElement)) return;
                button.dataset.activeTheme = theme;
                button.setAttribute('aria-pressed', String(theme === 'light'));
            });
        };

        const setTheme = (theme) => {
            document.documentElement.dataset.theme = theme;
            document.documentElement.style.colorScheme = theme;
            try {
                window.localStorage.setItem(storageKey, theme);
            } catch {
                // Local storage can be disabled; the current document can still switch themes.
            }
            syncThemeButtons();
            window.dispatchEvent(new CustomEvent('portfolio-theme-change', { detail: { theme } }));
        };

        const initThemeToggle = () => {
            syncThemeButtons();
            document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
                if (!(button instanceof HTMLButtonElement)) return;
                button.onclick = () => {
                    setTheme(readTheme() === 'dark' ? 'light' : 'dark');
                };
            });
        };

        window.__setPortfolioTheme = setTheme;
        initThemeToggle();

        if (!window.__portfolioThemeToggleHookAttached) {
            document.addEventListener('astro:page-load', initThemeToggle);
            window.__portfolioThemeToggleHookAttached = true;
        }
    })();
</script>

<style is:global>
    :root {
        color-scheme: dark;
        --site-bg: #111;
        --site-text: #f8fafc;
        --site-muted: #94a3b8;
        --site-subtle: #cbd5e1;
        --site-border: rgba(51, 65, 85, 0.75);
        --site-surface: rgba(17, 23, 34, 0.8);
        --site-surface-strong: rgba(15, 23, 42, 0.92);
        --site-surface-soft: rgba(8, 13, 23, 0.8);
    }

    html[data-theme='light'] {
        color-scheme: light;
        --site-bg: #f5f7fb;
        --site-text: #0f172a;
        --site-muted: #475569;
        --site-subtle: #334155;
        --site-border: rgba(148, 163, 184, 0.48);
        --site-surface: rgba(255, 255, 255, 0.84);
        --site-surface-strong: rgba(255, 255, 255, 0.94);
        --site-surface-soft: rgba(241, 245, 249, 0.78);
    }

    html,
    body {
        background-color: var(--site-bg);
        transition: background-color 180ms ease, color 180ms ease;
    }

    body {
        color: var(--site-text);
    }

    .theme-toggle__icon {
        font-size: 1.05rem;
        line-height: 1;
    }

    .theme-toggle__icon--light {
        display: none;
    }

    html[data-theme='light'] .theme-toggle__icon--dark {
        display: none;
    }

    html[data-theme='light'] .theme-toggle__icon--light {
        display: inline;
    }

    html[data-theme='light'] .text-white {
        color: var(--site-text) !important;
    }

    html[data-theme='light'] .bg-blue-600.text-white {
        color: #fff !important;
    }

    html[data-theme='light'] .text-gray-300,
    html[data-theme='light'] [class*='text-slate-300'] {
        color: var(--site-subtle) !important;
    }

    html[data-theme='light'] .text-gray-400,
    html[data-theme='light'] [class*='text-slate-400'] {
        color: var(--site-muted) !important;
    }

    html[data-theme='light'] .text-gray-500,
    html[data-theme='light'] .text-gray-600 {
        color: #64748b !important;
    }

    html[data-theme='light'] .text-gray-100,
    html[data-theme='light'] [class*='text-slate-100'] {
        color: #334155 !important;
    }

    html[data-theme='light'] [class*='text-blue-100'] {
        color: #1d4ed8 !important;
    }

    html[data-theme='light'] [class*='text-cyan-100'] {
        color: #0e7490 !important;
    }

    html[data-theme='light'] [class*='text-sky-100'] {
        color: #0369a1 !important;
    }

    html[data-theme='light'] .text-blue-300 {
        color: #2563eb !important;
    }

    html[data-theme='light'] .text-cyan-300 {
        color: #0891b2 !important;
    }

    html[data-theme='light'] .text-rose-300 {
        color: #e11d48 !important;
    }

    html[data-theme='light'] [class~='text-rose-100/45'],
    html[data-theme='light'] [class~='text-rose-100/65'] {
        color: rgba(190, 18, 60, 0.78) !important;
    }

    html[data-theme='light'] .group:hover .group-hover\:text-rose-100 {
        color: #be123c !important;
    }

    html[data-theme='light'] [class*='text-blue-200'] {
        color: rgba(29, 78, 216, 0.82) !important;
    }

    html[data-theme='light'] .from-white {
        --tw-gradient-from: #0f172a var(--tw-gradient-from-position) !important;
        --tw-gradient-to: rgb(15 23 42 / 0) var(--tw-gradient-to-position) !important;
        --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to) !important;
    }

    html[data-theme='light'] .to-gray-600 {
        --tw-gradient-to: #64748b var(--tw-gradient-to-position) !important;
    }

    html[data-theme='light'] .to-blue-300 {
        --tw-gradient-to: #2563eb var(--tw-gradient-to-position) !important;
    }

    html[data-theme='light'] [class*='bg-[#111722'],
    html[data-theme='light'] [class*='bg-[#101722'],
    html[data-theme='light'] [class*='bg-[#121b2a'],
    html[data-theme='light'] [class*='bg-[#131c2a'],
    html[data-theme='light'] [class*='bg-[#151515'],
    html[data-theme='light'] [class*='bg-[#17151a'],
    html[data-theme='light'] [class*='bg-[#121212'],
    html[data-theme='light'] [class*='bg-[#11141d'] {
        background-color: var(--site-surface) !important;
    }

    html[data-theme='light'] [class*='bg-[#080d17'],
    html[data-theme='light'] [class*='bg-[#060913'],
    html[data-theme='light'] [class*='bg-[#0f131d'],
    html[data-theme='light'] [class*='bg-[#222'] {
        background-color: var(--site-surface-soft) !important;
    }

    html[data-theme='light'] .bg-gray-800 {
        background-color: rgba(226, 232, 240, 0.86) !important;
    }

    html[data-theme='light'] [class~='bg-blue-500/10'],
    html[data-theme='light'] [class~='bg-blue-600/10'] {
        background-color: rgba(37, 99, 235, 0.12) !important;
    }

    html[data-theme='light'] [class~='bg-cyan-500/10'],
    html[data-theme='light'] [class~='bg-cyan-600/10'] {
        background-color: rgba(8, 145, 178, 0.12) !important;
    }

    html[data-theme='light'] [class~='bg-slate-500/10'] {
        background-color: rgba(71, 85, 105, 0.12) !important;
    }

    html[data-theme='light'] [class*='border-gray-800'],
    html[data-theme='light'] [class*='border-gray-700'],
    html[data-theme='light'] [class*='border-slate-800'],
    html[data-theme='light'] [class*='border-slate-700'] {
        border-color: var(--site-border) !important;
    }

    html[data-theme='light'] [class*='divide-white/10'] > :not([hidden]) ~ :not([hidden]) {
        border-color: rgba(15, 23, 42, 0.08) !important;
    }

    html[data-theme='light'] .hover\:bg-gray-700:hover {
        background-color: rgba(203, 213, 225, 0.75) !important;
    }

    html[data-theme='light'] [class*='hover:bg-white']:hover {
        background-color: rgba(15, 23, 42, 0.05) !important;
    }
</style>
