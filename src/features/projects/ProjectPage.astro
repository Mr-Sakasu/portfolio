---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getUi, type Locale } from '../../i18n';
import type { Project } from '../../data/projects';
import erProjectImage from '../../assets/er.png';

interface Props {
  lang: Locale;
  project: Project;
}

const { lang, project } = Astro.props;
const t = getUi(lang);
---

<Layout title={`${project.title} | Sakasu Portfolio`} lang={lang} description={project.desc} wide>
  <article class="project-detail">
    <a href={`/${lang}/#work`} class="project-detail__back">← {t['projects.back']}</a>

    <header class="project-detail__intro">
      <p>{t['projects.overview']}</p>
      <h1>{project.title}</h1>
      <div class="project-detail__tags" aria-label={t['projects.tech']}>
        {project.tags.map((tag) => <span>{tag}</span>)}
      </div>
    </header>

    <div class="project-detail__grid">
      <section class="project-detail__media" aria-label={project.title}>
        {project.video ? (
          <video controls playsinline preload="metadata" poster={project.poster} class="project-detail__video">
            <source src={project.video} type="video/mp4" />
          </video>
        ) : project.image === '/er.png' ? (
          <Image
            src={erProjectImage}
            alt={project.title}
            format="webp"
            widths={[640, 960, 1280]}
            sizes="(max-width: 768px) 100vw, 66vw"
            quality={78}
            class="project-detail__image"
          />
        ) : (
          <img src={project.image} alt={project.title} loading="eager" decoding="async" class="project-detail__image" />
        )}
      </section>

      <aside class="project-detail__summary">
        <p>{project.desc}</p>
        <a href={project.link} target="_blank" rel="noopener noreferrer" class="project-detail__external">
          {t['projects.open']} <span aria-hidden="true">↗</span>
        </a>
      </aside>
    </div>
  </article>
</Layout>

<style>
  .project-detail {
    padding-block: clamp(2.5rem, 6vw, 4.75rem);
  }

  .project-detail__back {
    color: var(--site-muted);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .project-detail__back:hover {
    color: var(--site-text);
  }

  .project-detail__intro {
    margin-top: clamp(2.3rem, 6vw, 4.5rem);
    max-width: 48rem;
  }

  .project-detail__intro > p {
    color: #7dd3fc;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .project-detail h1 {
    margin-top: 0.7rem;
    color: var(--site-text);
    font-size: clamp(2.3rem, 6vw, 4.75rem);
    font-weight: 700;
    line-height: 0.98;
  }

  .project-detail__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.35rem;
  }

  .project-detail__tags span {
    border: 1px solid var(--site-card-border);
    border-radius: 999px;
    background: var(--site-chip-bg);
    padding: 0.32rem 0.6rem;
    color: var(--site-subtle);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .project-detail__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(16rem, 0.75fr);
    gap: 0;
    margin-top: clamp(2rem, 5vw, 3.5rem);
    overflow: hidden;
    border: 1px solid var(--site-card-border);
    border-radius: 1rem;
    background: var(--site-surface-strong);
    box-shadow: var(--site-card-shadow);
  }

  .project-detail__media {
    display: grid;
    min-height: 22rem;
    place-items: center;
    background: var(--site-surface-soft);
  }

  .project-detail__image,
  .project-detail__video {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 42rem;
    object-fit: cover;
  }

  .project-detail__summary {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.35rem, 3vw, 2.25rem);
    border-left: 1px solid var(--site-card-border);
  }

  .project-detail__summary > p {
    color: var(--site-subtle);
    font-size: 1rem;
    line-height: 1.8;
  }

  .project-detail__external {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.7rem;
    border: 1px solid #0284c7;
    border-radius: 0.45rem;
    background: #0369a1;
    padding-inline: 0.85rem;
    color: #fff;
    font-size: 0.86rem;
    font-weight: 650;
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  .project-detail__external:hover {
    background: #075985;
  }

  @media (max-width: 780px) {
    .project-detail__grid {
      grid-template-columns: 1fr;
    }

    .project-detail__media {
      min-height: 14rem;
      max-height: 28rem;
    }

    .project-detail__summary {
      border-top: 1px solid var(--site-card-border);
      border-left: 0;
    }
  }
</style>
