---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getUi, type Locale } from '../../i18n';
import Timeline from '../../components/shared/Timeline.astro';
import SkillStack from '../../components/shared/SkillStack.astro';
import Playlist from '../playlist/Playlist.astro';
import { projectData, projectSlugs } from '../../data/projects';
import profileImage from '../../assets/sakasu.jpg';
import erProjectImage from '../../assets/er.png';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getUi(lang);
const projects = projectData[lang] || projectData['en'];
const heroTitle = t['hero.title'];
---

<Layout title="Sakasu Portfolio" lang={lang} description={t['hero.subtitle']} wide>

    <section class="home-bento-section pt-5 md:pt-8">
        <div class="home-bento-grid">
            <section class="home-bento-card home-profile-card md:col-span-7" data-reveal>
                <div class="relative z-10 flex h-full flex-col justify-between gap-9 p-6 sm:p-8 md:p-9">
                    <div class="flex items-start justify-between gap-6">
                        <span class="home-eyebrow">Sakasu / Portfolio</span>
                        <span class="home-online-status">
                            <span aria-hidden="true"></span>
                            Tokyo, JP
                        </span>
                    </div>

                    <div class="home-profile-identity flex flex-col gap-6 sm:flex-row sm:items-end">
                        <span class="home-avatar-ring self-start shrink-0">
                            <Image
                                src={profileImage}
                                alt="Profile Picture"
                                format="webp"
                                sizes="(max-width: 768px) 104px, 136px"
                                widths={[104, 136, 208]}
                                quality={76}
                                loading="eager"
                                fetchpriority="high"
                                class="hero-avatar h-[104px] w-[104px] rounded-full border-4 object-cover md:h-[136px] md:w-[136px]"
                            />
                        </span>
                        <div class="min-w-0">
                            <h1 class="home-name font-extrabold leading-[0.96] text-white">
                                <span id="hero-typewriter" class="typewriter-title" data-text={heroTitle} aria-label={heroTitle}>
                                    <span class="typewriter-title__text" aria-hidden="true"></span>
                                </span>
                            </h1>
                            <p class="mt-4 max-w-xl text-sm leading-relaxed text-slate-300 sm:text-base md:text-lg">
                                {lang === 'ja' ? (
                                    <>
                                        修士2年 <strong class="font-bold text-white">数理最適化</strong>や<strong class="font-bold text-white">感情コンピューティング</strong>の研究をしています
                                    </>
                                ) : t['hero.subtitle']}
                            </p>
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center justify-between gap-4 border-t border-white/10 pt-5">
                        <div class="flex flex-wrap gap-2" aria-label="Focus areas">
                            <span class="home-tag">Optimization</span>
                            <span class="home-tag">Affective computing</span>
                            <span class="home-tag">Creative code</span>
                        </div>
                        <a href="https://github.com/Mr-Sakasu/" target="_blank" rel="noopener" class="home-text-link">
                            <svg aria-hidden="true" viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor">
                                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                            </svg>
                            GitHub <span aria-hidden="true">↗</span>
                        </a>
                    </div>
                </div>
                <svg class="home-card-figure home-profile-figure" viewBox="0 0 240 160" aria-hidden="true">
                    <path d="M22 136H222M35 148V18" />
                    <path d="M34 112C66 38 104 142 139 82S190 44 220 30" />
                    <circle cx="74" cy="79" r="4" />
                    <circle cx="139" cy="82" r="4" />
                    <circle cx="194" cy="42" r="4" />
                </svg>
            </section>

            <a href={`/${lang}/stars/`} class="home-bento-card home-stars-card group md:col-span-5" data-reveal style="--reveal-delay: 80ms;">
                <iframe
                    src={`/${lang}/stars/?preview=1`}
                    title={`${t['stars.title']} preview`}
                    loading="lazy"
                    tabindex="-1"
                    class="pointer-events-none absolute inset-0 h-full w-full opacity-85"
                ></iframe>
                <div class="home-stars-card__shade" aria-hidden="true"></div>
                <div class="relative z-10 flex h-full min-h-[280px] flex-col justify-between p-6 sm:p-7">
                    <div class="flex items-start justify-between gap-4">
                        <span class="home-eyebrow home-eyebrow--sky">{t['stars.sky.time']}</span>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-sky-100/85">{t['stars.subtitle']}</p>
                        <h2 class="mt-2 text-3xl font-black leading-none text-white sm:text-4xl">{t['stars.title']}</h2>
                        <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-sky-100 transition-transform duration-300 group-hover:translate-x-1">
                            {t['home.minigame.play']} <span aria-hidden="true">→</span>
                        </span>
                    </div>
                </div>
            </a>

            <a href={`/${lang}/playlist/`} class="home-bento-card home-playlist-card group md:col-span-4" data-reveal style="--reveal-delay: 130ms;">
                <svg class="home-card-figure home-playlist-figure" viewBox="0 0 180 120" aria-hidden="true">
                    <circle cx="132" cy="62" r="39" />
                    <circle cx="132" cy="62" r="7" />
                    <path d="M16 70V56M27 78V48M38 66V60M49 84V42M60 74V52M71 80V46" />
                </svg>
                <div class="relative z-10 flex h-full min-h-[220px] flex-col justify-between p-6">
                    <div class="flex items-start justify-between gap-4">
                        <span class="home-eyebrow home-eyebrow--violet">{t['playlist.eyebrow']}</span>
                    </div>
                    <div>
                        <p class="max-w-[15rem] text-sm leading-relaxed text-violet-100/80">{t['playlist.subtitle']}</p>
                        <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-violet-100 transition-transform duration-300 group-hover:translate-x-1">
                            {t['playlist.open']} <span aria-hidden="true">→</span>
                        </span>
                    </div>
                </div>
            </a>

            <a href={`/${lang}/scenes/`} class="home-bento-card home-scenes-card group md:col-span-3" data-reveal style="--reveal-delay: 170ms;">
                <svg class="home-card-figure home-scenes-figure" viewBox="0 0 180 120" aria-hidden="true">
                    <circle cx="139" cy="27" r="12" />
                    <path d="M4 102L54 48L83 77L111 43L176 102" />
                    <path d="M4 102H176M25 91L54 61L69 77" />
                </svg>
                <div class="relative z-10 flex h-full min-h-[220px] flex-col justify-between p-6">
                    <div class="flex items-start justify-between gap-4">
                        <span class="home-eyebrow home-eyebrow--violet">{t['nav.scenes']}</span>
                    </div>
                    <div>
                        <h2 class="max-w-[12rem] text-2xl font-black leading-tight text-white">{t['scenes.page.title']}</h2>
                        <span class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-emerald-100 transition-transform duration-300 group-hover:translate-x-1">
                            {t['home.minigame.play']} <span aria-hidden="true">→</span>
                        </span>
                    </div>
                </div>
            </a>

            <a href={`/${lang}/bandit/`} class="home-bento-card home-bandit-card group md:col-span-5" data-reveal style="--reveal-delay: 210ms;">
                <svg class="home-card-figure home-bandit-figure" viewBox="0 0 220 130" aria-hidden="true">
                    <circle cx="110" cy="24" r="7" />
                    <path d="M110 31V48M110 48L35 89M110 48L84 89M110 48L136 89M110 48L185 89" />
                    <circle cx="35" cy="96" r="9" />
                    <circle cx="84" cy="96" r="9" />
                    <circle cx="136" cy="96" r="9" />
                    <circle cx="185" cy="96" r="9" />
                </svg>
                <div class="relative z-10 flex h-full min-h-[220px] flex-col justify-between p-6 sm:p-7">
                    <div class="flex items-start justify-between gap-4">
                        <span class="home-eyebrow home-eyebrow--cyan">{t['home.minigame.title']}</span>
                    </div>
                    <div class="max-w-md">
                        <h2 class="text-2xl font-black leading-tight text-white sm:text-3xl">{t['bandit.title']}</h2>
                        <p class="mt-2 text-sm leading-relaxed text-cyan-50/75">{t['bandit.subtitle']}</p>
                        <span class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-cyan-100 transition-transform duration-300 group-hover:translate-x-1">
                            {t['home.minigame.play']} <span aria-hidden="true">→</span>
                        </span>
                    </div>
                </div>
            </a>

            <a href={`/${lang}/hanoi/`} class="home-bento-card home-hanoi-card group md:col-span-12" data-reveal style="--reveal-delay: 250ms;">
                <div class="relative flex min-h-[220px] overflow-hidden p-6 sm:p-7 md:items-center md:p-8">
                    <div class="relative z-10 max-w-xl">
                        <div class="flex items-start justify-between gap-4">
                            <span class="home-eyebrow home-eyebrow--violet">{t['hanoi.eyebrow']}</span>
                        </div>
                        <h2 class="mt-7 text-3xl font-black leading-none text-white sm:text-4xl">{t['hanoi.title']}</h2>
                        <p class="mt-3 text-sm leading-relaxed text-violet-100/80">{t['hanoi.subtitle']}</p>
                        <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-violet-100 transition-transform duration-300 group-hover:translate-x-1">
                            {t['home.minigame.play']} <span aria-hidden="true">→</span>
                        </span>
                    </div>

                    <div class="home-hanoi-preview" aria-hidden="true">
                        <span class="home-hanoi-preview__tower">
                            <span class="home-hanoi-preview__rod"></span>
                            <span class="home-hanoi-preview__disk home-hanoi-preview__disk--large"></span>
                            <span class="home-hanoi-preview__disk home-hanoi-preview__disk--medium"></span>
                            <span class="home-hanoi-preview__disk home-hanoi-preview__disk--small"></span>
                            <span class="home-hanoi-preview__base"></span>
                        </span>
                        <span class="home-hanoi-preview__tower">
                            <span class="home-hanoi-preview__rod"></span>
                            <span class="home-hanoi-preview__disk home-hanoi-preview__disk--medium"></span>
                            <span class="home-hanoi-preview__disk home-hanoi-preview__disk--small"></span>
                            <span class="home-hanoi-preview__base"></span>
                        </span>
                        <span class="home-hanoi-preview__tower">
                            <span class="home-hanoi-preview__rod"></span>
                            <span class="home-hanoi-preview__disk home-hanoi-preview__disk--large"></span>
                            <span class="home-hanoi-preview__base"></span>
                        </span>
                    </div>
                </div>
            </a>
        </div>
    </section>

    <section id="work" class="home-projects-section">
        <div class="home-section-heading" data-reveal>
            <div>
                <span class="home-eyebrow">Selected work</span>
                <h2>{t['nav.work']}</h2>
            </div>
            <span>{projects.length} projects</span>
        </div>

        <div class="home-project-grid">
            {projects.map((project, projectIndex) => (
                <a
                    href={`/${lang}/projects/${projectSlugs[projectIndex]}/`}
                    class={`home-project-card group ${projectIndex === 0 ? 'home-project-card--feature md:col-span-7' : projectIndex === 1 ? 'md:col-span-5' : 'md:col-span-4'}`}
                    data-reveal
                    style={`--reveal-delay: ${(projectIndex % 3) * 80}ms;`}
                >
                    <div class="home-project-card__media">
                        {project.video ? (
                            <>
                                <video
                                    muted
                                    loop
                                    playsinline
                                    preload="none"
                                    poster={project.poster}
                                    data-src={project.video}
                                    data-project-video
                                    aria-label={`${project.title} demo video`}
                                    class="h-full w-full object-cover"
                                ></video>
                                <span class="home-project-card__demo">
                                    <span aria-hidden="true"></span> Demo
                                </span>
                            </>
                        ) : project.image === '/er.png' ? (
                            <Image
                                src={erProjectImage}
                                alt={project.title}
                                format="webp"
                                sizes="(max-width: 768px) 100vw, 740px"
                                widths={[320, 560, 840]}
                                quality={70}
                                loading="lazy"
                                class="h-full w-full object-cover"
                            />
                        ) : (
                            <img
                                src={project.image}
                                alt={project.title}
                                loading="lazy"
                                decoding="async"
                                class="h-full w-full object-cover"
                            />
                        )}
                    </div>
                    <div class="home-project-card__body">
                        <div class="flex items-start justify-between gap-4">
                            <h3>{project.title}</h3>
                        </div>
                        <p>{project.desc}</p>
                        <div class="mt-5 flex flex-wrap gap-1.5">
                            {project.tags.map((tag) => (
                                <span class="home-tag">{tag}</span>
                            ))}
                        </div>
                    </div>
                </a>
            ))}
        </div>
    </section>

    <div class="home-playlist-module">
        <Playlist lang={lang} />
    </div>

    <div class="home-skills-module">
        <SkillStack lang={lang} />
    </div>

    <section class="home-timeline-section mt-16 md:mt-24 mb-24">
        <div class="mb-8" data-reveal>
            <h2 class="text-2xl md:text-3xl font-bold text-white">{t['timeline.title']}</h2>
            <span class="section-rule bg-gradient-to-r from-slate-400 to-blue-500" aria-hidden="true"></span>
        </div>
        <Timeline lang={lang} />
    </section>

    {/* Open sky: an empty stretch before the footer where nothing sits on top
        of the background, so the fireworks can be watched on their own. */}
    <div class="h-[70vh] min-h-72" aria-hidden="true"></div>

</Layout>

<script>
    import { initHomePage } from './home-client.js';

    initHomePage();
</script>

<style>
    .home-bento-section {
        position: relative;
    }

    .home-bento-grid,
    .home-project-grid {
        display: grid;
        grid-template-columns: repeat(1, minmax(0, 1fr));
        gap: 0.75rem;
    }

    .home-bento-card,
    .home-project-card {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        border: 1px solid var(--site-card-border);
        border-radius: 0.25rem;
        background: var(--site-card-bg);
        box-shadow: none;
        transition: border-color 160ms ease;
    }

    a.home-bento-card,
    a.home-project-card {
        display: block;
        color: inherit;
        text-decoration: none;
    }

    a.home-bento-card:hover,
    a.home-project-card:hover {
        border-color: var(--site-card-border-hover);
    }

    .home-profile-card {
        min-height: 380px;
        container-type: inline-size;
        border-left: 3px solid #60a5fa;
        background: var(--site-card-bg);
    }

    .home-name {
        max-width: 100%;
        font-size: clamp(1.85rem, 5vw, 3.35rem);
        letter-spacing: -0.045em;
    }

    @supports (font-size: 1cqw) {
        .home-name {
            font-size: clamp(1.85rem, 7cqw, 3.35rem);
        }
    }

    @container (max-width: 32rem) {
        .home-profile-identity {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    .home-card-figure {
        position: absolute;
        z-index: 0;
        display: block;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        pointer-events: none;
    }

    .home-profile-figure {
        right: -1rem;
        bottom: 4.5rem;
        width: min(42%, 18rem);
        color: #60a5fa;
        opacity: 0.16;
    }

    .home-playlist-figure {
        top: 2.2rem;
        right: 0.8rem;
        width: 52%;
        color: #a78bfa;
        opacity: 0.3;
    }

    .home-scenes-figure {
        right: -0.8rem;
        bottom: 1.1rem;
        width: 72%;
        color: #6ee7b7;
        opacity: 0.23;
    }

    .home-bandit-figure {
        top: 1rem;
        right: 0.8rem;
        width: 45%;
        color: #38bdf8;
        opacity: 0.27;
    }

    .home-profile-card::after {
        position: absolute;
        top: 1.5rem;
        right: 1.5rem;
        width: 3.5rem;
        height: 1px;
        background: #6ee7b7;
        content: '';
    }

    .home-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: rgba(191, 219, 254, 0.8);
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        line-height: 1;
        text-transform: uppercase;
    }

    .home-eyebrow::before {
        width: 1.3rem;
        height: 1px;
        border-radius: 0;
        background: currentColor;
        content: '';
    }

    .home-eyebrow--sky { color: #bae6fd; }
    .home-eyebrow--violet { color: #ddd6fe; }
    .home-eyebrow--cyan { color: #a5f3fc; }

    .home-online-status {
        display: inline-flex;
        flex-shrink: 0;
        align-items: center;
        gap: 0.45rem;
        color: rgba(203, 213, 225, 0.7);
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .home-online-status > span {
        width: 0.42rem;
        height: 0.42rem;
        border-radius: 50%;
        background: #5eead4;
        box-shadow: none;
    }

    .home-avatar-ring {
        display: inline-flex;
        padding: 2px;
        border-radius: 50%;
        background: #60a5fa;
        box-shadow: none;
    }

    .home-tag {
        display: inline-flex;
        align-items: center;
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 0.2rem;
        background: transparent;
        padding: 0.3rem 0.5rem;
        color: rgba(226, 232, 240, 0.8);
        font-size: 0.65rem;
        font-weight: 650;
        line-height: 1;
    }

    .home-text-link {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        color: #bfdbfe;
        font-size: 0.76rem;
        font-weight: 650;
        transition: color 180ms ease, transform 180ms ease;
    }

    .home-text-link:hover {
        color: #fff;
        transform: translateX(2px);
    }

    .home-stars-card {
        min-height: 380px;
        background: #080d19;
        border-left: 3px solid #60a5fa;
    }

    .home-stars-card iframe {
        z-index: -3;
    }

    .home-stars-card__shade {
        position: absolute;
        inset: 0;
        z-index: -2;
        background: rgba(4, 10, 26, 0.58);
    }

    .home-playlist-card {
        min-height: 220px;
        border-left: 3px solid #a78bfa;
        background: var(--site-card-bg);
    }

    .home-scenes-card {
        min-height: 220px;
        border-left: 3px solid #6ee7b7;
        background: var(--site-card-bg);
    }

    .home-bandit-card {
        min-height: 220px;
        border-left: 3px solid #38bdf8;
        background: var(--site-card-bg);
    }

    .home-hanoi-card {
        min-height: 220px;
        border-left: 3px solid #a78bfa;
        background: var(--site-card-bg);
    }

    .home-hanoi-preview {
        position: absolute;
        right: 11%;
        bottom: 1.2rem;
        display: flex;
        width: min(38%, 30rem);
        height: 11.25rem;
        align-items: end;
        justify-content: space-between;
        opacity: 0.92;
    }

    .home-hanoi-preview__tower {
        position: relative;
        display: block;
        width: 30%;
        height: 100%;
    }

    .home-hanoi-preview__rod {
        position: absolute;
        bottom: 0.7rem;
        left: 50%;
        width: 0.42rem;
        height: 76%;
        border-radius: 999px 999px 0 0;
        background: #94a3b8;
        transform: translateX(-50%);
    }

    .home-hanoi-preview__base {
        position: absolute;
        right: 0;
        bottom: 0.42rem;
        left: 0;
        height: 0.45rem;
        border-radius: 999px;
        background: #64748b;
    }

    .home-hanoi-preview__disk {
        position: absolute;
        left: 50%;
        height: 1.15rem;
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 999px;
        background: #8b5cf6;
        box-shadow: none;
        transform: translateX(-50%);
    }

    .home-hanoi-preview__disk--large {
        bottom: 0.86rem;
        width: 100%;
    }

    .home-hanoi-preview__disk--medium {
        bottom: 2rem;
        width: 75%;
        background: #3b82f6;
    }

    .home-hanoi-preview__disk--small {
        bottom: 3.14rem;
        width: 50%;
        background: #10b981;
    }

    .home-playlist-module {
        margin-top: 4.5rem;
        border-top: 1px solid var(--site-card-border);
        padding-top: 1.2rem;
    }

    .home-projects-section {
        margin-top: 5.5rem;
        border-top: 1px solid var(--site-card-border);
        padding-top: 1.2rem;
        scroll-margin-top: 6.5rem;
    }

    .home-section-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    .home-section-heading h2 {
        margin-top: 0.7rem;
        color: var(--site-text);
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 600;
        letter-spacing: -0.055em;
        line-height: 0.95;
    }

    .home-section-heading > span {
        padding-bottom: 0.2rem;
        color: var(--site-muted);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

