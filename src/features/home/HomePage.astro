---
import Layout from '../../layouts/Layout.astro';
import { siteAppearance } from '../../config/appearance';
import { getUi, type Locale } from '../../i18n';
import HomeBento from './HomeBento.astro';
import HomeJournal from './HomeJournal.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = getUi(lang);
const layouts = { journal: HomeJournal, bento: HomeBento };
const Home = layouts[siteAppearance.homeLayout];
---
<Layout title="Sakasu Portfolio" lang={lang} description={t['hero.subtitle']} wide>
  <Home lang={lang} />
</Layout>
