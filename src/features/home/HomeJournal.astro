---
import { Image } from 'astro:assets';
import { getUi, type Locale } from '../../i18n';
import HeroName from './HeroName.astro';
import Timeline from '../../components/shared/Timeline.astro';
import JournalSkills from './JournalSkills.astro';
import { projectData, projectSlugs } from '../../data/projects';
import { selectPlaylists, sortTracks, trackArtist } from '../playlist/select';
import profileImage from '../../assets/sakasu.jpg';
import erProjectImage from '../../assets/er.png';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = getUi(lang);
const projects = projectData[lang];
const playlist = selectPlaylists(lang, 'home')[0];
const tracks = sortTracks(playlist?.tracks).slice(0, 3);
const experiments = [
  { href: 'stars', title: t['stars.title'], mark: '01' },
  { href: 'bandit', title: t['bandit.title'], mark: '02' },
  { href: 'hanoi', title: t['hanoi.title'], mark: '03' },
];
---
<div class="journal" data-home-layout="journal">
  <section class="journal-hero" aria-labelledby="journal-name">
    <div class="journal-hero__text">
      <h1 id="journal-name"><HeroName name={t['hero.title']} /></h1>
      <p class="journal-hero__bio">{t['hero.subtitle']}</p>
      <div class="journal-hero__links">
        <span>{t['home.location']}</span><span aria-hidden="true">/</span>
        <a href="https://github.com/Mr-Sakasu/" target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <aside class="journal-profile" aria-label={t['home.profile.alt']}>
      <Image src={profileImage} alt={t['home.profile.alt']} width={120} height={120} format="webp" loading="eager" fetchpriority="high" class="journal-avatar" />
      <div class="journal-schools">
        <img src="/logos/schools/tuat-brand.png" alt="Tokyo University of Agriculture and Technology" width="32" height="32" />
        <img src="/logos/schools/science-tokyo.svg" alt="Institute of Science Tokyo" width="32" height="32" />
        <img src="/logos/schools/tsinghua.webp" alt="Tsinghua University" width="32" height="32" />
      </div>
      <p>{t['home.focus.optimization']}<br />{t['home.focus.affective']}</p>
    </aside>
  </section>

  <figure class="journal-landscape">
    <a href={`/${lang}/scenes/`} class="journal-landscape__view" aria-label={t['scenes.page.title']}>
      <iframe data-src={`/${lang}/scenes/?preview=1&scene=fuji`} data-home-preview title={t['scenes.page.title']} loading="lazy" tabindex="-1"></iframe>
    </a>
    <figcaption>
      <a href={`/${lang}/scenes/`}>{t['nav.scenes']} <span aria-hidden="true">↗</span></a>
    </figcaption>
  </figure>

  <section id="work" class="journal-section" aria-labelledby="journal-work-title">
    <div class="journal-section-heading">
      <h2 id="journal-work-title">{t['nav.work']}</h2>
      <span class="journal-count">{String(projects.length).padStart(2, '0')}</span>
    </div>
    <div class="journal-projects">
      {projects.map((project, index) => (
        <a href={`/${lang}/projects/${projectSlugs[index]}/`} class="journal-project">
          <span class="journal-project__number">{String(index + 1).padStart(2, '0')}</span>
          <div class="journal-project__body">
            <h3>{project.title} <span class="journal-project__arrow" aria-hidden="true">↗</span></h3>
            <p>{project.desc}</p>
            <ul class="journal-tags" aria-label={t['home.focus.label']}>
              {project.tags.map(tag => <li>{tag}</li>)}
            </ul>
          </div>
          <div class="journal-project__media">
            {project.video ? (
              <video muted loop playsinline preload="none" poster={project.poster} data-src={project.video} data-project-video aria-label={`${project.title} demo`}></video>
            ) : project.image === '/er.png' ? (
              <Image src={erProjectImage} alt={project.title} format="webp" widths={[280, 480]} sizes="(max-width: 640px) 50vw, 240px" loading="lazy" />
            ) : <img src={project.image} alt={project.title} loading="lazy" decoding="async" />}
          </div>
        </a>
      ))}
    </div>
  </section>

  <div class="journal-section journal-detours">
      <section class="journal-music" data-playlist-card aria-labelledby="journal-music-title">
        <div class="journal-section-heading"><h2 id="journal-music-title">{t['nav.playlist']}</h2></div>
        <ol class="journal-tracks">
          {tracks.map(track => (
            <li>
              {track.videoId && <button type="button" class="journal-play" data-play-button data-video-id={track.videoId} data-playlist-id={playlist?.playlistId} data-track-title={track.title} aria-label={`${t['playlist.eyebrow']}: ${track.title}`} aria-pressed="false">
                <svg class="journal-play__start" viewBox="0 0 20 20" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M6 3 L17 10 L6 17 Z" /></svg>
                <svg class="journal-play__pause" viewBox="0 0 20 20" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M5 3 H8 V17 H5 Z M12 3 H15 V17 H12 Z" /></svg>
              </button>}
              <div class="journal-track-name"><span>{track.title}</span><small>{trackArtist(track)}</small></div>
            </li>
          ))}
        </ol>
        <div class="journal-player hidden" data-playlist-player>
          <p data-player-title></p>
          <div data-player-mount></div>
        </div>
        <a class="journal-more" href={`/${lang}/playlist/`}>{t['playlist.viewAll']} <span aria-hidden="true">↗</span></a>
      </section>
      <section class="journal-experiments" aria-labelledby="journal-experiments-title">
        <div class="journal-section-heading"><h2 id="journal-experiments-title">{t['nav.playground']}</h2></div>
        <div class="journal-experiment-list">
          {experiments.map(experiment => (
            <a href={`/${lang}/${experiment.href}/`}>
              <span class="journal-index">{experiment.mark}</span>
              <h3>{experiment.title}</h3>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>
  </div>

  <section class="journal-section" aria-labelledby="journal-skills-title">
    <div class="journal-section-heading">
      <h2 id="journal-skills-title">{t['skills.title']}</h2>
    </div>
    <JournalSkills lang={lang} />
  </section>

  <section id="timeline" class="journal-section journal-history" aria-labelledby="journal-history-title">
    <div class="journal-section-heading">
      <h2 id="journal-history-title">{t['timeline.title']}</h2>
    </div>
    <Timeline lang={lang} variant="journal" />
  </section>
  <div class="journal-ending" aria-hidden="true"><span>❧</span></div>
</div>

<script>
  import { initHomePage } from './home-client.js';
  import { initPlaylistPlayer } from '../playlist/playlist-player';
  initHomePage();
  initPlaylistPlayer();
</script>

<style>
  .journal { max-width: 1024px; margin: 0 auto; }
  .journal a { transition: color 180ms ease; }
  .journal a:hover { color: var(--site-accent); }
  .journal-hero { display: grid; grid-template-columns: minmax(0, 1fr) 180px; align-items: center; gap: 3rem; padding: 3.8rem 0 4rem; }
  .journal-hero h1 { margin: 1.1rem 0 1.6rem; font-family: Georgia, 'Times New Roman', serif; font-weight: 400; font-size: clamp(3.2rem, 6.6vw, 5.7rem); letter-spacing: -0.055em; line-height: 1.05; }
  .journal-hero__bio { max-width: 33rem; font-size: 0.95rem; color: var(--site-subtle); line-height: 2; text-wrap: pretty; }
  .journal-hero__links { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1.5rem; font-size: 0.73rem; color: var(--site-muted); }
  .journal-hero__links a { color: var(--site-accent); }
  .journal-profile { text-align: center; align-self: center; }
  .journal-avatar { width: 108px; height: 108px; margin: 0 auto; border-radius: 50%; object-fit: cover; padding: 5px; border: 1px solid var(--site-card-border-hover); }
  .journal-schools { display: flex; justify-content: center; align-items: center; gap: 0.65rem; margin: 1.3rem 0 0.8rem; }
  .journal-schools img { width: 28px; height: 28px; object-fit: contain; padding: 2px; background: #f7f5ed; border-radius: 50%; }
  .journal-profile p { font-size: 0.67rem; color: var(--site-muted); line-height: 1.9; }
  .journal-landscape { margin: 0; }
  .journal-landscape__view { display: block; position: relative; height: clamp(210px, 26vw, 300px); overflow: hidden; background: var(--site-surface-soft); }
  .journal-landscape iframe { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; border: 0; }
  .journal-landscape figcaption { display: flex; justify-content: flex-end; padding: 1rem 0; color: var(--site-muted); font-size: 0.7rem; }
  .journal-index { color: var(--site-accent); font-size: 0.65rem; font-variant-numeric: tabular-nums; letter-spacing: 0.08em; margin-right: 0.6rem; }
  .journal-section { margin-top: clamp(4.5rem, 8vw, 7rem); scroll-margin-top: 9rem; }
  .journal-section-heading { position: relative; padding-bottom: 1.7rem; border-bottom: 1px solid var(--site-card-border-hover); }
  .journal-section-heading h2 { font-weight: 500; font-size: 1.1rem; letter-spacing: 0.02em; line-height: 1.4; }
  .journal-count { position: absolute; right: 0; bottom: 1.9rem; font-size: 0.65rem; color: var(--site-muted); }
  .journal-project { display: grid; grid-template-columns: 2rem minmax(0, 1fr) 230px; gap: 1.5rem; padding: 2rem 0; border-bottom: 1px solid var(--site-card-border); color: var(--site-text); align-items: center; }
  .journal-project__number { align-self: start; padding-top: 0.2rem; font-size: 0.7rem; color: var(--site-accent); font-variant-numeric: tabular-nums; }
  .journal-project h3 { font-size: clamp(1.05rem, 2vw, 1.35rem); font-weight: 500; line-height: 1.5; }
  .journal-project__arrow { color: var(--site-accent); font-size: 0.85rem; display: inline-block; margin-left: 0.5rem; }
  .journal-project__body > p { font-size: 0.82rem; line-height: 1.9; color: var(--site-muted); margin-top: 0.7rem; max-width: 37rem; }
  .journal-tags { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; margin-top: 1rem; font-size: 0.62rem; color: var(--site-subtle); }
  .journal-tags li + li::before { content: '·'; margin-right: 0.8rem; color: var(--site-accent); }
  .journal-project__media { aspect-ratio: 16 / 10; overflow: hidden; background: var(--site-surface-soft); }
  .journal-project__media img, .journal-project__media video { width: 100%; height: 100%; object-fit: cover; transition: transform 280ms ease; }
  .journal-project:hover .journal-project__media :is(img, video) { transform: scale(1.025); }
  .journal-detours { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 5rem; }
  .journal-tracks { margin-top: 1.4rem; }
  .journal-tracks li { display: flex; align-items: center; gap: 0.9rem; padding: 1rem 0; border-bottom: 1px solid var(--site-card-border); }
  .journal-play { flex-shrink: 0; display: grid; place-items: center; width: 32px; height: 32px; border: 1px solid var(--site-card-border-hover); border-radius: 50%; color: var(--site-accent); background: transparent; }
  .journal-play:hover { background: var(--site-chip-bg); }
  .journal-play__pause, .journal-play[aria-pressed='true'] .journal-play__start { display: none; }
  .journal-play[aria-pressed='true'] .journal-play__pause { display: block; }
  .journal-track-name { min-width: 0; }
  .journal-track-name > span { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 0.8rem; }
  .journal-track-name small { display: block; margin-top: 0.2rem; font-size: 0.65rem; color: var(--site-muted); }
  .journal-player { margin-top: 1rem; }
  .journal-player p { margin-bottom: 0.5rem; font-size: 0.75rem; }
  .journal-player :global(iframe) { width: 100%; aspect-ratio: 16 / 9; height: auto; }
  .journal-more { display: inline-block; margin-top: 1.4rem; font-size: 0.75rem; color: var(--site-accent); }
  .journal-experiment-list { margin-top: 1.2rem; }
  .journal-experiment-list a { display: grid; grid-template-columns: 1.3rem minmax(0, 1fr) 1rem; gap: 0.8rem; padding: 1.2rem 0; border-bottom: 1px solid var(--site-card-border); }
  .journal-experiment-list h3 { font-size: 0.9rem; font-weight: 500; }
  .journal-experiment-list a > span:last-child { color: var(--site-accent); }
  .journal-ending { height: 200px; display: grid; place-items: center; color: var(--site-accent); font-size: 2rem; opacity: 0.65; }
  @media (max-width: 767px) {
    .journal-hero { gap: 1.5rem; grid-template-columns: minmax(0, 1fr) 110px; padding: 2.8rem 0 3rem; }
    .journal-hero h1 { font-size: clamp(2.8rem, 9vw, 4.4rem); }
    .journal-hero__bio { font-size: 0.84rem; }
    .journal-avatar { width: 86px; height: 86px; }
    .journal-project { grid-template-columns: 1.2rem minmax(0, 1fr) 170px; gap: 1rem; }
    .journal-detours { gap: 2rem; }
  }
  @media (max-width: 560px) {
    .journal-hero { grid-template-columns: minmax(0, 1fr); gap: 1.8rem; }
    .journal-profile { display: flex; align-items: center; gap: 1rem; text-align: left; }
    .journal-avatar { width: 60px; height: 60px; margin: 0; padding: 3px; }
    .journal-schools { margin: 0; gap: 0.4rem; }
    .journal-schools img { width: 25px; height: 25px; }
    .journal-profile p { font-size: 0.59rem; }
    .journal-hero h1 { font-size: 3.5rem; }
    .journal-landscape figcaption { font-size: 0.62rem; }
    .journal-project { grid-template-columns: 1rem minmax(0, 1fr); gap: 0.8rem; padding: 1.6rem 0; }
    .journal-project__media { grid-column: 2; width: 160px; margin-top: 0.5rem; }
    .journal-count { position: static; display: block; margin-top: 0.7rem; }
    .journal-detours { grid-template-columns: minmax(0, 1fr); gap: 3rem; }
  }
  @media (prefers-reduced-motion: reduce) { .journal-project:hover .journal-project__media :is(img, video) { transform: none; } }
</style>
