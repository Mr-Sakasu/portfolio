---
import Layout from '../../layouts/Layout.astro';
import { getUi, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getUi(lang);
const labels = {
  ready: t['hanoi.status.ready'],
  selected: t['hanoi.status.selected'],
  empty: t['hanoi.status.empty'],
  invalid: t['hanoi.status.invalid'],
  moved: t['hanoi.status.moved'],
  undo: t['hanoi.status.undo'],
  won: t['hanoi.status.won'],
  towerA: t['hanoi.towerA'],
  towerB: t['hanoi.towerB'],
  towerC: t['hanoi.towerC'],
};
const towers = [t['hanoi.towerA'], t['hanoi.towerB'], t['hanoi.towerC']];
---

<Layout title={`${t['hanoi.title']} | Sakasu Portfolio`} lang={lang} description={t['hanoi.subtitle']}>
  <section class="hanoi-page">
    <header class="hanoi-intro">
      <p class="hanoi-eyebrow">{t['hanoi.eyebrow']}</p>
      <h1>{t['hanoi.title']}</h1>
      <p class="hanoi-intro__summary">{t['hanoi.subtitle']}</p>
      <p class="hanoi-intro__instruction">{t['hanoi.instructions']}</p>
    </header>

    <section class="hanoi-game" aria-label={t['hanoi.title']}>
      <div class="hanoi-toolbar">
        <div class="hanoi-toolbar__controls">
          <label class="hanoi-field" for="hanoi-disk-count">
            <span>{t['hanoi.disks']}</span>
            <select id="hanoi-disk-count" class="hanoi-select">
              <option value="3">3</option>
              <option value="4" selected>4</option>
              <option value="5">5</option>
            </select>
          </label>
          <button id="hanoi-new-game" type="button" class="hanoi-action hanoi-action--primary">
            {t['hanoi.newGame']}
          </button>
          <button id="hanoi-undo" type="button" class="hanoi-action" disabled>
            {t['hanoi.undo']}
          </button>
        </div>

        <div class="hanoi-metrics" aria-label={t['hanoi.progress']}>
          <div class="hanoi-metric">
            <span>{t['hanoi.moves']}</span>
            <strong id="hanoi-moves">0</strong>
          </div>
          <div class="hanoi-metric">
            <span>{t['hanoi.minimum']}</span>
            <strong id="hanoi-minimum">15</strong>
          </div>
          <div class="hanoi-metric hanoi-metric--status">
            <span>{t['hanoi.progress']}</span>
            <strong id="hanoi-progress">0 / 4</strong>
          </div>
        </div>
      </div>

      <p id="hanoi-status" class="hanoi-status" role="status" aria-live="polite">
        {t['hanoi.status.ready']}
      </p>

      <div id="hanoi-board" class="hanoi-board" role="group" aria-label={t['hanoi.title']}>
        {towers.map((tower, index) => (
          <button type="button" class="hanoi-tower" data-hanoi-tower={index} aria-pressed="false" aria-label={tower}>
            <span class="hanoi-tower__name">{tower}</span>
            <span class="hanoi-tower__playfield" aria-hidden="true">
              <span class="hanoi-tower__rod"></span>
              <span class="hanoi-tower__disks" data-hanoi-disks={index}></span>
              <span class="hanoi-tower__base"></span>
            </span>
          </button>
        ))}
      </div>

      <p class="hanoi-note">
        {t['hanoi.minimum']}: 2<sup>n</sup> − 1
      </p>
    </section>
  </section>
</Layout>

<script define:vars={{ labels }}>
  const towerButtons = Array.from(document.querySelectorAll('[data-hanoi-tower]'));
  const diskContainers = Array.from(document.querySelectorAll('[data-hanoi-disks]'));
  const board = document.querySelector('#hanoi-board');
  const diskCountInput = document.querySelector('#hanoi-disk-count');
  const newGameButton = document.querySelector('#hanoi-new-game');
  const undoButton = document.querySelector('#hanoi-undo');
  const movesElement = document.querySelector('#hanoi-moves');
  const minimumElement = document.querySelector('#hanoi-minimum');
  const progressElement = document.querySelector('#hanoi-progress');
  const statusElement = document.querySelector('#hanoi-status');
  const towerNames = [labels.towerA, labels.towerB, labels.towerC];

  let diskCount = 4;
  let stacks = [];
  let selectedTower = null;
  let moves = 0;
  let history = [];

  function topDisk(towerIndex) {
    const stack = stacks[towerIndex];
    return stack[stack.length - 1];
  }

  function solved() {
    return stacks[2].length === diskCount;
  }

  function setStatus(message, tone = 'default') {
    statusElement.textContent = message;
    statusElement.dataset.tone = tone;
  }

  function render() {
    diskContainers.forEach((container, towerIndex) => {
      container.replaceChildren();

      stacks[towerIndex].forEach((disk) => {
        const element = document.createElement('span');
        const width = 38 + ((disk - 1) / Math.max(diskCount - 1, 1)) * 54;
        const hue = 16 + (disk - 1) * 10;

        element.className = 'hanoi-disk';
        element.style.setProperty('--disk-width', `${width}%`);
        element.style.setProperty('--disk-color-start', `hsl(${hue} 88% 69%)`);
        element.style.setProperty('--disk-color-end', `hsl(${hue + 16} 73% 48%)`);
        element.setAttribute('aria-hidden', 'true');
        container.append(element);
      });
    });

    towerButtons.forEach((button, index) => {
      const isSelected = selectedTower === index;
      button.classList.toggle('is-selected', isSelected);
      button.classList.toggle('is-solved', solved() && index === 2);
      button.setAttribute('aria-pressed', String(isSelected));
      button.disabled = solved();
    });

    movesElement.textContent = String(moves);
    minimumElement.textContent = String(2 ** diskCount - 1);
    progressElement.textContent = `${stacks[2].length} / ${diskCount}`;
    undoButton.disabled = history.length === 0;
    board.classList.toggle('is-solved', solved());
  }

  function startGame(nextDiskCount) {
    diskCount = nextDiskCount;
    stacks = [Array.from({ length: diskCount }, (_, index) => diskCount - index), [], []];
    selectedTower = null;
    moves = 0;
    history = [];
    setStatus(labels.ready);
    render();
  }

  function chooseTower(destination) {
    if (solved()) return;

    if (selectedTower === null) {
      if (!topDisk(destination)) {
        setStatus(labels.empty, 'warning');
        return;
      }

      selectedTower = destination;
      setStatus(labels.selected);
      render();
      return;
    }

    if (selectedTower === destination) {
      selectedTower = null;
      setStatus(labels.ready);
      render();
      return;
    }

    const movingDisk = topDisk(selectedTower);
    const destinationDisk = topDisk(destination);
    if (destinationDisk && movingDisk > destinationDisk) {
      setStatus(labels.invalid, 'warning');
      return;
    }

    stacks[destination].push(stacks[selectedTower].pop());
    history.push({ from: selectedTower, to: destination });
    selectedTower = null;
    moves += 1;
    setStatus(solved() ? labels.won : labels.moved, solved() ? 'success' : 'default');
    render();
  }

  towerButtons.forEach((button, index) => {
    button.addEventListener('click', () => chooseTower(index));
  });

  newGameButton.addEventListener('click', () => startGame(Number(diskCountInput.value)));
  diskCountInput.addEventListener('change', () => startGame(Number(diskCountInput.value)));
  undoButton.addEventListener('click', () => {
    const lastMove = history.pop();
    if (!lastMove) return;

    stacks[lastMove.from].push(stacks[lastMove.to].pop());
    selectedTower = null;
    moves -= 1;
    setStatus(labels.undo);
    render();
  });

  startGame(diskCount);
</script>

<style>
  .hanoi-page {
    padding-block: clamp(2.5rem, 6vw, 4.75rem);
  }

  .hanoi-intro {
    max-width: 43rem;
  }

  .hanoi-eyebrow {
    color: #a78bfa;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .hanoi-intro h1 {
    margin-top: 0.7rem;
    color: var(--site-text);
    font-size: clamp(2.25rem, 6vw, 4.25rem);
    font-weight: 700;
    line-height: 0.98;
  }

  .hanoi-intro__summary {
    margin-top: 1.35rem;
    color: var(--site-subtle);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .hanoi-intro__instruction {
    margin-top: 0.65rem;
    color: var(--site-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .hanoi-game {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    overflow: hidden;
    border: 1px solid var(--site-card-border);
    border-radius: 1rem;
    background: var(--site-surface-strong);
    box-shadow: var(--site-card-shadow);
  }

  .hanoi-toolbar {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
    border-bottom: 1px solid var(--site-card-border);
  }

  .hanoi-toolbar__controls,
  .hanoi-metrics {
    display: flex;
    align-items: end;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .hanoi-field {
    display: grid;
    gap: 0.35rem;
  }

  .hanoi-field span,
  .hanoi-metric span {
    color: var(--site-muted);
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hanoi-select {
    min-width: 4.3rem;
    height: 2.5rem;
    border: 1px solid var(--site-card-border);
    border-radius: 0.45rem;
    background: var(--site-surface-soft);
    padding-inline: 0.65rem;
    color: var(--site-text);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .hanoi-action {
    min-height: 2.5rem;
    border: 1px solid var(--site-card-border);
    border-radius: 0.45rem;
    background: transparent;
    padding: 0.5rem 0.75rem;
    color: var(--site-subtle);
    font-size: 0.875rem;
    font-weight: 600;
    transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .hanoi-action:hover:not(:disabled) {
    border-color: rgba(167, 139, 250, 0.72);
    background: rgba(139, 92, 246, 0.1);
    color: var(--site-text);
  }

  .hanoi-action:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .hanoi-action--primary {
    border-color: #8b5cf6;
    background: #7c3aed;
    color: #fff;
  }

  .hanoi-action--primary:hover:not(:disabled) {
    border-color: #8b5cf6;
    background: #6d28d9;
    color: #fff;
  }

  .hanoi-metric {
    min-width: 3.9rem;
    padding-inline: 0.25rem;
  }

  .hanoi-metric strong {
    display: block;
    margin-top: 0.15rem;
    color: var(--site-text);
    font-size: 1rem;
    line-height: 1;
  }

  .hanoi-metric--status strong {
    color: #a78bfa;
    font-size: 0.8rem;
    line-height: 1.3;
  }

  .hanoi-status {
    min-height: 1.5rem;
    margin: 1rem 1rem 0;
    color: #c4b5fd;
    font-size: 0.875rem;
    font-weight: 600;
  }

  #hanoi-status[data-tone='warning'] {
    color: #fbbf24;
  }

  #hanoi-status[data-tone='success'] {
    color: #6ee7b7;
  }

  .hanoi-board {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0.25rem 1rem 0;
    padding: 0.5rem;
    border-radius: 0.75rem;
    background: var(--site-surface-soft);
    transition: box-shadow 180ms ease;
  }

  .hanoi-board.is-solved {
    box-shadow: inset 0 0 0 1px rgba(52, 211, 153, 0.45), 0 0 32px -16px rgba(52, 211, 153, 0.9);
  }

  .hanoi-tower {
    min-width: 0;
    border: 1px solid transparent;
    border-radius: 0.55rem;
    padding: 0.35rem;
    color: var(--site-text);
    transition: border-color 160ms ease, background-color 160ms ease, transform 160ms ease;
  }

  .hanoi-tower:hover:not(:disabled) {
    border-color: rgba(167, 139, 250, 0.45);
    background: rgba(139, 92, 246, 0.06);
  }

  .hanoi-tower:focus-visible {
    outline: 2px solid #c4b5fd;
    outline-offset: 2px;
  }

  .hanoi-tower.is-selected {
    border-color: #a78bfa;
    background: rgba(139, 92, 246, 0.12);
    transform: translateY(-1px);
  }

  .hanoi-tower.is-solved {
    border-color: rgba(52, 211, 153, 0.65);
    background: rgba(16, 185, 129, 0.1);
  }

  .hanoi-tower:disabled {
    cursor: default;
  }

  .hanoi-tower__name {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--site-muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hanoi-tower__playfield {
    position: relative;
    display: block;
    height: clamp(13rem, 34vw, 20rem);
    overflow: hidden;
    border: 1px solid var(--site-card-border);
    border-radius: 0.4rem;
    background: rgba(15, 23, 42, 0.38);
  }

  .hanoi-tower__rod {
    position: absolute;
    bottom: 1.45rem;
    left: 50%;
    width: 0.45rem;
    height: 74%;
    border-radius: 999px 999px 0 0;
    background: linear-gradient(90deg, #475569, #94a3b8 46%, #475569);
    box-shadow: 0 0 12px -6px rgba(226, 232, 240, 0.7);
    transform: translateX(-50%);
  }

  .hanoi-tower__disks {
    position: absolute;
    right: 0;
    bottom: 1.45rem;
    left: 0;
    z-index: 1;
    display: flex;
    height: calc(100% - 1.45rem);
    flex-direction: column-reverse;
    align-items: center;
    justify-content: flex-start;
    pointer-events: none;
  }

  :global(.hanoi-disk) {
    display: block;
    width: var(--disk-width);
    height: clamp(1.25rem, 4.8vw, 2rem);
    flex: 0 0 auto;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 0.22rem;
    background: linear-gradient(135deg, var(--disk-color-start), var(--disk-color-end));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28), 0 4px 10px -8px rgba(15, 23, 42, 0.9);
  }

  .hanoi-tower__base {
    position: absolute;
    right: 8%;
    bottom: 0.85rem;
    left: 8%;
    height: 0.62rem;
    border: 1px solid rgba(203, 213, 225, 0.24);
    border-radius: 0.2rem;
    background: linear-gradient(180deg, #64748b, #334155);
    box-shadow: 0 0.45rem 0.8rem -0.5rem #020617;
  }

  .hanoi-note {
    margin: 0.85rem 1rem 1rem;
    color: var(--site-muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  :global(html[data-theme='light']) .hanoi-tower__playfield {
    background: rgba(226, 232, 240, 0.58);
  }

  :global(html[data-theme='light']) .hanoi-tower__rod {
    background: linear-gradient(90deg, #94a3b8, #e2e8f0 46%, #94a3b8);
  }

  :global(html[data-theme='light']) .hanoi-tower__base {
    background: linear-gradient(180deg, #94a3b8, #64748b);
  }

  @media (max-width: 460px) {
    .hanoi-toolbar {
      align-items: stretch;
      flex-direction: column;
    }

    .hanoi-metrics {
      justify-content: space-between;
      padding-top: 0.35rem;
    }

    .hanoi-board {
      gap: 0.3rem;
      padding: 0.35rem;
    }

    .hanoi-tower {
      padding: 0.25rem;
    }

    .hanoi-tower__playfield {
      height: 12.5rem;
    }

    .hanoi-tower__name {
      font-size: 0.62rem;
      letter-spacing: 0.04em;
    }
  }
</style>
