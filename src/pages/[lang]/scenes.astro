            const bandHex = mix(lm.light, coolShaft, Math.max(0, (base - y) / h));
            box(cx - Math.floor(mast / 2) - 1, y, mast + 2, 1, word(mix(bandHex, '#ffffff', 0.35)));
          }
          const podW = Math.max(6, Math.round(h * 0.2));
          const podH = Math.max(3, Math.round(h * 0.055));
          box(cx - Math.floor(podW / 2), base - podH, podW, podH, word(mix(lm.body, coolShaft, 0.35)));
          for (let x = cx - Math.floor(podW / 2) + 1; x < cx + podW / 2 - 1; x += 2) {
