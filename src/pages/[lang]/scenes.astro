            const w = Math.max(1, Math.round(wBottom + (wTop - wBottom) * f));
            const shift = twist ? Math.round(Math.sin(f * twist) * w * 0.35) : 0;
            const x0 = cx - Math.floor(w / 2) + shift;
            for (let x = x0; x < x0 + w; x += 1) {
