        } else if (lm.kind === 'sakura') {
          // A cherry standing right at the viewer: the trunk runs out of the
          // bottom of the frame, the limbs reach across the sky, and the
          // blossom is dense enough to read as mass. Near dark wood against
          // the far pale mountain — the whole reason to stand on this side.
          const petalHex = lm.accent ?? '#ffb8d2';
          const petal = word(petalHex);
          const petalLit = word(mix(petalHex, '#ffffff', 0.5));
          const petalDeep = word(mix(petalHex, lm.body, 0.45));
          // On a phone the frame is far narrower than it is tall. A tree sized
          // off the height alone grows wider than the whole picture, and the
          // usual horizontal squeeze that keeps landmarks in view drags it in
