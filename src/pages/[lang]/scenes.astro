---
import Layout from '../../layouts/Layout.astro';
import { ui, languages } from '../../i18n/ui';
import { scenePixels, sceneOrder, sceneNames } from '../../data/scenes';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const activeLang = lang as keyof typeof ui;
const t = ui[activeLang] ?? ui.en;
const names = sceneNames[activeLang] ?? sceneNames.en;
---

<Layout title={`${t['scenes.page.title']} | Sakasu Portfolio`} lang={lang} description={t['scenes.page.subtitle']}>
  <div class="scene-reel" data-scene-reel>
    {sceneOrder.map((id, index) => (
      <section
        class="scene-stage"
        data-scene={id}
        aria-label={`${names[id].name}, ${names[id].place}`}
      >
        <canvas class="scene-canvas" data-scene-canvas={id} data-scene-index={index}></canvas>
        <p class="scene-label">
          <span class="scene-label__name">{names[id].name}</span>
          <span class="scene-label__place">{names[id].place}</span>
        </p>
      </section>
    ))}
  </div>
</Layout>

<style>
  /* Break out of the layout's centered column and fill the viewport. */
  .scene-reel {
    /* Full bleed without 100vw, which overflows by the scrollbar width. */
    margin-inline: calc(50% - 50vw);
    margin-block: -1.5rem;
    max-width: none;
    height: 70svh;
    overflow-y: scroll;
    scroll-snap-type: y mandatory;
    scrollbar-width: none;
    background: #000;
    overscroll-behavior-y: contain;
  }

  .scene-reel::-webkit-scrollbar {
    display: none;
  }

  .scene-stage {
    position: relative;
    height: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .scene-canvas {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
  }

  .scene-label {
    position: absolute;
    top: 1.1rem;
    left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    line-height: 1.15;
    /* Sits over artwork of any brightness, so it carries its own shadow. */
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.85), 0 0 8px rgba(0, 0, 0, 0.6);
    pointer-events: none;
  }

  .scene-label__name {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #fdf6e8;
  }

  .scene-label__place {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(253, 246, 232, 0.72);
  }

  @media (min-width: 768px) {
    .scene-label {
      top: 1.6rem;
      left: 1.75rem;
    }

    .scene-label__name {
      font-size: 1.15rem;
    }
  }
</style>

<script define:vars={{ specs: scenePixels }}>
  (() => {
    const ROWS = 240;
    const BAYER = [
      [0, 8, 2, 10],
      [12, 4, 14, 6],
      [3, 11, 1, 9],
      [15, 7, 13, 5],
    ];

    const rng = (seed) => {
      let a = seed >>> 0;
      return () => {
        a = (a + 0x6d2b79f5) >>> 0;
        let t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    };

    const rgb = (hex) => {
      const n = parseInt(hex.slice(1), 16);
      return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
    };

    /** Pack to the little-endian ABGR word an ImageData buffer expects. */
    const word = (hex) => {
      const [r, g, b] = rgb(hex);
      return (255 << 24) | (b << 16) | (g << 8) | r;
    };

    const mix = (a, b, f) => {
      const [r1, g1, b1] = rgb(a);
      const [r2, g2, b2] = rgb(b);
      const c = (x, y) => Math.round(x + (y - x) * f);
      return `#${((1 << 24) | (c(r1, r2) << 16) | (c(g1, g2) << 8) | c(b1, b2)).toString(16).slice(1)}`;
    };

    /** Blend two packed words, for reflections and haze. */
    const blend = (w1, w2, f) => {
      const r = Math.round((w1 & 255) + (((w2 & 255) - (w1 & 255)) * f));
      const g = Math.round(((w1 >> 8) & 255) + ((((w2 >> 8) & 255) - ((w1 >> 8) & 255)) * f));
      const b = Math.round(((w1 >> 16) & 255) + ((((w2 >> 16) & 255) - ((w1 >> 16) & 255)) * f));
      return (255 << 24) | (b << 16) | (g << 8) | r;
    };

    /** Terrain height per column, as a row index. Lower value = taller. */
    const surface = (kind, spec, layer, width, geom) => {
      const rows = geom.rows;
      const rand = rng(spec.seed * 97 + kind.length * 13 + Math.round(layer.y * 100));
      const base = geom.Y(layer.y);
      const amp = layer.amp * geom.unit;
      const out = new Array(width).fill(base);

      if (kind === 'city') {
        // Distant ranks get narrower blocks, which reads as depth.
        const spread = Math.max(0.35, Math.min(1, amp / (rows * 0.2)));
        let x = 0;
        while (x < width) {
          const w = Math.max(2, Math.round((4 + rand() * 12) * spread));
          const h = Math.round(amp * (0.25 + rand() * 0.75));
          for (let i = 0; i < w && x + i < width; i += 1) out[x + i] = base - h;
          x += w + (rand() < 0.3 ? 1 + Math.floor(rand() * 3) : 0);
        }
      } else if (kind === 'peaks') {
        const count = Math.max(3, Math.round(width / 30));
        const peaks = [];
        for (let i = 0; i < count; i += 1) {
          peaks.push({ x: rand() * width, h: amp * (0.45 + rand() * 0.55), slope: 0.5 + rand() * 0.7 });
        }
        for (let x = 0; x < width; x += 1) {
          let top = 0;
          for (const p of peaks) top = Math.max(top, p.h - Math.abs(x - p.x) * p.slope);
          // A little roughness so ridges are not perfect triangles.
          out[x] = Math.round(base - top + Math.sin(x * 0.7) * amp * 0.03);
        }
      } else {
        const step = kind === 'trees' ? 18 : 26;
        const knots = [];
        for (let i = 0; i <= Math.ceil(width / step) + 1; i += 1) knots.push(rand());
        for (let x = 0; x < width; x += 1) {
          const i = Math.floor(x / step);
          const f = (x % step) / step;
          const s = f * f * (3 - 2 * f);
          out[x] = Math.round(base - (knots[i] + (knots[i + 1] - knots[i]) * s) * amp);
        }
      }
      return out;
    };

    const buildStatic = (spec, width, rows) => {
      // The artwork is composed for a landscape frame. On taller viewports we
      // keep those proportions and extend the sky upward, rather than
      // stretching every building, so the scene stays true at any shape.
      // Never let the artwork shrink to a strip: on tall frames it still
      // fills two thirds of the height, with the extra going to the sky.
      const unit = Math.min(rows, Math.max(Math.round(width / 1.7), Math.round(rows * 0.66)));
      const topPad = rows - unit;
      const geom = {
        rows,
        unit,
        topPad,
        /** Fraction of the composition to a row on this canvas. */
        Y: (f) => Math.round(topPad + f * unit),
        /** A size given as a fraction of the composition. */
        S: (f) => Math.round(f * unit),
      };
      const scaleK = unit / ROWS;
      // Narrow frames tighten the composition horizontally, so the landmarks
      // stay in view instead of running off the sides.
      const spreadK = Math.max(0.4, Math.min(1, width / rows / 1.7));
      const X = (f) => Math.round((0.5 + (f - 0.5) * spreadK) * width);
      const buf = new Uint32Array(width * rows);
      // Once the clouds start drifting, everything standing in front of them
      // is mirrored onto a second, transparent layer that is laid back over
      // the top each frame — so a cloud passes behind the towers, not across.
      let front = null;
      const put = (px, py, c) => {
        // Coordinates must be whole numbers: a fractional index silently
        // wraps into the wrong row and leaves ghost pixels elsewhere.
        const x = Math.round(px);
        const y = Math.round(py);
        if (x < 0 || y < 0 || x >= width || y >= rows) return;
        buf[y * width + x] = c;
        if (front) front[y * width + x] = c;
      };
      const at = (x, y) => buf[Math.max(0, Math.min(rows - 1, y)) * width + Math.max(0, Math.min(width - 1, x))];
      const box = (x0, y0, w, h, c) => {
        for (let y = y0; y < y0 + h; y += 1) for (let x = x0; x < x0 + w; x += 1) put(x, y, c);
      };
      const disc = (cx, cy, r, c) => {
        for (let y = -r; y <= r; y += 1) {
          for (let x = -r; x <= r; x += 1) if (x * x + y * y <= r * r) put(cx + x, cy + y, c);
        }
      };
      const line = (x0, y0, x1, y1, c) => {
        const steps = Math.max(1, Math.max(Math.abs(x1 - x0), Math.abs(y1 - y0)));
        for (let i = 0; i <= steps; i += 1) {
          put(Math.round(x0 + ((x1 - x0) * i) / steps), Math.round(y0 + ((y1 - y0) * i) / steps), c);
        }
      };

      const blinkers = [];
      const beacons = [];
      const horizon = spec.sky[Math.max(0, spec.sky.length - 2)];

      // Sky: ordered dithering between the band colors.
      const bands = spec.sky.map(word);
      const last = spec.sky.length - 1;
      for (let y = 0; y < rows; y += 1) {
        const fy = Math.max(0, Math.min(1, (y - topPad) / Math.max(1, unit - 1)));
        const tv = fy * last;
        const i = Math.min(last - 1, Math.floor(tv));
        const f = tv - i;
        for (let x = 0; x < width; x += 1) {
          const th = (BAYER[y & 3][x & 3] + 0.5) / 16;
          put(x, y, f > th ? bands[i + 1] : bands[i]);
        }
      }

      const rand = rng(spec.seed);

      // Cumulus, built from overlapping discs with a lit top and shaded belly.
      // Each one is cut as its own little sprite rather than being stamped
      // into the sky, so it can be drifted across the frame later.
      const clouds = [];
      if (spec.clouds) {
        const c = spec.clouds;
        const core = word(c.color);
        const top = word(mix(c.color, '#ffffff', 0.6));
        const belly = word(mix(c.color, c.shade ?? '#8fa8c0', 0.55));
        for (let i = 0; i < c.count; i += 1) {
          const cxp = Math.round(rand() * width);
          const cyp = geom.Y(c.y + (rand() - 0.5) * c.spread);
          const scale = (0.6 + rand() * 0.8) * unit * 0.05;
          const puffs = 3 + Math.floor(rand() * 4);
          const parts = [];
          for (let p = 0; p < puffs; p += 1) {
            parts.push({
              x: cxp + Math.round((p - puffs / 2) * scale * 1.1 + (rand() - 0.5) * scale),
              y: cyp + Math.round((rand() - 0.5) * scale * 0.6),
              r: Math.max(2, Math.round(scale * (0.6 + rand() * 0.7))),
            });
          }
          let sx0 = Infinity;
          let sy0 = Infinity;
          let sx1 = -Infinity;
          let sy1 = -Infinity;
          for (const p of parts) {
            sx0 = Math.min(sx0, p.x - p.r);
            sy0 = Math.min(sy0, p.y - p.r);
            sx1 = Math.max(sx1, p.x + p.r);
            sy1 = Math.max(sy1, p.y + p.r);
          }
          const sw = sx1 - sx0 + 1;
          const sh = sy1 - sy0 + 1;
          // Zeroed, so anything the puffs miss stays transparent.
          const px = new Uint32Array(sw * sh);
          const set = (x, y, v) => {
            if (x < 0 || y < 0 || x >= sw || y >= sh) return;
            px[y * sw + x] = v;
          };
          for (const p of parts) {
            for (let x = -p.r; x <= p.r; x += 1) {
              for (let y = -p.r; y <= p.r; y += 1) {
                if (x * x + y * y <= p.r * p.r) set(p.x + x - sx0, p.y + y - sy0, core);
              }
            }
          }
          for (const p of parts) {
            for (let x = -p.r; x <= p.r; x += 1) {
              for (let y = -p.r; y <= p.r; y += 1) {
                if (x * x + y * y > p.r * p.r) continue;
                if (y < -p.r * 0.35) set(p.x + x - sx0, p.y + y - sy0, top);
                else if (y > p.r * 0.45) set(p.x + x - sx0, p.y + y - sy0, belly);
              }
            }
          }
          // Fatter clouds read as nearer, so they cross a little faster.
          const speed = unit * 0.004 * (0.7 + (scale / (unit * 0.05)) * 0.6);
          clouds.push({ px, w: sw, h: sh, x: sx0, y: sy0, speed });
        }
      }
      spec._clouds = clouds;

      if (spec.stars) {
        const stars = [];
        for (let i = 0; i < spec.stars; i += 1) {
          const x = Math.floor(rand() * width);
          const y = Math.floor(rand() * (topPad + unit * 0.5));
          const c = rand() < 0.3 ? '#ffffff' : '#cfd8ff';
          stars.push({ x, y, c });
          put(x, y, word(c));
        }
        spec._stars = stars;
      }

      if (spec.celestial) {
        const c = spec.celestial;
        const cx = Math.round(c.x * width);
        const cy = geom.Y(c.y);
        const glow = word(c.glow);
        const core = word(c.color);
        const rr0 = Math.max(2, Math.round(c.r * scaleK));
        const halo = Math.round(rr0 * 2.4);
        const shade = word(mix(c.color, c.glow, 0.5));
        for (let y = -halo; y <= halo; y += 1) {
          for (let x = -halo; x <= halo; x += 1) {
            const d = Math.hypot(x, y);
            if (d <= rr0) {
              put(cx + x, cy + y, core);
            } else if (d <= halo) {
              const strength = 1 - (d - rr0) / (halo - rr0);
              const th = (BAYER[(cy + y) & 3][(cx + x) & 3] + 0.5) / 16;
              if (strength * strength > th) put(cx + x, cy + y, glow);
            }
          }
        }
        if (c.kind === 'moon') {
          const cr = rng(spec.seed * 5);
          for (let i = 0; i < 3; i += 1) {
            const a = cr() * Math.PI * 2;
            const dist = cr() * rr0 * 0.55;
            const rr = Math.max(1, Math.round(rr0 * (0.14 + cr() * 0.18)));
            disc(cx + Math.round(Math.cos(a) * dist), cy + Math.round(Math.sin(a) * dist), rr, shade);
          }
        }
      }

      // Warm band sitting on the horizon, behind everything solid.
      if (spec.haze) {
        const hy = geom.Y(spec.haze.y);
        const reach = Math.round(unit * 0.34);
        const c = word(spec.haze.color);
        for (let y = hy - reach; y < hy + Math.round(reach * 0.35); y += 1) {
          const d = Math.abs(y - hy) / reach;
          const density = Math.max(0, 1 - d) ** 1.6 * spec.haze.strength;
          for (let x = 0; x < width; x += 1) {
            const th = (BAYER[y & 3][x & 3] + 0.5) / 16;
            // Blend proportionally so the band has no hard dithered edge.
            if (density > th * 0.5) put(x, y, blend(at(x, y), c, Math.min(0.6, density * 0.8)));
          }
        }
      }

      const waterTop = spec.water ? geom.Y(spec.water.y) : rows;
      spec._waterTop = waterTop;

      /** Distant layers wash toward the horizon colour. */
      const hazed = (color, amount) => (amount ? mix(color, horizon, amount) : color);

      // From here down everything is solid ground, hills, towers and water:
      // the part that has to sit in front of a passing cloud.
      if (clouds.length) front = new Uint32Array(width * rows);

      // A mountain on the horizon: drawn first, so the skyline overlaps its
      // flanks the way the city does from any window in town.
      if (spec.landmarks) {
        for (const lm of spec.landmarks) if (lm.behind) drawLandmark(lm);
      }

      for (const layer of spec.layers) {
        const top = surface(layer.kind, spec, layer, width, geom);
        const bodyHex = hazed(layer.color, layer.haze ?? 0);
        const body = word(bodyHex);
        // Contrast falls off with distance, so far ranks read as mass rather
        // than a picket fence of lit and shaded edges.
        const fade = 1 - (layer.haze ?? 0) * 0.75;
        const lit = word(mix(bodyHex, '#ffffff', 0.14 * fade));
        const shadow = word(mix(bodyHex, '#000000', 0.3 * fade));
        const accentHex = layer.accent ? hazed(layer.accent, (layer.haze ?? 0) * 0.5) : null;
        const accent = accentHex ? word(accentHex) : null;
        const lr = rng(spec.seed * 17 + Math.round(layer.y * 90));
        const bottom = layer.kind === 'city' || layer.kind === 'trees' ? waterTop : rows;

        if (layer.kind === 'city') {
          // Walk the skyline building by building so each can be shaded.
          let x = 0;
          while (x < width) {
            let end = x;
            while (end < width && top[end] === top[x]) end += 1;
            const t = top[x];
            const w = end - x;
            const dark = lr() < 0.25; // some blocks stay unlit
            for (let bx = x; bx < end; bx += 1) {
              for (let y = Math.max(0, t); y < bottom; y += 1) {
                let c = body;
                if (y === t) c = lit;
                else if (bx === x) c = lit;
                else if (bx === end - 1) c = shadow;
                put(bx, y, c);
              }
            }
            if (accent && !dark && w > 2) {
              const density = 0.25 + lr() * 0.45;
              for (let bx = x + 1; bx < end - 1; bx += 2) {
                for (let y = t + 3; y < bottom - 2; y += 3) {
                  if (lr() < density) {
                    put(bx, y, accent);
                    if (lr() < 0.06) {
                      blinkers.push({ x: bx, y, on: accentHex, off: bodyHex, period: 12 + lr() * 14, phase: lr() * 24 });
                    }
                  }
                }
              }
            }
            // Roof clutter: a mast or a water tank.
            if (w > 4 && (layer.haze ?? 0) < 0.5 && lr() < 0.4) {
              const mx = x + 1 + Math.floor(lr() * (w - 2));
              const mh = 2 + Math.floor(lr() * 5);
              line(mx, t, mx, t - mh, shadow);
              if (accent && lr() < 0.4) {
                beacons.push({ x: mx, y: t - mh, color: '#ff5a5a', period: 3.6 + lr() * 2.4, phase: lr() * 6 });
              }
            }
            x = end;
          }
        } else if (layer.kind === 'roofs') {
          // A quarter of the palace seen from the hill. Halls of every size
          // jostle together over their courtyards — some broadside, some
          // end-on, the odd corner pavilion or pine breaking the rank — so
          // the roofscape reads as a crowd rather than a row of stamps.
          const scale = layer.amp * unit;
          const goldHex = hazed(layer.accent ?? '#d9a441', (layer.haze ?? 0) * 0.8);
          const gold = word(goldHex);
          const goldLit = word(mix(goldHex, '#fff0c8', 0.45));
          const ridge = word(mix(goldHex, '#5a3418', 0.45));
          const wall = word(mix(bodyHex, '#000000', 0.05));
          // Detail fades with distance, so hazy ranks read as mass, not texture.
          const shade = word(mix(bodyHex, '#000000', 0.35 * (1 - (layer.haze ?? 0) * 0.8)));
          const court = word(mix(bodyHex, '#000000', 0.22));
          const pineHex = hazed('#4c5f33', (layer.haze ?? 0) * 0.85);
          const pine = word(pineHex);
          const pineLit = word(mix(pineHex, '#9db35c', 0.4));

          // Courtyards behind, so no sky shows between the ranks.
          for (let x = 0; x < width; x += 1) {
            for (let y = Math.max(0, top[x] + Math.round(scale * 0.5)); y < rows; y += 1) put(x, y, court);
          }

          /** One tiled roof: hips falling away from the ridge to eave corners
           *  that fly up, the way a palace roof is cut. */
          const tiles = (mid, eave, halfW, rh) => {
            const tip = rh * 0.5;
            for (let dx = -halfW; dx <= halfW; dx += 1) {
              const t = Math.abs(dx) / halfW;
              const hip = t <= 0.42 ? rh : rh - ((t - 0.42) / 0.58) * (rh - tip);
              const lift = t <= 0.68 ? 0 : ((t - 0.68) / 0.32) ** 2 * tip;
              const yTop = eave - Math.round(hip);
              const yBot = eave - Math.round(lift);
              for (let y = yTop; y <= yBot; y += 1) {
                // Tiles read as fine ribs, smoothing out toward the ridge.
                const f = (eave - y) / rh;
                put(mid + dx, y, y === yBot || (dx % 3 === 0 && f < 0.75) ? ridge : f > 0.6 ? goldLit : gold);
              }
            }
          };

          let x = -Math.round(lr() * scale * 2);
          while (x < width) {
            // Bigger halls stand nearer and lower, small ones sit back up the slope.
            const s = scale * (0.6 + lr() * 1.1);
            const ground = top[Math.max(0, Math.min(width - 1, x))] + Math.round(s * 1.05);
            const pick = lr();
            let step;
            if (pick < 0.09) {
              // Pine or scholar tree in a courtyard.
              const r = Math.max(2, Math.round(s * 0.6));
              disc(x, ground - r, r, pine);
              disc(x - Math.round(r * 0.5), ground - Math.round(r * 1.4), Math.max(1, Math.round(r * 0.7)), pineLit);
              line(x, ground - r, x, ground, shade);
              step = r * 2;
            } else if (pick < 0.19) {
              // Corner pavilion: square tower under a pyramid roof.
              const w2 = Math.max(4, Math.round(s * 1.3));
              const tower = Math.max(3, Math.round(s * 1.1));
              box(x - Math.floor(w2 / 2), ground - tower, w2, tower, wall);
              for (let px = x - Math.floor(w2 / 2); px < x + w2 / 2; px += 3) line(px, ground - tower, px, ground - 1, shade);
              tiles(x, ground - tower, Math.round(w2 * 0.62), Math.max(3, Math.round(s * 0.8)));
              line(x, ground - tower - Math.round(s * 0.8), x, ground - tower - Math.round(s * 1.15), ridge);
              step = w2 * 1.2;
            } else if (pick < 0.37) {
              // Hall seen end-on: narrow, with a steeper roof.
              const w2 = Math.max(4, Math.round(s * 1.5));
              const wallH = Math.max(2, Math.round(s * 0.55));
              box(x - Math.floor(w2 / 2), ground - wallH, w2, wallH, wall);
              tiles(x, ground - wallH, Math.round(w2 * 0.6), Math.max(3, Math.round(s * 0.85)));
              step = w2 * (0.9 + lr() * 0.5);
            } else {
              // Hall broadside, one storey or two.
              const w2 = Math.max(8, Math.round(s * (2.4 + lr() * 1.6)));
              const wallH = Math.max(2, Math.round(s * 0.5));
              box(x - Math.floor(w2 / 2), ground - wallH, w2, wallH, wall);
              for (let px = x - Math.floor(w2 / 2); px < x + w2 / 2; px += 3) line(px, ground - wallH, px, ground - 1, shade);
              const rh = Math.max(3, Math.round(s * 0.6));
              tiles(x, ground - wallH, Math.round(w2 * 0.5), rh);
              if (pick > 0.86) {
