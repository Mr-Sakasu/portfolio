---
import Layout from '../../layouts/Layout.astro';
import { ui, languages } from '../../i18n/ui';
import { scenePixels, sceneOrder, sceneNames } from '../../data/scenes';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const activeLang = lang as keyof typeof ui;
const t = ui[activeLang] ?? ui.en;
const names = sceneNames[activeLang] ?? sceneNames.en;
---

<Layout title={`${t['scenes.page.title']} | Sakasu Portfolio`} lang={lang} description={t['scenes.page.subtitle']}>
  <div class="scene-reel" data-scene-reel>
    {sceneOrder.map((id, index) => (
      <section
        class="scene-stage"
        data-scene={id}
        aria-label={`${names[id].name}, ${names[id].place}`}
      >
        <canvas class="scene-canvas" data-scene-canvas={id} data-scene-index={index}></canvas>
      </section>
    ))}
  </div>
</Layout>

<style>
  /* Break out of the layout's centered column and fill the viewport. */
  .scene-reel {
    width: 100vw;
    margin: -1.5rem 0 -1.5rem calc(50% - 50vw);
    height: 70svh;
    overflow-y: scroll;
    scroll-snap-type: y mandatory;
    scrollbar-width: none;
    background: #000;
    overscroll-behavior-y: contain;
  }

  .scene-reel::-webkit-scrollbar {
    display: none;
  }

  .scene-stage {
    position: relative;
    height: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .scene-canvas {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
  }
</style>

<script define:vars={{ specs: scenePixels }}>
  (() => {
    const ROWS = 150;
    const BAYER = [
      [0, 8, 2, 10],
      [12, 4, 14, 6],
      [3, 11, 1, 9],
      [15, 7, 13, 5],
    ];

    const rng = (seed) => {
      let a = seed >>> 0;
      return () => {
        a = (a + 0x6d2b79f5) >>> 0;
        let t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    };

    const rgb = (hex) => {
      const n = parseInt(hex.slice(1), 16);
      return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
    };

    /** Pack to the little-endian ABGR word an ImageData buffer expects. */
    const word = (hex) => {
      const [r, g, b] = rgb(hex);
      return (255 << 24) | (b << 16) | (g << 8) | r;
    };

    const mix = (a, b, f) => {
      const [r1, g1, b1] = rgb(a);
      const [r2, g2, b2] = rgb(b);
      const c = (x, y) => Math.round(x + (y - x) * f);
      return `#${((1 << 24) | (c(r1, r2) << 16) | (c(g1, g2) << 8) | c(b1, b2)).toString(16).slice(1)}`;
    };

    /** Terrain height per column, as a row index. Lower value = taller. */
    const surface = (kind, spec, layer, width, rows) => {
      const rand = rng(spec.seed * 97 + kind.length * 13 + Math.round(layer.y * 100));
      const base = Math.round(layer.y * rows);
      const amp = layer.amp * rows;
      const out = new Array(width).fill(base);

      if (kind === 'city') {
        let x = 0;
        while (x < width) {
          const w = 3 + Math.floor(rand() * 9);
          const h = Math.round(amp * (0.25 + rand() * 0.75));
          for (let i = 0; i < w && x + i < width; i += 1) out[x + i] = base - h;
          x += w + (rand() < 0.25 ? 1 + Math.floor(rand() * 2) : 0);
        }
      } else if (kind === 'peaks') {
        const count = Math.max(3, Math.round(width / 22));
        const peaks = [];
        for (let i = 0; i < count; i += 1) {
          peaks.push({
            x: rand() * width,
            h: amp * (0.45 + rand() * 0.55),
            slope: 0.6 + rand() * 0.9,
          });
        }
        for (let x = 0; x < width; x += 1) {
          let top = 0;
          for (const p of peaks) top = Math.max(top, p.h - Math.abs(x - p.x) * p.slope);
          out[x] = Math.round(base - top);
        }
      } else if (kind === 'cone') {
        const cx = width * 0.5;
        const slope = amp / (width * 0.34);
        for (let x = 0; x < width; x += 1) {
          const d = Math.abs(x - cx);
          const jag = d > 4 ? Math.round(rand() * 1.4) : 0;
          out[x] = Math.round(base - Math.max(0, amp - d * slope) + jag);
        }
      } else {
        // hills, shore, trees: smooth interpolated noise
        const step = kind === 'shore' ? 26 : 14;
        const knots = [];
        for (let i = 0; i <= Math.ceil(width / step) + 1; i += 1) knots.push(rand());
        for (let x = 0; x < width; x += 1) {
          const i = Math.floor(x / step);
          const f = (x % step) / step;
          const s = f * f * (3 - 2 * f);
          const v = knots[i] + (knots[i + 1] - knots[i]) * s;
          out[x] = Math.round(base - v * amp);
        }
      }
      return out;
    };

    const buildStatic = (spec, width, rows) => {
      const buf = new Uint32Array(width * rows);
      const put = (x, y, c) => {
        if (x < 0 || y < 0 || x >= width || y >= rows) return;
        buf[y * width + x] = c;
      };

      // Sky: ordered dithering between the band colors.
      const bands = spec.sky.map(word);
      const last = spec.sky.length - 1;
      for (let y = 0; y < rows; y += 1) {
        const tv = (y / (rows - 1)) * last;
        const i = Math.min(last - 1, Math.floor(tv));
        const f = tv - i;
        for (let x = 0; x < width; x += 1) {
          const th = (BAYER[y & 3][x & 3] + 0.5) / 16;
          put(x, y, f > th ? bands[i + 1] : bands[i]);
        }
      }

      const rand = rng(spec.seed);

      if (spec.stars) {
        const stars = [];
        for (let i = 0; i < spec.stars; i += 1) {
          const x = Math.floor(rand() * width);
          const y = Math.floor(rand() * rows * 0.55);
          const c = rand() < 0.3 ? '#ffffff' : '#cfd8ff';
          stars.push({ x, y, c });
          put(x, y, word(c));
        }
        spec._stars = stars;
      }

      if (spec.celestial) {
        const c = spec.celestial;
        const cx = Math.round(c.x * width);
        const cy = Math.round(c.y * rows);
        const glow = word(c.glow);
        const core = word(c.color);
        const halo = c.r * 2.2;
        const shade = word(mix(c.color, c.glow, 0.55));
        for (let y = -halo; y <= halo; y += 1) {
          for (let x = -halo; x <= halo; x += 1) {
            const d = Math.hypot(x, y);
            if (d <= c.r) {
              put(cx + x, cy + y, core);
            } else if (d <= halo) {
              const strength = 1 - (d - c.r) / (halo - c.r);
              const th = (BAYER[(cy + y) & 3][(cx + x) & 3] + 0.5) / 16;
              if (strength * strength > th) put(cx + x, cy + y, glow);
            }
          }
        }
        // A couple of craters give the moon some read at this size.
        if (c.kind === 'moon') {
          const cr = rng(spec.seed * 5);
          for (let i = 0; i < 3; i += 1) {
            const a = cr() * Math.PI * 2;
            const dist = cr() * c.r * 0.55;
            const ox = Math.round(Math.cos(a) * dist);
            const oy = Math.round(Math.sin(a) * dist);
            const rr = Math.max(1, Math.round(c.r * (0.15 + cr() * 0.2)));
            for (let y = -rr; y <= rr; y += 1) {
              for (let x = -rr; x <= rr; x += 1) {
                if (Math.hypot(x, y) <= rr) put(cx + ox + x, cy + oy + y, shade);
              }
            }
          }
        }
      }

      if (spec.aurora) spec._auroraCols = width;

      const waterTop = spec.water ? Math.round(spec.water.y * rows) : rows;

      for (const layer of spec.layers) {
        if (layer.kind === 'bamboo') {
          const lr = rng(spec.seed * 31);
          // Three depth passes: far stalks are thin and dark, near ones thick and lit.
          const passes = [
            { count: Math.round(width / 5), w: [1, 2], tint: 0.0, light: 0.0 },
            { count: Math.round(width / 11), w: [2, 4], tint: 0.35, light: 0.15 },
            { count: Math.round(width / 26), w: [4, 7], tint: 0.7, light: 0.3 },
          ];
          for (const pass of passes) {
            for (let i = 0; i < pass.count; i += 1) {
              const x = Math.floor(lr() * width);
              const w = pass.w[0] + Math.floor(lr() * (pass.w[1] - pass.w[0] + 1));
              const base = mix(layer.color, layer.accent ?? layer.color, pass.tint + lr() * 0.2);
              const lit = word(mix(base, '#e8ffbe', pass.light + 0.12));
              const body = word(base);
              const edge = word(mix(base, '#04120a', 0.45));
              const nodeOffset = Math.floor(lr() * 19);
              for (let y = 0; y < rows; y += 1) {
                for (let k = 0; k < w; k += 1) {
                  put(x + k, y, k === 0 ? lit : k === w - 1 ? edge : body);
                }
                if ((y + nodeOffset) % 21 === 0) {
                  for (let k = 0; k < w; k += 1) put(x + k, y, edge);
                }
              }
              // A few leaves hanging off the taller stalks.
              if (pass.tint > 0.3) {
                for (let l = 0; l < 3; l += 1) {
                  const ly = Math.floor(lr() * rows * 0.8);
                  const dir = lr() < 0.5 ? -1 : 1;
                  for (let s = 0; s < 6 + Math.floor(lr() * 5); s += 1) {
                    put(x + (dir > 0 ? w : 0) + dir * s, ly + Math.round(s * 0.45), lit);
                  }
                }
              }
            }
          }
          continue;
        }

        const top = surface(layer.kind, spec, layer, width, rows);
        const summit = Math.min(...top);
        const body = word(layer.color);
        // Silhouettes read better without a rim light; landforms keep it.
        const rim = word(layer.kind === 'trees' ? layer.color : mix(layer.color, '#ffffff', 0.16));
        const accent = layer.accent ? word(layer.accent) : null;
        const lr = rng(spec.seed * 17 + Math.round(layer.y * 90));

        for (let x = 0; x < width; x += 1) {
          const t = top[x];
          const bottom = layer.kind === 'city' || layer.kind === 'trees' ? waterTop : rows;
          for (let y = Math.max(0, t); y < bottom; y += 1) put(x, y, y === t ? rim : body);

          if (accent && layer.kind === 'city') {
            // Windows sit on a grid so they read as floors, not noise.
            if (x % 3 === 1) {
              for (let y = t + 3; y < bottom - 2; y += 3) {
                if (lr() < 0.45) put(x, y, accent);
              }
            }
          }
          if (accent && layer.kind === 'cone') {
            // Snow only near the summit, thinning out as it runs down the flanks.
            const capDepth = layer.amp * rows * 0.42;
            const capLine = summit + capDepth;
            for (let y = Math.max(0, t); y < capLine; y += 1) {
              const depth = 1 - (y - summit) / capDepth;
              const th = (BAYER[y & 3][x & 3] + 0.5) / 16;
              if (depth > 0 && depth * depth > th) put(x, y, accent);
            }
          }
          if (accent && layer.kind === 'trees') {
            if (lr() < 0.12) put(x, Math.max(0, t - 1), accent);
          }
        }
      }

      // Mist sits in front of the ridges, so it reads as a sea of cloud.
      if (spec.fog) {
        const fy = Math.round(spec.fog.y * rows);
        const c = word(spec.fog.color);
        const band = spec.fog.rows * 3;
        for (let r = 0; r < band; r += 1) {
          const y = fy + r;
          // Densest in the middle of the band, feathering out top and bottom.
          const f = r / band;
          const density = Math.sin(f * Math.PI) * 1.15;
          for (let x = 0; x < width; x += 1) {
            const wobble = Math.sin(x * 0.055 + f * 4) * 0.16 + Math.sin(x * 0.021) * 0.1;
            const th = (BAYER[y & 3][x & 3] + 0.5) / 16;
            if (density + wobble > th) put(x, y, c);
          }
        }
      }

      if (spec.water) {
        const cols = spec.water.colors.map(word);
        for (let y = waterTop; y < rows; y += 1) {
          const band = Math.min(cols.length - 1, Math.floor(((y - waterTop) / (rows - waterTop)) * cols.length));
          for (let x = 0; x < width; x += 1) put(x, y, cols[band]);
        }
        // Reflection of the sun or moon, broken into dashes.
        if (spec.celestial) {
          const cx = Math.round(spec.celestial.x * width);
          const g = word(spec.celestial.glow);
          const wr = rng(spec.seed * 7);
          for (let y = waterTop; y < rows; y += 2) {
            const spread = Math.round(1 + ((y - waterTop) / (rows - waterTop)) * spec.celestial.r * 2.5);
            for (let x = cx - spread; x <= cx + spread; x += 1) {
              const falloff = 1 - Math.abs(x - cx) / (spread + 1);
              if (wr() < falloff * 0.8) put(x, y, g);
            }
          }
        }
      }

      return buf;
    };

    const startScene = (canvas) => {
      const id = canvas.dataset.sceneCanvas;
      const spec = JSON.parse(JSON.stringify(specs[id]));
      const ctx = canvas.getContext('2d', { alpha: false });
      if (!ctx) return () => {};
      ctx.imageSmoothingEnabled = false;

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let width = 0;
      let rows = ROWS;
      let image = null;
      let particles = [];
      let visible = true;
      let raf = 0;
      let lastDraw = 0;

      const build = () => {
        const rect = canvas.getBoundingClientRect();
        const aspect = rect.height > 0 ? rect.width / rect.height : 1.6;
        // Keep the shorter side near ROWS so pixels stay chunky in both
        // landscape and portrait, and nothing gets cropped by object-fit.
        if (aspect >= 1) {
          rows = ROWS;
          width = Math.min(560, Math.round(ROWS * aspect));
        } else {
          width = Math.round(ROWS * 0.8);
          rows = Math.min(520, Math.round(width / aspect));
        }
        canvas.width = width;
        canvas.height = rows;
        ctx.imageSmoothingEnabled = false;
        const buf = buildStatic(spec, width, rows);
        image = new ImageData(new Uint8ClampedArray(buf.buffer), width, rows);

        particles = [];
        if (spec.weather) {
          const pr = rng(spec.seed * 3 + 1);
          const count = spec.weather === 'fireflies' ? 18 : 40;
          for (let i = 0; i < count; i += 1) {
            particles.push({
              x: pr() * width,
              y: pr() * rows,
              vx: (pr() - 0.5) * 0.5,
              vy: spec.weather === 'fireflies' ? (pr() - 0.5) * 0.2 : 0.25 + pr() * 0.5,
              phase: pr() * Math.PI * 2,
            });
          }
        }
      };

      const frame = (time) => {
        raf = requestAnimationFrame(frame);
        if (!visible || !image) return;
        if (time - lastDraw < 90) return; // ~11fps keeps the pixel cadence
        lastDraw = time;
        ctx.putImageData(image, 0, 0);
        const t = time / 1000;

        if (spec.aurora) {
          for (let x = 0; x < width; x += 1) {
            const base = rows * 0.34 + Math.sin(x * 0.08 + t * 0.7) * 12 + Math.sin(x * 0.021 - t * 0.4) * 18;
            const height = 16 + Math.sin(x * 0.05 + t) * 10;
            for (let y = Math.round(base - height); y < base; y += 1) {
              if (y < 0) continue;
              const f = (y - (base - height)) / height;
              const c = spec.aurora[Math.min(spec.aurora.length - 1, Math.floor(f * spec.aurora.length))];
              const th = (BAYER[y & 3][x & 3] + 0.5) / 16;
              if (1 - f * 0.8 > th) {
                ctx.fillStyle = c;
                ctx.fillRect(x, y, 1, 1);
              }
            }
          }
        }

        if (spec._stars && !reduced) {
          for (let i = 0; i < spec._stars.length; i += 1) {
            const s = spec._stars[i];
            const on = Math.sin(t * 2.2 + i * 1.7) > 0.4;
            ctx.fillStyle = on ? '#ffffff' : s.c;
            ctx.fillRect(s.x, s.y, 1, 1);
          }
        }

        if (spec.water) {
          const top = Math.round(spec.water.y * rows);
          ctx.fillStyle = spec.water.shimmer;
          // Sparse horizontal streaks that drift sideways, rather than static noise.
          for (let y = top + 2; y < rows; y += 4) {
            const row = (y - top) / 4;
            const drift = Math.sin(t * 0.6 + row) * width * 0.5;
            const spacing = 22 + (row % 3) * 9;
            for (let x = ((drift % spacing) + spacing) % spacing; x < width; x += spacing) {
              ctx.fillRect(Math.round(x), y, 2 + (row % 2), 1);
            }
          }
        }

        if (particles.length) {
          for (const p of particles) {
            if (reduced) {
              // hold position
            } else if (spec.weather === 'fireflies') {
              p.x += Math.sin(t + p.phase) * 0.4;
              p.y += Math.cos(t * 0.8 + p.phase) * 0.3;
            } else {
              p.x += p.vx + Math.sin(t + p.phase) * 0.3;
              p.y += p.vy;
              if (p.y > rows) {
                p.y = -2;
                p.x = Math.random() * width;
              }
              if (p.x < 0) p.x += width;
              if (p.x > width) p.x -= width;
            }
            const glow = spec.weather === 'fireflies' ? (Math.sin(t * 3 + p.phase) > 0 ? '#e8ff9a' : '#9ec55a') : null;
            ctx.fillStyle = glow ?? (spec.weather === 'petals' ? '#ffd6e0' : '#ffffff');
            ctx.fillRect(Math.round(p.x), Math.round(p.y), 1, 1);
          }
        }
      };

      build();
      ctx.putImageData(image, 0, 0);
      raf = requestAnimationFrame(frame);

      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) visible = entry.isIntersecting;
      }, { threshold: 0.05 });
      io.observe(canvas);

      let resizeTimer = 0;
      const onResize = () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          build();
          ctx.putImageData(image, 0, 0);
        }, 150);
      };
      window.addEventListener('resize', onResize);

      return () => {
        cancelAnimationFrame(raf);
        io.disconnect();
        window.removeEventListener('resize', onResize);
      };
    };

    let teardown = [];

    const init = () => {
      teardown.forEach((fn) => fn());
      teardown = [];
      const reel = document.querySelector('[data-scene-reel]');
      if (!reel) return;

      const sizeReel = () => {
        const top = reel.getBoundingClientRect().top + window.scrollY;
        const height = Math.max(320, window.innerHeight - top);
        reel.style.height = `${height}px`;
      };
      sizeReel();
      window.addEventListener('resize', sizeReel);
      teardown.push(() => window.removeEventListener('resize', sizeReel));

      document.querySelectorAll('[data-scene-canvas]').forEach((canvas) => {
        teardown.push(startScene(canvas));
      });
    };

    document.addEventListener('astro:page-load', init);
    if (document.readyState !== 'loading') init();
    else document.addEventListener('DOMContentLoaded', init);
  })();
</script>
