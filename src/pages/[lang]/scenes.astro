              }
            }
            if (depth <= 0 || len < 4) {
              // The trunk ends in a fork, not in flower.
              if (!bare) tips.push({ x: x1, y: y1, r: Math.max(3, len * (0.9 + lr() * 0.4)) });
              return;
            }
            // Shoots leave the flanks at points spaced up the limb, alternating
            // sides the way buds do, each shorter than the wood it grew from.
            const shoots = 1 + (lr() < 0.55 ? 1 : 0);
            let side = lr() < 0.5 ? 1 : -1;
            for (let n = 0; n < shoots; n += 1) {
              const f = 0.42 + (n + lr()) * (0.5 / shoots);
              limb(
                ax(f),
                ay(f),
                ang - f * bend + side * (0.42 + lr() * 0.4),
                len * (0.4 + lr() * 0.22),
                Math.max(1, w * 0.5),
                depth - 1,
              );
              side = -side;
            }
            // The leader carries on, leaning off only slightly, so the limb
            // still reads as one piece of wood running out to its own end.
            limb(x1, y1, tipAng + (lr() - 0.5) * 0.34, len * (0.6 + lr() * 0.18), w * 0.66, depth - 1);
            // Now and then it loses the argument and forks in earnest.
            if (lr() < 0.35) {
              limb(x1, y1, tipAng - (0.4 + lr() * 0.3) * side, len * (0.5 + lr() * 0.2), w * 0.55, depth - 1);
            }
          };
          // Two scaffold limbs off a short trunk, as a garden cherry is grown,
          // rather than everything hanging off one pole.
          const forkY = base - th * 0.3;
          limb(cx, base, Math.PI / 2 + 0.1, th * 0.3, trunkW, 0, true);
          limb(cx, forkY, Math.PI / 2 - 0.24, th * 0.3, trunkW * 0.82, 4);
          limb(cx, forkY, Math.PI / 2 + 0.3, th * 0.26, trunkW * 0.7, 4);

          // The canopy is one mass, not a cluster stamped on each branch end.
          // The seeds lay down overlapping mounds of density and the blossom
          // is wherever those add up past a threshold, so neighbouring clumps
          // run together instead of standing apart as torn dots. Only the rim
          // is broken up, and only into the sky — punching holes through the
          // body of it is what kept tearing the tree into pieces.
          if (tips.length) {
            let bx0 = Infinity;
            let by0 = Infinity;
            let bx1 = -Infinity;
            let by1 = -Infinity;
            for (const t of tips) {
              bx0 = Math.min(bx0, t.x - t.r);
              by0 = Math.min(by0, t.y - t.r);
              bx1 = Math.max(bx1, t.x + t.r);
              by1 = Math.max(by1, t.y + t.r);
            }
            bx0 = Math.max(0, Math.floor(bx0));
            by0 = Math.max(0, Math.floor(by0));
            bx1 = Math.min(width - 1, Math.ceil(bx1));
            by1 = Math.min(rows - 1, Math.ceil(by1));
            const bw2 = Math.max(1, bx1 - bx0 + 1);
            const bh2 = Math.max(1, by1 - by0 + 1);
            const field = new Float32Array(bw2 * bh2);
            for (const t of tips) {
              const r = t.r;
              const x0 = Math.max(bx0, Math.floor(t.x - r));
              const x1 = Math.min(bx1, Math.ceil(t.x + r));
              const y0 = Math.max(by0, Math.floor(t.y - r));
              const y1 = Math.min(by1, Math.ceil(t.y + r));
              for (let y = y0; y <= y1; y += 1) {
                for (let x = x0; x <= x1; x += 1) {
                  const d = Math.sqrt((x - t.x) ** 2 + (y - t.y) ** 2) / r;
                  if (d >= 1) continue;
                  field[(y - by0) * bw2 + (x - bx0)] += (1 - d) ** 1.4;
                }
              }
            }
            for (let y = by0; y <= by1; y += 1) {
              for (let x = bx0; x <= bx1; x += 1) {
                const v = field[(y - by0) * bw2 + (x - bx0)];
                if (v < 0.2) continue;
                // A soft ragged edge where the blossom thins out, so the
                // outline is foliage and not a drawn curve.
                if (v < 0.42 && lr() > (v - 0.2) / 0.22) continue;
                // Light from the upper left: the far side of the crown and
                // the depth under it fall away into shadow, and clumps catch
                // the light along their tops.
                const t2 = field[(y - 1 - by0) * bw2 + (x - bx0)] ?? 0;
                let c = petal;
                if (v > 1.9) c = petalDeep;
                else if (t2 < v * 0.75 && v < 1.5) c = petalLit;
                put(x, y, c);
              }
            }
          }
        } else if (lm.kind === 'tokyotower') {
          // Tokyo Tower: legs splaying out to the plaza with the sky showing
          // through the lattice, the big deck a third of the way up, the small
          // one under the aerial. Floodlit, so it glows against the dusk.
          const deckY = Math.round(h * 0.44);
          const topY = Math.round(h * 0.72);
          const paint = word(lm.body);
          const pale = word(mix(lm.body, '#ffe8c8', 0.45));
          const dark = word(mix(lm.body, '#000000', 0.4));
          const glass = word(lm.light);
          const halfAt = (i) =>
            i < deckY
              ? Math.max(2, Math.round(h * (0.03 + 0.1 * (1 - i / deckY) ** 1.9)))
              : Math.max(1, Math.round(h * 0.03 * (1 - ((i - deckY) / (topY - deckY)) * 0.4)));
          // Cross bracing between the legs, drawn before them.
          const step = Math.max(3, Math.round(h * 0.07));
          for (let i = 0; i < deckY; i += step) {
            const j = Math.min(deckY, i + step);
            line(cx - halfAt(i), base - i, cx + halfAt(j), base - j, dark);
            line(cx + halfAt(i), base - i, cx - halfAt(j), base - j, dark);
          }
          const bandH = Math.max(2, Math.round(h * 0.05));
          for (let i = 0; i < topY; i += 1) {
            const w = halfAt(i);
            const y = base - i;
            const c = Math.floor(i / bandH) % 2 === 0 ? paint : pale;
            if (i < deckY) {
              const t = Math.max(1, Math.round(h * 0.02));
              for (let k = 0; k < t; k += 1) {
                put(cx - w + k, y, k ? dark : c);
                put(cx + w - k, y, k ? dark : c);
              }
            } else {
              for (let x = cx - w; x <= cx + w; x += 1) put(x, y, x === cx + w ? dark : c);
            }
          }
          const deck = (i, over, tall) => {
            const w = halfAt(i) + over;
            box(cx - w, base - i - tall, w * 2 + 1, tall, paint);
            for (let x = cx - w + 1; x < cx + w; x += 2) put(x, base - i - Math.max(1, tall >> 1), glass);
            for (let x = cx - w; x <= cx + w; x += 1) {
              put(x, base - i - tall, pale);
              put(x, base - i - 1, dark);
            }
          };
          deck(deckY, Math.max(2, Math.round(h * 0.05)), Math.max(3, Math.round(h * 0.06)));
          deck(topY, Math.max(1, Math.round(h * 0.02)), Math.max(2, Math.round(h * 0.035)));
          line(cx, base - topY - Math.max(2, Math.round(h * 0.035)), cx, base - h, paint);
          beacon(base - h, 2.2);
        } else if (lm.kind === 'skytree') {
          // Skytree: a tripod at the foot gathering into a round shaft, the two
          // observation rings, then the gain tower. Lit pale blue.
          const shaft = Math.round(h * 0.76);
          const deckA = Math.round(h * 0.5);
          const deckB = Math.round(h * 0.68);
          const dA = Math.max(2, Math.round(h * 0.05));
          const dB = Math.max(2, Math.round(h * 0.035));
          const steel = word(lm.body);
          const litSteel = word(mix(lm.body, lm.light, 0.45));
          const glow = word(lm.light);
          const dark = word(mix(lm.body, '#000000', 0.45));
          const foot = Math.max(3, Math.round(h * 0.14));
          for (let i = 0; i < shaft; i += 1) {
            let w = Math.max(1, Math.round(h * (0.05 - 0.036 * (i / shaft) ** 0.7)));
            if (i < foot) w += Math.round(h * 0.035 * (1 - i / foot) ** 1.4); // splayed legs
            if (i >= deckA && i < deckA + dA) w += Math.max(2, Math.round(h * 0.022));
            if (i >= deckB && i < deckB + dB) w += Math.max(1, Math.round(h * 0.014));
            const y = base - i;
            for (let x = cx - w; x <= cx + w; x += 1) put(x, y, x === cx - w ? litSteel : x === cx + w ? dark : steel);
            // Lattice picked out by the floodlights, ring decks brightest.
            if (i === deckA + dA - 1 || i === deckB + dB - 1) for (let x = cx - w; x <= cx + w; x += 1) put(x, y, glow);
            else if (i % 5 === 0) for (let x = cx - w + 1; x < cx + w; x += 2) put(x, y, litSteel);
          }
          line(cx, base - shaft, cx, base - h, litSteel);
          beacon(base - h, 2);
        } else if (lm.kind === 'canopy') {
          // Shenzhen Civic Center: one long wing of a roof over the plaza, with
          // the red hall's wedge and the yellow one's rising through it, each
          // pointed at the axis between them.
          // Narrow frames get a shorter wing rather than one running off both
          // sides: the tips are the whole point of the shape.
          const w = Math.min(Math.round(h * 8), Math.round(width * 0.94));
          const x0 = Math.max(0, Math.min(width - w, cx - Math.floor(w / 2)));
          const roof = word(lm.light);
          const roofLit = word(mix(lm.light, '#d4ecf6', 0.42));
          const roofEdge = word(mix(lm.light, '#0e2436', 0.55));
          const deck = Math.round(h * 0.55);
          const deckTop = base - deck;

          // Wing profile, traced off the photograph: one broad crest over the
          // middle, a shade wider on the falling side, dropping away to tips
          // that hang just clear of the deck and turn up as they run out.
          const bell = (f, at, s) => Math.exp(-(((f - at) / s) ** 2));
          const wave = (f) =>
            bell(f, 0.5, f < 0.5 ? 0.21 : 0.25) + 0.1 * bell(f, 0.12, 0.09) + 0.07 * bell(f, 0.86, 0.09);
          const crest = (f) => h * (0.2 + 0.6 * wave(f));
          const roofTop = (f) => deckTop - Math.round(crest(f));
          // Thin at the very ends, where the wing runs out to nothing.
          const roofThick = (f) =>
            Math.max(2, Math.round(h * (0.3 - 0.06 * bell(f, 0.5, 0.23)) * Math.min(1, (0.5 - Math.abs(f - 0.5)) / 0.09)));

          // Banded podium wings, either side of the plaza the two halls stand
          // in, with the paved axis running down the middle of it.
          const podium = word(mix(lm.body, '#e8f0f6', 0.26));
          const plazaHex = mix('#2b4a26', lm.body, 0.2);
          const plaza = word(plazaHex);
          const plazaLit = word(mix(plazaHex, '#6f9c42', 0.45));
          const gx0 = x0 + Math.round(w * 0.34);
          const gw = Math.round(w * 0.32);
          box(gx0, deckTop, gw, deck, plaza);
          // Park trees fill the plaza between the halls, in the roof's shade.
          for (let x = gx0; x < gx0 + gw; x += 2 + Math.floor(lr() * 2)) {
            const r = 1 + Math.floor(lr() * 2);
            disc(x, deckTop + r, r, lr() < 0.4 ? plazaLit : plaza);
          }
          for (const [a, b] of [[0.06, 0.36], [0.64, 0.94]]) {
            const wx = x0 + Math.round(w * a);
            const ww = Math.round(w * (b - a));
            box(wx, deckTop, ww, deck, podium);
            for (let y = deckTop + 2; y < base - 1; y += 3) {
              for (let x = wx; x < wx + ww; x += 1) put(x, y, edge);
            }
          }
          const axis = x0 + Math.floor(w / 2);
          line(axis, deckTop, axis, base - 1, word(mix(lm.body, '#f0f6fa', 0.55)));

          // The two coloured halls: mirrored wedges, each standing tall on its
          // outer edge and tapering to a point that dips back into the roof.
          const blocks = [
            { tall: 0.355, tip: 0.427, color: lm.colors?.[0] ?? '#c8443c' },
            { tall: 0.645, tip: 0.573, color: lm.colors?.[1] ?? '#e0a23a' },
          ];
          for (const b of blocks) {
            const tallX = x0 + Math.round(w * b.tall);
            const tipX = x0 + Math.round(w * b.tip);
            const steps = Math.max(1, Math.abs(tipX - tallX));
            const dir = tipX > tallX ? 1 : -1;
            const topY = deckTop - Math.round(h * 0.95);
            const tipY = roofTop(b.tip) - Math.round(h * 0.06);
            const bc = word(b.color);
            const bcLit = word(mix(b.color, '#ffffff', 0.22));
            // Below the roof the hall stands in its own shadow.
            const bcShade = word(mix(b.color, '#12283c', 0.5));
            for (let i = 0; i <= steps; i += 1) {
              const x = tallX + dir * i;
              const f = (x - x0) / w;
              const yTop = Math.round(topY + ((tipY - topY) * i) / steps);
              const under = roofTop(f) + roofThick(f);
              for (let y = yTop; y < deckTop; y += 1) {
                put(x, y, y === yTop ? bcLit : y >= under ? bcShade : bc);
              }
            }
          }

          // The roof itself: sunlit top surface over a shaded fascia.
          for (let x = 0; x < w; x += 1) {
            const f = x / w;
            const y = roofTop(f);
            const thick = roofThick(f);
            for (let k = 0; k < thick; k += 1) {
              put(x0 + x, y + k, k === 0 ? roofLit : k >= thick - 2 ? roofEdge : roof);
            }
          }
        } else if (lm.kind === 'statue') {
          // A striding figure on its plinth, seen against the city lights.
          const s2 = Math.max(8, h);
          const plinthH = Math.round(s2 * 0.32);
          const plinthW = Math.round(s2 * 0.46);
          box(cx - Math.floor(plinthW / 2), base - plinthH, plinthW, plinthH, body);
          box(cx - Math.floor(plinthW / 2) - 1, base - plinthH - 1, plinthW + 2, 2, body);
          const feet = base - plinthH - 1;
          const figure = Math.round(s2 * 0.62);
          // Coat: narrow at the shoulders, flaring toward the hem.
          for (let i = 0; i < figure; i += 1) {
            const f = i / figure;
            const w = Math.max(2, Math.round(s2 * (0.2 - f * 0.09)));
            for (let x = cx - Math.floor(w / 2); x <= cx + w / 2; x += 1) put(x, feet - i, body);
          }
          const headR = Math.max(1, Math.round(s2 * 0.075));
          disc(cx, feet - figure - headR, headR, body);
          // One arm held behind, one hanging forward.
          line(cx + Math.round(s2 * 0.07), feet - Math.round(figure * 0.82), cx + Math.round(s2 * 0.2), feet - Math.round(figure * 0.5), body);
          line(cx - Math.round(s2 * 0.07), feet - Math.round(figure * 0.82), cx - Math.round(s2 * 0.17), feet - Math.round(figure * 0.45), body);
        } else if (lm.kind === 'hall') {
          // The gate hall: marble terrace, red hall under painted beams, twin
          // gold roofs with their eaves sweeping up at the corners. It carries
          // the picture, so on a wide frame it grows with the frame rather
          // than staying pinned to the height of the composition.
          const u = Math.max(h, Math.min(Math.round(width * 0.2), h * 2));
          const marbleHex = lm.accent ?? '#e6ded0';
          const marble = word(marbleHex);
          const marbleEdge = word(mix(marbleHex, '#000000', 0.28));
          const stair = word(mix(marbleHex, '#ffffff', 0.35));
          const gold = word(lm.light);
          const goldLit = word(mix(lm.light, '#fff3c0', 0.32));
          const goldRib = word(mix(lm.light, '#8a5620', 0.3));
          const goldDeep = word(mix(lm.light, '#8a5620', 0.55));
          const goldEdge = word(mix(lm.light, '#000000', 0.4));
          let y = base;
          const tiers = lm.accent ? 3 : 0; // a gate hall sits straight on its wall
          for (let tier = 0; tier < tiers; tier += 1) {
            const tw = Math.round(u * (2.5 - tier * 0.18));
            const th = Math.max(3, Math.round(u * 0.07));
            box(cx - Math.floor(tw / 2), y - th, tw, th, marble);
            for (let x = cx - Math.floor(tw / 2); x < cx + tw / 2; x += 1) put(x, y - th, stair);
            for (let x = cx - Math.floor(tw / 2); x < cx + tw / 2; x += 6) {
              line(x, y - th + 1, x, y - 1, marbleEdge); // balustrade posts
            }
            const sw = Math.round(u * 0.5);
            box(cx - Math.floor(sw / 2), y - th, sw, th, stair);
            for (let sy = y - th; sy < y; sy += 2) {
              for (let x = cx - Math.floor(sw / 2); x < cx + sw / 2; x += 1) put(x, sy, marbleEdge);
            }
            y -= th;
          }
          // Marble balustrade the hall stands on.
          const railH = Math.max(2, Math.round(u * 0.055));
          const railW = Math.round(u * 2.3);
          box(cx - Math.floor(railW / 2), y - railH, railW, railH, marble);
          for (let x = cx - Math.floor(railW / 2); x < cx + railW / 2; x += 1) put(x, y - railH, stair);
          for (let x = cx - Math.floor(railW / 2); x < cx + railW / 2; x += 3) line(x, y - railH + 1, x, y - 1, marbleEdge);
          y -= railH;

          const wallW = Math.round(u * 1.9);
          const wallH = Math.max(4, Math.round(u * 0.34));
          const bay = Math.max(4, Math.round(u * 0.19));
          box(cx - Math.floor(wallW / 2), y - wallH, wallW, wallH, body);
          // Lattice doors hung between the red columns.
          const doorHex = mix(lm.body, '#4a1608', 0.35);
          const door = word(doorHex);
          const slat = word(mix(doorHex, lm.light, 0.45));
          for (let x = cx - Math.floor(wallW / 2); x < cx + wallW / 2; x += bay) {
            const dh = Math.round(wallH * 0.82);
            box(x + 2, y - dh, bay - 3, dh, door);
            for (let dx = x + 3; dx < x + bay - 2; dx += 2) line(dx, y - dh + 1, dx, y - 2, slat);
            for (let yy = y - dh + 1; yy < y - 1; yy += Math.max(3, Math.round(dh * 0.4))) {
              for (let dx = x + 2; dx < x + bay - 1; dx += 1) put(dx, yy, door);
            }
            line(x, y - wallH, x, y - 1, lit); // the column itself
            line(x + 1, y - wallH, x + 1, y - 1, edge);
          }
          y -= wallH;

          /** Painted beam band: the teal course that carries each eave. */
          const teal = word(mix('#4d8b86', lm.body, 0.06));
          const tealDark = word(mix('#153337', lm.body, 0.08));
          const beams = (halfW, bh) => {
            box(cx - halfW, y - bh, halfW * 2 + 1, bh, tealDark);
            for (let x = cx - halfW + 2; x < cx + halfW - 2; x += bay) {
              box(x, y - bh + 1, Math.max(2, bay - 3), Math.max(1, bh - 2), teal);
            }
            for (let x = cx - halfW; x <= cx + halfW; x += 1) {
              put(x, y - bh, goldEdge);
              put(x, y - 1, goldEdge);
            }
            y -= bh;
          };

          /** A tiled roof: hips falling from the ridge to eave corners that fly
           *  up, shaded dark at the eave and bright along the ridge. */
          const roof = (halfW, rh) => {
            const eave = y;
            for (let dx = -halfW; dx <= halfW; dx += 1) {
              const t = Math.abs(dx) / halfW;
              // A long ridge, hips falling away from its ends, and the eave
              // flicking up into a point at the very corner.
              const tip = rh * 0.32;
              const hip = t <= 0.6 ? rh : rh - ((t - 0.6) / 0.4) * (rh - tip);
              const lift = t <= 0.85 ? 0 : ((t - 0.85) / 0.15) ** 2 * tip;
              const yTop = eave - Math.round(hip);
              const yBot = eave - Math.round(lift);
              const span = Math.max(1, yBot - yTop);
              for (let yy = yTop; yy <= yBot; yy += 1) {
                const g = (yBot - yy) / span; // 0 at the eave, 1 at the ridge
                const band = g < 0.16 ? goldDeep : g > 0.84 ? goldLit : gold;
                put(cx + dx, yy, yy === yBot ? goldEdge : dx % 4 === 0 && g < 0.78 ? goldRib : band);
              }
            }
            y -= rh;
          };

          beams(Math.round(u * 1.0), Math.max(3, Math.round(u * 0.09)));
          roof(Math.round(u * 1.2), Math.max(4, Math.round(u * 0.23)));

          // Between the eaves: one more painted band, carrying the name plaque.
          beams(Math.round(u * 0.88), Math.max(3, Math.round(u * 0.11)));
          const pw = Math.max(5, Math.round(u * 0.19));
          const ph = Math.max(3, Math.round(u * 0.09));
          box(cx - Math.floor(pw / 2), y + 1, pw, ph, word(mix('#243a6a', lm.body, 0.12)));
          for (let x = cx - Math.floor(pw / 2); x < cx + pw / 2; x += 1) {
            put(x, y + 1, gold);
            put(x, y + ph, gold);
          }
          roof(Math.round(u * 1.0), Math.max(5, Math.round(u * 0.36)));

          // Ridge along the top, with a beast reared up at either end.
          const rw = Math.round(u * 0.8);
          for (let x = cx - Math.floor(rw / 2); x <= cx + rw / 2; x += 1) put(x, y - 1, goldLit);
          const beast = Math.max(2, Math.round(u * 0.035));
          for (let k = 0; k <= beast; k += 1) {
            const rise = beast - k;
            for (let t = 0; t <= rise; t += 1) {
              put(cx - Math.floor(rw / 2) - k, y - 1 - t, t === rise ? goldLit : gold);
              put(cx + Math.ceil(rw / 2) + k, y - 1 - t, t === rise ? goldLit : gold);
            }
          }
        } else if (lm.kind === 'wall') {
          // Gate wall: red mass, stone plinth, three arched passages, plaque.
          const w = Math.round((lm.w ?? 1) * width);
          const x0 = cx - Math.floor(w / 2);
          const wallH = Math.round(h);
          const plinth = Math.max(3, Math.round(wallH * 0.16));
          const stoneHex = mix(lm.body, '#d8d0c0', 0.7);
          const stoneWord = word(stoneHex);
          box(x0, base - wallH, w, wallH, body);
          for (let x = x0; x < x0 + w; x += 1) put(x, base - wallH, lit);
          box(x0, base - plinth, w, plinth, stoneWord);
          for (let x = x0; x < x0 + w; x += 5) line(x, base - plinth, x, base - 1, word(mix(stoneHex, '#000000', 0.2)));

          const gold = word(lm.light);
          const goldDark = word(mix(lm.light, '#000000', 0.35));
          for (let x = x0 - 3; x < x0 + w + 3; x += 1) {
            put(x, base - wallH - 3, goldDark);
            put(x, base - wallH - 2, gold);
            put(x, base - wallH - 1, gold);
            put(x, base - wallH, goldDark);
            if (x % 4 === 0) put(x, base - wallH - 2, goldDark);
          }

          const shadow = word(mix(lm.body, '#1a0c08', 0.75));
          const gates = [-1, 0, 1];
          for (const g of gates) {
            const gw = Math.max(5, Math.round(wallH * (g === 0 ? 0.44 : 0.32)));
            const gx = cx + Math.round(g * wallH * 0.85);
            const gh = Math.round(wallH * (g === 0 ? 0.74 : 0.6));
            for (let yy = plinth; yy < gh; yy += 1) {
              const straight = gh - gw / 2;
              const arch = yy > straight ? Math.round(Math.sqrt(Math.max(0, (gw / 2) ** 2 - (yy - straight) ** 2))) : gw / 2;
              for (let x = gx - arch; x <= gx + arch; x += 1) put(x, base - yy - 1, shadow);
            }
            // Studded doors inside the passage.
            for (let yy = plinth + 3; yy < gh - gw * 0.6; yy += 4) {
              for (let x = gx - Math.round(gw * 0.32); x <= gx + gw * 0.32; x += 3) put(x, base - yy - 1, gold);
            }
          }

          // Name plaque above the central gate.
          const pw = Math.max(8, Math.round(wallH * 0.5));
          const ph = Math.max(4, Math.round(wallH * 0.16));
          const py = base - Math.round(wallH * 0.78);
          box(cx - Math.floor(pw / 2), py, pw, ph, word(mix(lm.light, '#243a6a', 0.7)));
          for (let x = cx - Math.floor(pw / 2); x < cx + pw / 2; x += 1) {
            put(x, py, gold);
            put(x, py + ph - 1, gold);
          }
          for (let x = cx - Math.round(pw * 0.3); x < cx + pw * 0.3; x += 3) {
            line(x, py + 1, x, py + ph - 2, gold);
          }

          // Cypresses standing along the wall, well clear of the gates.
          const pineHex = mix('#33472a', lm.body, 0.12);
          const pine = word(pineHex);
          const pineLit = word(mix(pineHex, '#8fa85a', 0.3));
          const cypress = (tx, th) => {
            const tw = Math.max(2, Math.round(th * 0.5));
            for (let i = 0; i < th; i += 1) {
              const half = Math.max(0, Math.round((tw / 2) * Math.sin((i / th) * Math.PI * 0.9) ** 0.7));
              for (let x = tx - half; x <= tx + half; x += 1) {
                put(x, base - plinth - i, x === tx - half ? pineLit : pine);
              }
            }
          };
          // A clump at either end of the wall, the way they stand in the photo.
          for (const side of [-1, 1]) {
            const near = cx + side * Math.round(wallH * 2.4);
            const far = side < 0 ? x0 + wallH * 0.3 : x0 + w - wallH * 0.3;
            for (let i = 0; i < 5; i += 1) {
              const tx = Math.round(near + (far - near) * (i / 5 + lr() * 0.14));
              cypress(tx, Math.round(wallH * (0.4 + lr() * 0.45)));
            }
          }
        } else if (lm.kind === 'promenade') {
          // Foreground embankment: railing, lamps, a few onlookers.
          const y0 = base - h;
          spec._waterBottom = y0; // shimmer stops at the shoreline
          box(0, y0, width, rows - y0, body);
          const rail = word(mix(lm.body, '#ffffff', 0.22));
          // Paved embankment: banded stone so it reads as ground, not a void.
          const paveA = word(mix(lm.body, '#ffffff', 0.09));
          const paveB = word(mix(lm.body, '#ffffff', 0.045));
          for (let y = y0 + 1; y < base; y += 1) {
            const stripe = Math.floor((y - y0) / 3) % 2 === 0;
            for (let x = 0; x < width; x += 1) {
              const seam = (x + Math.floor((y - y0) / 3) * 4) % 9 === 0;
              put(x, y, seam ? paveB : stripe ? paveA : paveB);
            }
          }
          for (let x = 0; x < width; x += 1) put(x, y0, rail);
          for (let x = 0; x < width; x += 6) line(x, y0, x, y0 + Math.round(h * 0.3), rail);
          for (let x = Math.round(width * 0.08); x < width; x += Math.round(width * 0.22)) {
            const lampH = Math.round(h * 0.55);
            line(x, y0, x, y0 - lampH, rail);
            disc(x, y0 - lampH - 1, 2, word(lm.light));
            beacons.push({ x, y: y0 - lampH - 1, color: lm.light, period: 0, phase: 0 });
          }
          const people = 5 + Math.floor(lr() * 4);
          for (let i = 0; i < people; i += 1) {
            const px = Math.round(lr() * width);
            const ph = Math.round(h * (0.26 + lr() * 0.12));
            box(px - 1, y0 - ph, 3, ph, word(mix(lm.body, '#000000', 0.5)));
            disc(px, y0 - ph - 1, 1, word(mix(lm.body, '#000000', 0.5)));
          }
        } else if (lm.kind === 'junk') {
          const s = Math.max(6, h);
          for (let i = 0; i < Math.round(s * 0.9); i += 1) {
            const w = Math.round(s * 1.1 * (1 - i / (s * 1.4)));
            for (let x = cx - Math.floor(w / 2); x <= cx + w / 2; x += 1) {
              put(x, base - Math.round(s * 0.25) - i, (x - cx) % 4 === 0 ? word(mix(lm.light, '#000000', 0.3)) : light);
            }
          }
          box(cx - Math.round(s * 0.7), base - Math.round(s * 0.25), Math.round(s * 1.4), Math.round(s * 0.22), body);
          line(cx, base - Math.round(s * 0.25), cx, base - Math.round(s * 1.15), body);
        } else if (lm.kind === 'billboard') {
          // Riverfront tower wearing a huge lit screen.
          const w = Math.max(6, Math.round(h * 0.42));
          box(cx - Math.floor(w / 2), base - h, w, h, body);
          for (let y = base - h; y < base; y += 1) {
            put(cx - Math.floor(w / 2), y, lit);
            put(cx + Math.ceil(w / 2) - 1, y, edge);
          }
          const sw = Math.max(4, Math.round(w * 0.7));
          const sh = Math.round(h * 0.55);
          const sx = cx - Math.floor(sw / 2);
          const sy = base - h + Math.round(h * 0.12);
          const screen = word(lm.light);
          const screenLit = word(mix(lm.light, '#ffffff', 0.35));
          box(sx, sy, sw, sh, screen);
          for (let y = sy; y < sy + sh; y += 3) {
            for (let x = sx; x < sx + sw; x += 1) put(x, y, screenLit);
          }
          for (let y = base - h + Math.round(h * 0.72); y < base - 2; y += 3) {
            for (let x = sx; x < sx + sw; x += 2) if (lr() < 0.5) put(x, y, word('#ffe0a0'));
          }
        } else if (lm.kind === 'ferry') {
          const s = Math.max(5, h);
          const hull = Math.max(2, Math.round(s * 0.5));
          box(cx - Math.round(s * 1.6), base - hull, Math.round(s * 3.2), hull, body);
          box(cx - Math.round(s * 1.1), base - hull - Math.round(s * 0.5), Math.round(s * 2.2), Math.round(s * 0.5), body);
          line(cx + Math.round(s * 0.2), base - hull - Math.round(s * 0.5), cx + Math.round(s * 0.2), base - hull - Math.round(s * 0.9), body);
          for (let x = cx - Math.round(s * 1.4); x < cx + s * 1.4; x += 3) put(x, base - Math.round(hull * 0.6), light);
        }
      }

      if (spec.landmarks) {
        for (const lm of spec.landmarks) if (!lm.onWater && !lm.behind) drawLandmark(lm);
      }

      // Water: bands, then a wobbled mirror of everything standing above it.
      if (spec.water) {
        const cols = spec.water.colors.map(word);
        for (let y = waterTop; y < rows; y += 1) {
          const band = Math.min(cols.length - 1, Math.floor(((y - waterTop) / (rows - waterTop)) * cols.length));
          for (let x = 0; x < width; x += 1) put(x, y, cols[band]);
        }
        const depth = rows - waterTop;
        for (let y = waterTop; y < rows; y += 1) {
          const d = (y - waterTop) / depth;
          // Reflection fades and smears with distance from the shore.
          const strength = spec.water.reflect * Math.pow(1 - d, 1.5);
          if (strength <= 0.03) continue;
          const srcY = waterTop - Math.round((y - waterTop) * 0.9);
          for (let x = 0; x < width; x += 1) {
            const wobble = Math.round(Math.sin(y * 0.5 + x * 0.06) * (1 + d * 3));
            const src = at(x + wobble, srcY);
            const th = (BAYER[y & 3][x & 3] + 0.5) / 16;
            if (strength > th * 0.9) put(x, y, blend(at(x, y), src, 0.55));
          }
        }
      }

      if (spec.landmarks) {
        for (const lm of spec.landmarks) if (lm.onWater) drawLandmark(lm);
      }

      if (!spec.landmarks || !spec.landmarks.some((l) => l.kind === 'promenade')) spec._waterBottom = rows;
      spec._blinkers = blinkers;
      spec._beacons = beacons.filter((b) => b.period > 0);
      spec._front = front;
      return buf;
    };

    const startScene = (canvas) => {
      const id = canvas.dataset.sceneCanvas;
      const spec = JSON.parse(JSON.stringify(specs[id]));
      const ctx = canvas.getContext('2d', { alpha: false });
      if (!ctx) return () => {};
      ctx.imageSmoothingEnabled = false;

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let width = 0;
      let rows = ROWS;
      let image = null;
      let particles = [];
      let clouds = [];
      let front = null;
      let visible = true;
      let raf = 0;
      let lastDraw = 0;

      /** Packed pixels onto an offscreen canvas, keeping transparency. */
      const sprite = (px, w, h) => {
        const cv = document.createElement('canvas');
        cv.width = w;
        cv.height = h;
        const sctx = cv.getContext('2d');
        sctx.putImageData(new ImageData(new Uint8ClampedArray(px.buffer), w, h), 0, 0);
        return cv;
      };

      const build = () => {
        const rect = canvas.getBoundingClientRect();
        const aspect = rect.height > 0 ? rect.width / rect.height : 1.6;
        // Keep the shorter side near ROWS so pixels stay chunky in both
        // landscape and portrait, and nothing gets cropped by object-fit.
        if (aspect >= 1) {
          rows = ROWS;
          width = Math.min(880, Math.round(ROWS * aspect));
        } else {
          width = Math.round(ROWS * 0.8);
          rows = Math.min(820, Math.round(width / aspect));
        }
        canvas.width = width;
        canvas.height = rows;
        ctx.imageSmoothingEnabled = false;
        const buf = buildStatic(spec, width, rows);
        image = new ImageData(new Uint8ClampedArray(buf.buffer), width, rows);
        clouds = spec._clouds.map((c) => ({ ...c, cv: sprite(c.px, c.w, c.h) }));
        front = spec._front ? sprite(spec._front, width, rows) : null;

        particles = [];
        if (spec.weather) {
          const pr = rng(spec.seed * 3 + 1);
          const petals = spec.weather === 'petals';
          for (let i = 0; i < (petals ? 34 : 26); i += 1) {
            particles.push({
              x: pr() * width,
              // Fireflies keep to the grass; petals are already falling.
              y: petals ? pr() * rows : rows * (0.72 + pr() * 0.26),
              phase: pr() * Math.PI * 2,
              fall: 0.4 + pr() * 0.7,
              tone: pr(),
            });
          }
        }
      };

      /** Sky, then the clouds at their drifted position, then the skyline. */
      const paint = (clock) => {
        ctx.putImageData(image, 0, 0);
        if (!clouds.length) return;
        for (const c of clouds) {
          // Wrap a sprite's width past each edge, so one leaves as it enters.
          const span = width + c.w;
          const x = c.x + (reduced ? 0 : clock * c.speed) + c.w;
          ctx.drawImage(c.cv, Math.round((((x % span) + span) % span) - c.w), c.y);
        }
        if (front) ctx.drawImage(front, 0, 0);
      };

      const frame = (time) => {
        raf = requestAnimationFrame(frame);
        if (!visible || !image) return;
        if (time - lastDraw < 140) return; // ~7fps keeps a slow pixel cadence
        lastDraw = time;
        const t = (time / 1000) * 0.35; // everything drifts at roughly a third speed
        const clock = time / 1000;
        paint(clock);

        if (!reduced) {
          // Windows switching on and off, one slow room at a time.
          for (const b of spec._blinkers) {
            const litNow = ((clock + b.phase) % b.period) / b.period < 0.55;
            ctx.fillStyle = litNow ? b.on : b.off;
            ctx.fillRect(b.x, b.y, 1, 1);
          }
          // Aviation lights on the masts.
          for (const b of spec._beacons) {
            const phase = ((clock + b.phase) % b.period) / b.period;
            if (phase < 0.18) {
              ctx.fillStyle = b.color;
              ctx.fillRect(b.x, b.y, 1, 1);
              if (phase < 0.09) {
                ctx.fillRect(b.x - 1, b.y, 1, 1);
                ctx.fillRect(b.x + 1, b.y, 1, 1);
                ctx.fillRect(b.x, b.y - 1, 1, 1);
              }
            }
          }
        }

        if (spec._stars && !reduced) {
          for (let i = 0; i < spec._stars.length; i += 1) {
            const s = spec._stars[i];
            ctx.fillStyle = Math.sin(t * 2.2 + i * 1.7) > 0.4 ? '#ffffff' : s.c;
            ctx.fillRect(s.x, s.y, 1, 1);
          }
        }

        if (spec.water) {
          const top = spec._waterTop ?? Math.round(spec.water.y * rows);
          ctx.fillStyle = spec.water.shimmer;
          // Sparse horizontal streaks that drift sideways, rather than static noise.
          const bottom = spec._waterBottom ?? rows;
          for (let y = top + 3; y < bottom; y += 6) {
            const row = (y - top) / 6;
            const drift = Math.sin(t * 0.6 + row) * width * 0.5;
            const spacing = 30 + (row % 3) * 12;
            for (let x = ((drift % spacing) + spacing) % spacing; x < width; x += spacing) {
              ctx.fillRect(Math.round(x), y, 2 + (row % 2), 1);
            }
          }
        }

        if (spec.weather === 'petals') {
          // Blossom coming off the bank: each petal sinks at its own pace and
          // tips from side to side as it turns over, then starts again above
          // the frame a little further along.
          for (const p of particles) {
            if (!reduced) {
              p.y += p.fall * 0.55;
              p.x += Math.sin(t * 1.7 + p.phase) * 0.9 + 0.3;
              if (p.y > rows) {
                p.y = -2;
                p.x += width * 0.37;
              }
              if (p.x > width) p.x -= width;
            }
            ctx.fillStyle = p.tone < 0.3 ? '#fff2f6' : p.tone < 0.72 ? '#ffcadd' : '#f6a8c4';
            // Edge-on for most of the turn, broadside at the ends of it.
            ctx.fillRect(Math.round(p.x), Math.round(p.y), Math.cos(t * 1.7 + p.phase) > 0.55 ? 2 : 1, 1);
          }
        } else {
          // Fireflies over the park, drifting and pulsing.
          for (const p of particles) {
            if (!reduced) {
              p.x += Math.sin(t + p.phase) * 0.22;
              p.y += Math.cos(t * 0.8 + p.phase) * 0.16;
            }
            ctx.fillStyle = Math.sin(t * 3 + p.phase) > 0 ? '#e8ff9a' : '#9ec55a';
            ctx.fillRect(Math.round(p.x), Math.round(p.y), 1, 1);
          }
        }
      };

      build();
      paint(performance.now() / 1000);
      raf = requestAnimationFrame(frame);

      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) visible = entry.isIntersecting;
      }, { threshold: 0.05 });
      io.observe(canvas);

      let resizeTimer = 0;
      const onResize = () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          build();
          paint(performance.now() / 1000);
        }, 150);
      };
      window.addEventListener('resize', onResize);

      return () => {
        cancelAnimationFrame(raf);
        io.disconnect();
        window.removeEventListener('resize', onResize);
      };
    };

    let teardown = [];

    const init = () => {
      teardown.forEach((fn) => fn());
      teardown = [];
      const reel = document.querySelector('[data-scene-reel]');
      if (!reel) return;

      const sizeReel = () => {
        const top = reel.getBoundingClientRect().top + window.scrollY;
        reel.style.height = `${Math.max(320, window.innerHeight - top)}px`;
      };
      sizeReel();
      window.addEventListener('resize', sizeReel);
      teardown.push(() => window.removeEventListener('resize', sizeReel));

      document.querySelectorAll('[data-scene-canvas]').forEach((canvas) => {
        teardown.push(startScene(canvas));
      });
    };

    document.addEventListener('astro:page-load', init);
    if (document.readyState !== 'loading') init();
    else document.addEventListener('DOMContentLoaded', init);
  })();
</script>
