          column(cx - mast, base - Math.round(h * 0.3), cx - Math.round(h * 0.07), base, 2);
          const glowHex = lm.accent ?? mix(lm.body, lm.light, 0.5);
          // The tower's floodlights run a gradient rather than one colour:
