            }
            y -= sh;
          }
          line(cx - 2, y, cx - 2, y - Math.round(h * 0.17), body);
          line(cx + 2, y, cx + 2, y - Math.round(h * 0.17), body);
          beacon(y - Math.round(h * 0.17), 2.6);
        } else if (lm.kind === 'crown') {
