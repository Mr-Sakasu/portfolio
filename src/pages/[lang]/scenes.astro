          // both cut back and pinned to the left margin, clear of the peak:
          // the mountain is what the scene is of, the tree only frames it.
          const narrow = width < rows * 0.9;
          const th = Math.min(h, Math.round(width * (narrow ? 0.58 : 0.85)));
