          const trunkW = Math.max(3, Math.round(th * 0.085));
          const tips = [];
          // A tree does not fill out by forking evenly at the ends. Each limb
          // runs on as a leader and sheds shoots off its flanks along the way,
          // which is what puts growth into the middle of the crown instead of
          // only at its rim, and what keeps the outline uneven. Splitting in
          // threes at every tip filled the gap but read as a diagram.
          const limb = (x0, y0, ang, len, w, depth, bare) => {
            // Limbs bend a little under their own weight as they go. The tip
            // has to be read back off that same bend: computing it from the
            // unbent angle leaves each child starting somewhere the parent
            // never reached, which saws the tree into loose pieces.
            const bend = 0.18 * Math.sign(Math.cos(ang) || 1);
            const ax = (f) => x0 + Math.cos(ang - f * bend) * (f * len);
            const ay = (f) => y0 - Math.sin(ang - f * bend) * (f * len);
            // Half-pixel steps, so a limb leaning near the diagonal stays a
            // solid line instead of a dotted one.
            const steps = Math.max(2, Math.round(len * 2));
            for (let i = 0; i <= steps; i += 1) {
              const f = i / steps;
              const bw = Math.max(1, Math.round(w * (1 - f * 0.5)));
              const x = ax(f);
              const y = ay(f);
              for (let k = 0; k < bw; k += 1) {
                put(x - Math.floor(bw / 2) + k, y, k === 0 ? lit : k === bw - 1 ? edge : body);
              }
            }
            const x1 = ax(1);
            const y1 = ay(1);
            const tipAng = ang - bend;
            // Blossom sits on the outer wood, so once a limb is fine enough
            // to carry it, seed the canopy the whole way along it. Seeding
            // only the very ends left the flower in scattered dots with bare
            // sky between them.
            if (!bare && depth <= 2) {
              for (let f = 0.25; f <= 1.001; f += 0.25) {
