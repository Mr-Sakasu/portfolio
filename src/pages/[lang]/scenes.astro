---
import Layout from '../../layouts/Layout.astro';
import { ui, languages } from '../../i18n/ui';
import { sceneGroups, sceneArt, sceneRidges } from '../../data/scenes';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const activeLang = lang as keyof typeof ui;
const t = ui[activeLang] ?? ui.en;
const groups = sceneGroups[activeLang] ?? sceneGroups.en;
---

<Layout title={`${t['scenes.page.title']} | Sakasu Portfolio`} lang={lang} description={t['scenes.page.subtitle']}>
  <section class="py-10 md:py-14">
    <p class="text-sm font-bold text-amber-300 uppercase tracking-widest">
      {t['scenes.eyebrow']}
    </p>
    <h1 class="mt-3 text-4xl md:text-5xl font-extrabold leading-tight text-white">
      {t['scenes.page.title']}
    </h1>
    <p class="mt-4 max-w-2xl text-base md:text-lg leading-relaxed text-gray-300">
      {t['scenes.page.subtitle']}
    </p>
  </section>

  <div class="space-y-10 pb-6">
    {groups.map((group) => (
      <section aria-labelledby={`scene-group-${group.id}`}>
        <div class="flex items-baseline gap-3">
          <h2 id={`scene-group-${group.id}`} class="text-xl md:text-2xl font-bold text-white">
            {group.title}
          </h2>
          <span class="text-xs text-gray-500">
            {t['scenes.count'].replace('{count}', String(group.scenes.length))}
          </span>
        </div>

        <ul class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
          {group.scenes.map((scene) => {
            const art = sceneArt[scene.id];
            return (
              <li
                class="scene-card"
                style={`--scene-sky:${art.sky};--scene-land:${art.land};--scene-glow:${art.glow};--scene-ridge:${sceneRidges[art.ridge]};`}
              >
                <div class="scene-card__art" aria-hidden="true">
                  <span class="scene-card__sun"></span>
                  <span class="scene-card__ridge"></span>
                  <span class="scene-card__glyph">{art.glyph}</span>
                </div>
                <div class="p-3.5">
                  <div class="flex items-start justify-between gap-2">
                    <h3 class="text-base font-semibold text-white leading-snug">{scene.name}</h3>
                    <span class="scene-card__when">{scene.when}</span>
                  </div>
                  <p class="scene-card__place mt-0.5 text-xs text-amber-200/80">{scene.place}</p>
                  <p class="mt-2 text-sm leading-relaxed text-gray-400">{scene.note}</p>
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
</Layout>

<style>
  .scene-card {
    overflow: hidden;
    border-radius: 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .scene-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--scene-glow) 45%, transparent);
  }

  .scene-card__art {
    position: relative;
    height: 5.5rem;
    background: var(--scene-sky);
    overflow: hidden;
  }

  .scene-card__sun {
    position: absolute;
    top: 22%;
    left: 22%;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 9999px;
    background: var(--scene-glow);
    filter: blur(1px);
    opacity: 0.85;
    box-shadow: 0 0 2.2rem 0.6rem color-mix(in srgb, var(--scene-glow) 55%, transparent);
  }

  .scene-card__ridge {
    position: absolute;
    inset: auto 0 0 0;
    height: 3.6rem;
    background: var(--scene-land);
    clip-path: var(--scene-ridge);
  }

  .scene-card__glyph {
    position: absolute;
    right: 0.6rem;
    bottom: 0.4rem;
    font-size: 1.15rem;
    line-height: 1;
    opacity: 0.9;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.55));
  }

  .scene-card__when {
    flex-shrink: 0;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--scene-glow) 35%, transparent);
    padding: 0.1rem 0.5rem;
    font-size: 0.65rem;
    white-space: nowrap;
    color: color-mix(in srgb, var(--scene-glow) 75%, white);
  }

  :global(html[data-theme='light']) .scene-card {
    border-color: rgba(15, 23, 42, 0.12);
    background: rgba(255, 255, 255, 0.7);
  }

  :global(html[data-theme='light']) .scene-card h3 {
    color: #0f172a;
  }

  :global(html[data-theme='light']) .scene-card p:last-child {
    color: #475569;
  }

  :global(html[data-theme='light']) .scene-card__place {
    color: #a16207;
  }

  :global(html[data-theme='light']) .scene-card__when {
    color: #334155;
    border-color: rgba(15, 23, 42, 0.2);
  }

  @media (prefers-reduced-motion: reduce) {
    .scene-card,
    .scene-card:hover {
      transition: none;
      transform: none;
    }
  }
</style>
