                if (d <= r || d > halo) continue;
                const f = (1 - (d - r) / (halo - r)) ** 2 * 0.5;
                const th = (BAYER[(cy + y) & 3][(cx + x) & 3] + 0.5) / 16;
                if (f > th * 0.55) put(cx + x, cy + y, blend(at(cx + x, cy + y), face, f));
              }
            }
            for (let y = -r; y <= r; y += 1) {
              for (let x = -r; x <= r; x += 1) {
