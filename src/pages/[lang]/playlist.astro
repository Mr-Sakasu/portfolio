---
import Layout from '../../layouts/Layout.astro';
import Playlist from '../../features/playlist/Playlist.astro';
import { getLocale, getUi, localeStaticPaths } from '../../i18n';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = getLocale(Astro.params.lang);
const activeLang = lang;
const t = getUi(lang);
---

<Layout title={`${t['playlist.page.title']} | Sakasu Portfolio`} lang={lang} description={t['playlist.page.subtitle']}>
  <section class="py-10 md:py-14">
    <h1 class="page-title">
      {t['playlist.page.title']}
    </h1>
  </section>

  <Playlist lang={activeLang} variant="page" showHeading={false} />
</Layout>
