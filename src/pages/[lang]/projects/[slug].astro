---
import ProjectPage from '../../../features/projects/ProjectPage.astro';
import { getLocale, languages } from '../../../i18n';
import { getProjectBySlug, projectSlugs } from '../../../data/projects';

export function getStaticPaths() {
  return Object.keys(languages).flatMap((lang) => (
    projectSlugs.map((slug) => ({ params: { lang, slug } }))
  ));
}

const lang = getLocale(Astro.params.lang);
const project = getProjectBySlug(lang, Astro.params.slug ?? '');

if (!project) {
  throw new Error(`Unknown project: ${Astro.params.slug}`);
}
---

<ProjectPage lang={lang} project={project} />
