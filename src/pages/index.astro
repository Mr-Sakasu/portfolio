---
import Background from '../components/chrome/Background.astro';
import '../styles/tokens.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Sakasu Portfolio — research, projects, and small discoveries." />
    <meta name="theme-color" content="#181410" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Sakasu's note — Autumn</title>
    <script is:inline>
      try {
        document.documentElement.dataset.theme = localStorage.getItem('portfolio-theme') === 'light' ? 'light' : 'dark';
      } catch { /* Use the default dark palette. */ }
    </script>
  </head>
  <body>
    <Background />
    <main class="entry">
      <p class="entry-season">秋 / AUTUMN</p>
      <h1>Sakasu's note<span>.</span></h1>
      <nav aria-label="Choose your language">
        <a href="/ja/" lang="ja">日本語</a>
        <a href="/en/" lang="en">English</a>
        <a href="/zh/" lang="zh">中文</a>
      </nav>
    </main>
    <script>
      const preferred = navigator.languages?.length ? navigator.languages : [navigator.language];
      const language = preferred.map((tag) => tag.toLowerCase().split('-')[0])
        .map((tag) => tag === 'jp' ? 'ja' : tag).find((tag) => ['ja', 'zh', 'en'].includes(tag)) || 'en';
      let played = false;
      try {
        played = sessionStorage.getItem('portfolio-autumn-intro-played') === '1';
        sessionStorage.setItem('portfolio-autumn-intro-played', '1');
      } catch { /* Language links also work without browser storage. */ }
      const stillMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      setTimeout(() => location.replace(`/${language}/`), played || stillMotion ? 0 : 1100);
    </script>
  </body>
</html>

<style>
  :global(html), body { margin: 0; min-height: 100%; background: var(--site-bg); color: var(--site-text); }
  .entry { position: relative; z-index: 1; min-height: 100svh; display: flex; flex-direction: column; align-items: center; justify-content: center; font-family: ui-sans-serif, system-ui, sans-serif; }
  .entry-season { color: var(--site-accent); font-size: 0.7rem; letter-spacing: 0.26em; }
  h1 { margin: 0.6rem 0 2rem; font-size: clamp(2rem, 7vw, 3rem); letter-spacing: -0.05em; }
  h1 span { color: var(--site-accent); }
  nav { display: flex; gap: 1.5rem; }
  a { color: var(--site-muted); font-size: 0.8rem; text-decoration: none; }
  a:hover { color: var(--site-accent); }
  a:focus-visible { outline: 2px solid var(--site-accent); outline-offset: 5px; }
</style>
